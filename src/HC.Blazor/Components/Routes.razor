@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Localization
@using global::Localization.Resources.AbpUi
@using HC.Localization
@using Volo.Abp.AspNetCore.Components.Web.LeptonXTheme
@using Volo.Abp.AspNetCore.Components.Web.LeptonXTheme.Components
@using Volo.Abp.AspNetCore.Components.Web.LeptonXTheme.Components.ApplicationLayout
@using Volo.Abp.AspNetCore.Components.Web.Theming.Routing
@using Microsoft.AspNetCore.Components
@inject IOptions<AbpRouterOptions> RouterOptions
@inject IOptions<LeptonXThemeBlazorOptions> LayoutOptions
@inject IStringLocalizer<AbpUiResource> UiLocalizer
@inject IStringLocalizer<HCResource> L  

<CascadingAuthenticationState>
    <ErrorBoundary @ref="_errorBoundary">
        <ChildContent>
            <Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="RouterOptions.Value.AdditionalAssemblies">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@LayoutOptions.Value.Layout">
                        <Authorizing>
                            @UiLocalizer["Authorizing"]
                        </Authorizing>
                        <NotAuthorized>
                            @if (context.User?.Identity?.IsAuthenticated != true)
                            {
                                <RedirectToLogin/>
                            }
                            else
                            {
                                <ErrorView
                                    Title="@UiLocalizer["403Message"]"
                                    HttpStatusCode="403"
                                    Message="@UiLocalizer["403MessageDetail"]"/>
                            }
                        </NotAuthorized>
                    </AuthorizeRouteView>
                </Found>
                <NotFound>
                    <LayoutView Layout="@LayoutOptions.Value.Layout">
                        <ErrorView
                            Title="@UiLocalizer["404Message"]"
                            HttpStatusCode="404"
                            Message="@UiLocalizer["404MessageDetail"]"/>
                    </LayoutView>
                </NotFound>
            </Router>
        </ChildContent>
        <ErrorContent Context="exception">
            @HandleGlobalException(exception)
        </ErrorContent>
    </ErrorBoundary>
</CascadingAuthenticationState>

@code {
    private ErrorBoundary _errorBoundary = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private HC.Blazor.Services.GlobalExceptionHandler GlobalExceptionHandler { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LayoutOptions.SetAsync();
    }

    private RenderFragment HandleGlobalException(Exception exception)
    {
        // Redirect to login when session expired (Unauthorized)
        if (IsUnauthorizedException(exception))
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await GlobalExceptionHandler.HandleAuthErrorExceptionAsync(exception);
                }
                catch
                {
                    // Fallback: redirect to login
                    GlobalExceptionHandler.RedirectToLogin();
                }
            });
            return @<div class="alert alert-info m-3">
                <h4>@L["SessionExpired"]</h4>
                <p>@L["RedirectingToLogin"]</p>
            </div>;
        }

        return @<div class="alert alert-danger m-3">
            <h4>@UiLocalizer["Error"]</h4>
            <p>@exception.Message</p>
            <button class="btn btn-primary" 
            @onclick="BackToHome">@UiLocalizer["GoHomePage"]
            </button>
        </div>;
    }

    private static bool IsUnauthorizedException(Exception exception)
    {
        if (exception is Volo.Abp.Http.Client.AbpRemoteCallException remoteEx)
        {
            var msg = remoteEx.Message ?? string.Empty;
            return msg.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase)
                   || msg.Contains("401", StringComparison.Ordinal)
                   || msg.Contains("Token", StringComparison.OrdinalIgnoreCase)
                   || msg.Contains("Authentication", StringComparison.OrdinalIgnoreCase);
        }
        return exception.InnerException != null && IsUnauthorizedException(exception.InnerException);
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
    }
    private void BackToHome()
    {
        NavigationManager.NavigateTo("/" , forceLoad: true);
    }
}
