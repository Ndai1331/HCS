@using System.Threading
@using HC.DocumentWorkflowInstances
@using HC.Documents
@using HC.WorkflowStepAssignments
@using HC.Shared
@using HC.Blazor.Components.Select2
@using Blazorise
@using Volo.Abp.Application.Dtos
@using Microsoft.Extensions.Caching.Memory
@inherits HCComponentBase
@inject IWorkflowStepAssignmentsAppService WorkflowStepAssignmentsAppService
@inject IDocumentsAppService DocumentsAppService
@inject IMemoryCache SigningFilterMemoryCache

<Card Class="hc-document-signing-filter">
    <CardBody>
        <Row Class="align-items-end g-3">
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnTablet.Is7.OnDesktop">
                <Row Class="align-items-center g-2">
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop">
                        <label class="fw-bold mb-2 mb-md-0">@L["FilterByDateRange"]</label>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop">
                        <DatePicker TValue="DateTime?"
                                    Dates="@SelectedDateRange"
                                    DatesChanged="OnSelectedDateRangeChanged"
                                    InputMode="DateInputMode.Date"
                                    SelectionMode="DateInputSelectionMode.Range"
                                    Placeholder="@L["SelectDateRange"]"
                                    DisplayFormat="dd/MM/yyyy"
                                    DatePickerLocalizer="DatePickerLocalizer" />
                    </Column>
                </Row>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnTablet.Is5.OnDesktop">
                <Field Margin="Margin.Is0">
                    <FieldLabel>@L["SigningExportDateFilter"]</FieldLabel>
                    <Select TValue="DocumentSigningDateFilterField"
                            SelectedValue="@ExportDateFilterField"
                            SelectedValueChanged="@ExportDateFilterFieldChanged">
                        <SelectItem Value="DocumentSigningDateFilterField.IncomingDate">@L["SigningExportDateFilterIncoming"]</SelectItem>
                        <SelectItem Value="DocumentSigningDateFilterField.WorkflowDeadline">@L["SigningExportDateFilterWorkflow"]</SelectItem>
                    </Select>
                </Field>
            </Column>
        </Row>
        <Row Class="align-items-end g-3 mt-0">
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                <Field Margin="Margin.Is0">
                    <FieldLabel>@L["FilterBySubmitter"]</FieldLabel>
                    <div class="hc-select2-full">
                        <UserSelect2 FilterFunction="GetSubmitterUserLookupAsync"
                                     GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                     Datasource="SubmitterUsersCollection"
                                     Value="@SelectedSubmitterUser"
                                     ValueChanged="@OnSubmitterUserChanged"
                                     Cache="SigningFilterMemoryCache"
                                     Multiselect="false" />
                    </div>
                </Field>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                <Field Margin="Margin.Is0">
                    <FieldLabel>@L["FilterBySubmitterOrganizationUnit"]</FieldLabel>
                    <div class="hc-select2-full">
                        <Select2 IdSelector="c => c.Id.ToString()"
                                 TextSelector="c => c.DisplayName"
                                 FilterFunction="GetOrganizationUnitLookupAsync"
                                 GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                 Datasource="OrganizationUnitsCollection"
                                 Value="@SelectedSubmitterOrganizationUnit"
                                 OnValueChanged="@OnSubmitterOrganizationUnitChanged"
                                 Cache="SigningFilterMemoryCache"
                                 Multiselect="false" />
                    </div>
                </Field>
            </Column>
        </Row>
        <Row Class="align-items-end g-3 mt-0">
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnTablet.Is7.OnDesktop">
                <Row Class="align-items-center g-2">
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop">
                        <label class="fw-bold mb-2 mb-md-0">@L["Search"]</label>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop">
                        <TextEdit Text="@FilterText"
                                  TextChanged="@FilterTextChanged"
                                  Placeholder="@L["SearchByTitleOrNumber"]" />
                    </Column>
                </Row>
            </Column>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnTablet.Is5.OnDesktop" Class="d-flex align-items-center">
                <Button Color="Color.Primary"
                        Clicked="@SearchClicked"
                        Class="w-100 mt-2 mt-md-0">
                    <Icon Name="IconName.Search" Class="me-1" />@L["Search"]
                </Button>
            </Column>
        </Row>
    </CardBody>
</Card>

@code {
    [Parameter] public IReadOnlyList<DateTime?> SelectedDateRange { get; set; } = new List<DateTime?>();
    [Parameter] public EventCallback<IReadOnlyList<DateTime?>> SelectedDateRangeChanged { get; set; }
    [Parameter] public DocumentSigningDateFilterField ExportDateFilterField { get; set; }
    [Parameter] public EventCallback<DocumentSigningDateFilterField> ExportDateFilterFieldChanged { get; set; }
    [Parameter] public string? FilterText { get; set; }
    [Parameter] public EventCallback<string?> FilterTextChanged { get; set; }
    [Parameter] public List<LookupDto<Guid>> SelectedSubmitterUser { get; set; } = new();
    [Parameter] public EventCallback<List<LookupDto<Guid>>> SelectedSubmitterUserChanged { get; set; }
    [Parameter] public List<LookupDto<Guid>> SelectedSubmitterOrganizationUnit { get; set; } = new();
    [Parameter] public EventCallback<List<LookupDto<Guid>>> SelectedSubmitterOrganizationUnitChanged { get; set; }
    [Parameter] public EventCallback SearchClicked { get; set; }

    private IReadOnlyList<LookupDto<Guid>> SubmitterUsersCollection { get; set; } = new List<LookupDto<Guid>>();
    private IReadOnlyList<LookupDto<Guid>> OrganizationUnitsCollection { get; set; } = new List<LookupDto<Guid>>();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrganizationUnitsForFilterAsync();
        await base.OnInitializedAsync();
    }

    private async Task OnSelectedDateRangeChanged(IReadOnlyList<DateTime?> dates)
    {
        await SelectedDateRangeChanged.InvokeAsync(dates);
    }

    private async Task OnSubmitterUserChanged(List<LookupDto<Guid>> value)
    {
        SelectedSubmitterUser = value ?? new List<LookupDto<Guid>>();
        await SelectedSubmitterUserChanged.InvokeAsync(SelectedSubmitterUser);
    }

    private async Task OnSubmitterOrganizationUnitChanged()
    {
        await SelectedSubmitterOrganizationUnitChanged.InvokeAsync(SelectedSubmitterOrganizationUnit);
    }

    private async Task<List<LookupDto<Guid>>> GetSubmitterUserLookupAsync(
        IReadOnlyList<LookupDto<Guid>> items,
        string filter,
        CancellationToken token)
    {
        var result = await WorkflowStepAssignmentsAppService.GetIdentityUserLookupAsync(new LookupRequestDto
        {
            Filter = filter,
            MaxResultCount = 20
        });
        SubmitterUsersCollection = result.Items ?? new List<LookupDto<Guid>>();
        return SubmitterUsersCollection.ToList();
    }

    private Task<List<LookupDto<Guid>>> GetOrganizationUnitLookupAsync(
        IReadOnlyList<LookupDto<Guid>> items,
        string filter,
        CancellationToken token)
    {
        var query = OrganizationUnitsCollection.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(filter))
        {
            var trimmed = filter.Trim();
            query = query.Where(x =>
                x.DisplayName != null && x.DisplayName.Contains(trimmed, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(query.Take(20).ToList());
    }

    private async Task LoadOrganizationUnitsForFilterAsync()
    {
        var organizationUnits = await DocumentsAppService.GetOrganizationUnitTreeAsync();
        OrganizationUnitsCollection = organizationUnits
            .Select(ou => new LookupDto<Guid>
            {
                Id = ou.Id,
                DisplayName = ou.DisplayName ?? ou.Code ?? ou.Id.ToString()
            })
            .OrderBy(x => x.DisplayName)
            .ToList();
    }

    private string DatePickerLocalizer(string name, params object[] arguments)
    {
        return name switch
        {
            "To" => L["DatePicker:To"],
            "From" => L["DatePicker:From"],
            "SelectDateRange" => L["DatePicker:SelectDateRange"],
            "FilterByDateRange" => L["DatePicker:FilterByDateRange"],
            "Search" => L["DatePicker:Search"],
            "Clear" => L["DatePicker:Clear"],
            "Cancel" => L["DatePicker:Cancel"],
            "Confirm" => L["DatePicker:Confirm"],
            _ => L[name] ?? name
        };
    }
}
