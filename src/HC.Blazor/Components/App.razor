@using System.Globalization
@using Microsoft.Extensions.Hosting
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Http
@using Volo.Abp.AspNetCore.Components.Server.LeptonXTheme.Bundling
@using Volo.Abp.AspNetCore.Components.Server.LeptonXTheme.Components
@using Volo.Abp.Localization
@using Volo.Abp.AspNetCore.Components.Web.Theming.Bundling
@inject IHostEnvironment Env
@{
    var rtl = CultureHelper.IsRtl ? "rtl" : string.Empty;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name" dir="@rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HC</title>
    <base href="/" />
    
    <AbpStyles BundleName="@BlazorLeptonXThemeBundles.Styles.Global" />

    <link href="HC.Blazor.styles.css" rel="stylesheet"/>

    <HeadOutlet @rendermode="InteractiveServer" />
    <link href="_content/KeudellCoding.Blazor.AdvancedBlazorSelect2/lib/select2/css/select2.min.css" rel="stylesheet" />

    <AppearanceStyles/>


    
    
</head>
<body class="abp-application-layout @rtl">

    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        @if (Env.IsDevelopment())
        {
            <text>An unhandled exception has occurred. See browser dev tools for details.</text>
        }
        else if (Env.IsStaging() || Env.IsProduction())
        {
            <text>An error has occurred. This application may no longer respond until reloaded.</text>
        }
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>
    
    <AbpScripts BundleName="@BlazorLeptonXThemeBundles.Scripts.Global" />
    <style>
        /* Base default - Small screens (under 1366px) */
        #lpx-wrapper.full .lpx-content{
            max-width: 100% !important;
            padding: 0 16px;
        }
        .full .lpx-topbar-container .lpx-topbar .lpx-breadcrumb-wrapper {
            max-width: 100% !important;
            padding: 0 16px;
        }

        /* Laptop 14-15 inch (1366px - 1600px) */
        @@media (min-width: 1366px) {
            #lpx-wrapper.full .lpx-content{
                max-width: 1280px !important;
                padding: 0 24px;
            }
            .full .lpx-topbar-container .lpx-topbar .lpx-breadcrumb-wrapper {
                max-width: 1280px !important;
                padding: 0 24px;
            }
        }

        /* Laptop 16 inch, Monitor 19-22 inch (1601px - 1920px) */
        @@media (min-width: 1601px) {
            #lpx-wrapper.full .lpx-content{
                max-width: 1500px !important;
                padding: 0 32px;
            }
            .full .lpx-topbar-container .lpx-topbar .lpx-breadcrumb-wrapper {
                max-width: 1500px !important;
                padding: 0 32px;
            }
        }

        /* Monitor 24-27 inch (1921px - 2560px) */
        @@media (min-width: 1921px) {
            #lpx-wrapper.full .lpx-content{
                max-width: 1800px !important;
                padding: 0 40px;
            }
            .full .lpx-topbar-container .lpx-topbar .lpx-breadcrumb-wrapper {
                max-width: 1800px !important;
                padding: 0 40px;
            }
        }

        /* Monitor 29-34 inch ultrawide (2561px+) */
        @@media (min-width: 2561px) {
            #lpx-wrapper.full .lpx-content{
                max-width: 2200px !important;
                padding: 0 48px;
            }
            .full .lpx-topbar-container .lpx-topbar .lpx-breadcrumb-wrapper {
                max-width: 2200px !important;
                padding: 0 48px;
            }
        }
    </style>
    <script src="_framework/blazor.web.js"></script>
   
    <!-- SignalR JavaScript client library -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>

    <script src="_content/KeudellCoding.Blazor.AdvancedBlazorSelect2/Select2JsInterop.js" type="text/javascript" language="javascript"></script>
    <script src="libs/AvatarManager.js" type="text/javascript" language="javascript"></script>
    <script src="_content/KeudellCoding.Blazor.AdvancedBlazorSelect2/lib/select2/js/select2.full.min.js" type="text/javascript" language="javascript"></script>
    <script src="global-scripts.js"></script>
    
    <!-- SignalR Logger - Must be loaded FIRST before all SignalR hubs -->
    <script src="signalr-logger.js"></script>
    
    <!-- Base Hub - Must be loaded BEFORE chatHub.js and notificationHub.js -->
    <script src="baseHubUpdated.js"></script>
    <script src="notificationHub.js"></script>
    <script src="chatHub.js"></script>

    <script src="currency-formatter.js"></script>
    <script src="chart-helper.js"></script>
</body>
</html>
