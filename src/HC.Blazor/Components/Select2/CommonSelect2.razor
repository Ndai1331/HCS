        multiple="@Multiselect"
        @attributes="AdditionalAttributes"></select>

<style>
    select.hc-common-select2 + .select2-container {
        width: 100% !important;
    }

    select.hc-common-select2 + .select2-container .select2-selection--single {
        height: auto !important;
        min-height: 2.75rem;
        display: flex;
        align-items: center;
    }

    select.hc-common-select2 + .select2-container .select2-selection--single .select2-selection__rendered {
        line-height: 1.4 !important;
        padding: 0.5rem 2.35rem 0.5rem 0.65rem !important;
    }

    select.hc-common-select2 + .select2-container .select2-selection--multiple {
        min-height: 2.75rem;
        padding: 0.2rem 0.35rem;
    }
</style>
