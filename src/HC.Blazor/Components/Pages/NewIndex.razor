@page "/new-index"
@attribute [Authorize]
@using HC.Workflows
@using HC.Projects
@using HC.ProjectTasks
@using HC.CalendarEvents
@using HC.Documents
@using HC.NotificationReceivers
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits HCComponentBase
@inject IWorkflowsAppService WorkflowsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

<style>
    /* Tùy chỉnh thanh cuộn cho CardBody */
    ::v-deep .overflow-auto::-webkit-scrollbar {
        width: 6px;
    }

    ::v-deep .overflow-auto::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.3);
        border-radius: 10px;
    }
</style>

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
        <Row>

            @* ===== ACTIVE PROJECTS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden bg-primary text-white w-100">
                    <CardHeader>
                        <Row>
                            <Column>
                                <Heading Size="HeadingSize.Is4" TextColor="TextColor.White">
                                    @L["ActiveProjects"]
                                </Heading>
                                <small class="text-muted">
                                    @ActiveProjectsCount @L["Of"] @TotalProjectsCount @L["Projects"]
                                </small>
                            </Column>
                        </Row>
                    </CardHeader>

                    <CardBody Style="max-height: 300px;" Class="overflow-auto py-2">
                        @if (IsLoading)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-white" role="status">
                                    <span class="visually-hidden">@L["Loading"]...</span>
                                </div>
                            </div>
                        }
                        else if (!ActiveProjectsList.Any())
                        {
                            <div class="text-center py-4">
                                <p class="text-white-50">@L["NoProjectsFound"]</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var project in ActiveProjectsList)
                            {
                                var progress = CalculateProjectProgress(project.Project.Status);
                                var progressColor = EnumStatusColorHelper.GetProjectStatusProgressBarColor(project.Project.Status);

                                <div class="mt-3">
                                    <h5 class="mb-1 text-white">@project.Project.Name.TruncateWithPostfix(26)</h5>
                                    <Row class="align-items-center">
                                        <Column>
                                            <div class="progress">
                                                <div class="progress-bar bg-@progressColor"
                                                     style="width:@(progress)%"></div>
                                            </div>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.IsAuto">
                                            <span class="text-muted">%@progress</span>
                                        </Column>
                                    </Row>
                                </div>
                            }
                        }
                    </CardBody>

                    <CardFooter Class="bg-transparent border-0 pt-3">
                        <Button Color="Color.Light" Class="w-100" Clicked="@(() => Navigation.NavigateTo("/projects"))">
                            <Icon Name="IconName.Add" Class="me-1" /> @L["NewProject"]
                        </Button>
                    </CardFooter>
                </Card>
            </Column>

            @* ===== TASKS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden w-100">
                    <CardHeader>
                        <Heading Size="HeadingSize.Is4">
                            @L["Tasks"]
                        </Heading>
                    </CardHeader>

                    <CardBody>

                        @* Dynamic Donut Chart with Real Data *@
                        @if (IsLoading)
                        {
                            <div class="d-flex justify-content-center align-items-center" style="min-height: 187px;">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">@L["Loading"]...</span>
                                </div>
                            </div>
                        }
                        else if (TotalTasksCount == 0)
                        {
                            <div class="d-flex justify-content-center align-items-center" style="min-height: 187px;">
                                <p class="text-muted">@L["NoTasksFound"]</p>
                            </div>
                        }
                        else
                        {
                            var chartData = GetChartData();
                            <div id="chart1" class="d-flex justify-content-center" style="min-height: 187px;">
                                <svg width="220" height="187" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 187">
                                    <g transform="translate(18.33, 0)">
                                        <circle r="54.23" cx="91.67" cy="91.67" fill="transparent"></circle>
                                        <g>
                                            @{
                                                double startAngle = 0;
                                                int index = 0;
                                            }
                                            @foreach (var segment in chartData)
                                            {
                                                var angle = segment.Percentage * 3.6; // Convert percentage to degrees
                                                var path = GetDonutPath(91.67, 91.67, 83.43, 54.23, startAngle, angle);

                                                <path d="@path"
                                                      fill="@segment.Color"
                                                      fill-opacity="1"
                                                      stroke="var(--lpx-card-bg, #fff)"
                                                      stroke-width="2"
                                                      class="apexcharts-pie-area apexcharts-donut-slice-@index">
                                                </path>

                                                startAngle += angle;
                                                index++;
                                            }
                                        </g>
                                    </g>
                                </svg>
                            </div>
                        }

                        <div class="mt-3">
                            @if (IsLoading)
                            {
                                <div class="text-center py-2">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">@L["Loading"]...</span>
                                    </div>
                                </div>
                            }
                            else if (TotalTasksCount == 0)
                            {
                                <p class="text-muted text-center">@L["NoTasksFound"]</p>
                            }
                            else
                            {
                                @foreach (var statusKvp in TasksByStatus.OrderBy(x => Enum.Parse<ProjectTaskStatus>(x.Key)))
                                {
                                    var percentage = GetTaskPercentage(statusKvp.Key);
                                    var status = Enum.Parse<ProjectTaskStatus>(statusKvp.Key);
                                    var colorClass = EnumStatusColorHelper.GetProjectTaskStatusProgressChartColor(status);

                                    <div class="d-flex align-items-baseline mb-1">
                                        <span class="bg-@colorClass me-2 p-1 rounded-circle"></span>
                                        <span><span class="text-@colorClass me-2">%@percentage</span> @L[$"Enum:ProjectTaskStatus.{statusKvp.Key}"] (@statusKvp.Value)</span>
                                    </div>
                                }
                            }
                        </div>

                    </CardBody>
                </Card>
            </Column>

        </Row>
    </Column>

    <!-- Calendar -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
        <Card Class="w-100 overflow-hidden">
            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["Calendar"]</Heading>
                <small class="text-muted d-block">@L["Total"] @TotalEvents @L["CalenderEvents"]</small>
            </CardHeader>

            <CardBody>
                <!-- Tabs -->
                <Tabs SelectedTab="@SelectedDayTab"
                    SelectedTabChanged="@(tab => SelectedDayTab = tab)"
                    Class="mb-2.5 d-flex justify-content-between">

                    <Items>
                        @foreach (var tab in DayTabs)
                        {
                            <Tab Name="@tab.Key" Style="padding: 0.5rem 1.25rem;">
                                <div class="text-center">
                                    <span class="d-block mb-1 text-muted">@tab.Day</span>
                                    <strong>@tab.Date</strong>
                                </div>
                            </Tab>
                        }
                    </Items>

                    <Content>
                        @foreach (var tab in DayTabs)
                        {
                            <TabPanel Name="@tab.Key">
                                @if (IsLoading)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm" role="status">
                                            <span class="visually-hidden">@L["Loading"]...</span>
                                        </div>
                                    </div>
                                }
                                else if (!EventsByDay.ContainsKey(tab.Key) || !EventsByDay[tab.Key].Any())
                                {
                                    <div class="text-center py-4">
                                        <p class="text-muted">@L["NoUpcomingEvents"]</p>
                                    </div>
                                }
                                else
                                {
                                    <div style="max-height: 240px;" class="overflow-auto">
                                        <table class="table mb-0">
                                            <tbody>
                                                @foreach (var ev in EventsByDay[tab.Key])
                                                {
                                                    <tr>
                                                        <td class="ps-0">
                                                            <div class="d-flex align-items-center">
                                                                <span class="me-2 rounded-3"
                                                                    style="width:3px;height:66px;
                                                                            background-color:var(--bs-primary)">
                                                                </span>

                                                                <div>
                                                                    <h5 class="mb-1">@ev.StartTime.ToString("HH:mm") - @ev.EndTime.ToString("HH:mm")</h5>
                                                                    <h6 class="text-muted fw-normal mb-0">@ev.Title</h6>
                                                                    @if (!string.IsNullOrEmpty(ev.Description))
                                                                    {
                                                                        <small class="text-muted">@ev.Description</small>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td class="text-end">
                                                            <Button Color="Color.Light" Size="Size.Small" Clicked="@(() => Navigation.NavigateTo($"/calendar-events"))">
                                                                @L["View"]
                                                            </Button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </TabPanel>
                        }
                    </Content>
                </Tabs>
            </CardBody>
        </Card>
    </Column>

    <!-- Documents -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop" Class="d-flex">
        <Card Class="w-100">

            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["Documents"]</Heading>
                <small class="text-muted d-block text-truncate">
                    @L["Update"] @LastDocumentTimeAgo
                </small>
            </CardHeader>

            <CardBody>
                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["Loading"]...</span>
                        </div>
                    </div>
                }
                else if (!RecentDocumentsList.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted">@L["NoRecentDocuments"]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                @foreach (var doc in RecentDocumentsList)
                                {
                                    var shortName = doc.Document.Title?.Substring(0, Math.Min(1, doc.Document.Title.Length)).ToUpper() ?? "D";
                                    var bgClass = "bg-primary";

                                    <tr>
                                        <td class="ps-0">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-3 me-2 flex-center text-white @bgClass"
                                                    style="width:36px;height:36px">
                                                    <h4 class="mb-0">@shortName</h4>
                                                </div>

                                                <div>
                                                    <h6 class="mb-0 text-dark">@doc.Document.Title</h6>
                                                    <small class="text-muted">@doc.Document.CreationTime.ToString("dd/MM/yyyy")</small>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-end">
                                            <Button Color="Color.Light" Size="Size.Small" Clicked="@(() => Navigation.NavigateTo($"/documents"))">
                                                @L["View"]
                                            </Button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </CardBody>

        </Card>
    </Column>

    <!-- Notifications -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop" Class="d-flex">
        <Card Class="w-100">

            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["Notifications"]</Heading>
                <small class="text-muted d-block text-truncate">
                    @L["Update"] @LastNotificationTimeAgo
                </small>
            </CardHeader>

            <CardBody>
                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["Loading"]...</span>
                        </div>
                    </div>
                }
                else if (!RecentNotificationsList.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted">@L["NoRecentNotifications"]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>@L["Title"]</th>
                                    <th>@L["Date"]</th>
                                    <th>@L["Status"]</th>
                                    <th>@L["View"]</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var notification in RecentNotificationsList)
                                {
                                    var statusClass = notification.NotificationReceiver.IsRead ? "bg-success" : "bg-warning";
                                    var statusText = notification.NotificationReceiver.IsRead ? L["Read"] : L["Unread"];

                                    <tr>
                                        <td>
                                            <div>
                                                <h6 class="mb-0">@GetLocalizedTitle(notification.Notification)</h6>
                                                @if (!string.IsNullOrEmpty(notification.Notification.Content))
                                                {
                                                    <small class="text-muted">@GetLocalizedContent(notification.Notification).Substring(0, Math.Min(70, @GetLocalizedContent(notification.Notification).Length))...</small>
                                                }
                                            </div>
                                        </td>

                                        <td>
                                            <span class="text-muted">@notification.NotificationReceiver.CreationTime.ToString("dd/MM/yyyy")</span>
                                        </td>

                                        <td>
                                            <div class="badge soft @statusClass">
                                                @statusText
                                            </div>
                                        </td>

                                        <td>
                                            <Button Color="Color.Dark"
                                                    Class="grey px-1 py-0"
                                                    Clicked="@(() => Navigation.NavigateTo($"/notification-receivers"))">
                                                <i class="bi bi-arrow-right fs-5"></i>
                                            </Button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </CardBody>

        </Card>
    </Column>
</Row>

@code {
    // Calendar
    private string SelectedDayTab { get; set; } = "";

    private List<CalendarDayTab> DayTabs { get; set; } = new();
    private Dictionary<string, List<CalendarEventDto>> EventsByDay { get; set; } = new();

    private void GenerateCalendarTabs()
    {
        DayTabs.Clear();
        EventsByDay.Clear();

        var today = DateTime.Now.Date;
        for (int i = 0; i < 7; i++)
        {
            var date = today.AddDays(i);
            var key = $"day-{i}";
            var dayName = date.ToString("ddd");
            var dayNumber = date.Day;

            DayTabs.Add(new CalendarDayTab(key, dayName, dayNumber));

            // Group events by day
            var eventsForDay = CalendarEventsList
                .Where(e => e.StartTime.Date == date)
                .OrderBy(e => e.StartTime)
                .ToList();

            EventsByDay[key] = eventsForDay;
        }

        // Set first tab as selected
        SelectedDayTab = DayTabs.FirstOrDefault()?.Key ?? "";
    }

    record CalendarDayTab(string Key, string Day, int Date);

    // Chart data generation
    private List<ChartSegment> GetChartData()
    {
        var segments = new List<ChartSegment>();

        foreach (var statusKvp in TasksByStatus.OrderBy(x => x.Key))
        {
            var percentage = GetTaskPercentage(statusKvp.Key);
            var color = statusKvp.Key switch
            {
                "TODO" => "var(--lpx-secondary)",
                "IN_PROGRESS" => "var(--lpx-info)",
                "WAITING" => "var(--lpx-warning)",
                "DONE" => "var(--lpx-success)",
                "CANCELLED" => "var(--lpx-danger)",
                _ => "var(--lpx-secondary)"
            };

            segments.Add(new ChartSegment(statusKvp.Key, statusKvp.Value, percentage, color));
        }

        return segments;
    }

    private string GetDonutPath(double cx, double cy, double outerRadius, double innerRadius, double startAngle, double angleSize)
    {
        if (angleSize >= 360) angleSize = 359.99; // Prevent full circle issues

        var startRad = (startAngle - 90) * Math.PI / 180;
        var endRad = (startAngle + angleSize - 90) * Math.PI / 180;

        var x1 = cx + outerRadius * Math.Cos(startRad);
        var y1 = cy + outerRadius * Math.Sin(startRad);
        var x2 = cx + outerRadius * Math.Cos(endRad);
        var y2 = cy + outerRadius * Math.Sin(endRad);

        var x3 = cx + innerRadius * Math.Cos(endRad);
        var y3 = cy + innerRadius * Math.Sin(endRad);
        var x4 = cx + innerRadius * Math.Cos(startRad);
        var y4 = cy + innerRadius * Math.Sin(startRad);

        var largeArc = angleSize > 180 ? 1 : 0;

        // Use InvariantCulture to ensure decimal point (.) instead of comma (,)
        return string.Format(System.Globalization.CultureInfo.InvariantCulture,
            "M {0:F2} {1:F2} A {2:F2} {3:F2} 0 {4} 1 {5:F2} {6:F2} L {7:F2} {8:F2} A {9:F2} {10:F2} 0 {11} 0 {12:F2} {13:F2} Z",
            x1, y1, outerRadius, outerRadius, largeArc, x2, y2, x3, y3, innerRadius, innerRadius, largeArc, x4, y4);
    }

    record ChartSegment(string Status, int Count, double Percentage, string Color);

}