@page "/new-index"
@attribute [Authorize]
@using HC.Workflows
@using HC.Projects
@using HC.ProjectTasks
@using HC.CalendarEvents
@using HC.Documents
@using HC.NotificationReceivers
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits HCComponentBase
@inject IWorkflowsAppService WorkflowsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

<style>
    /* Tùy chỉnh thanh cuộn cho CardBody */
    ::v-deep .overflow-auto::-webkit-scrollbar {
        width: 6px;
    }

    ::v-deep .overflow-auto::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.3);
        border-radius: 10px;
    }
</style>

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
        <Row>

            @* ===== ACTIVE PROJECTS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden bg-primary text-white w-100">
                    <CardHeader>
                        <Row>
                            <Column>
                                <Heading Size="HeadingSize.Is4" TextColor="TextColor.White">
                                    @L["ActiveProjects"]
                                </Heading>
                                <small class="text-muted">
                                    @ActiveProjectsCount @L["Of"] @TotalProjectsCount @L["Projects"]
                                </small>
                            </Column>
                        </Row>
                    </CardHeader>

                    <CardBody Style="max-height: 300px;" Class="overflow-auto py-2">
                        @if (IsLoading)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-white" role="status">
                                    <span class="visually-hidden">@L["Loading"]...</span>
                                </div>
                            </div>
                        }
                        else if (!ActiveProjectsList.Any())
                        {
                            <div class="text-center py-4">
                                <p class="text-white-50">@L["NoProjectsFound"]</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var project in ActiveProjectsList)
                            {
                                var progress = CalculateProjectProgress(project.Project.Status);
                                var progressColor = EnumStatusColorHelper.GetProjectStatusProgressBarColor(project.Project.Status);

                                <div class="mt-3">
                                    <h5 class="mb-1 text-white">@project.Project.Name.TruncateWithPostfix(26)</h5>
                                    <Row class="align-items-center">
                                        <Column>
                                            <div class="progress">
                                                <div class="progress-bar bg-@progressColor"
                                                     style="width:@(progress)%"></div>
                                            </div>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.IsAuto">
                                            <span class="text-muted">%@progress</span>
                                        </Column>
                                    </Row>
                                </div>
                            }
                        }
                    </CardBody>

                    <CardFooter Class="bg-transparent border-0 pt-3">
                        <Button Color="Color.Light" Class="w-100" Clicked="@(() => Navigation.NavigateTo("/projects"))">
                            <Icon Name="IconName.Add" Class="me-1" /> @L["NewProject"]
                        </Button>
                    </CardFooter>
                </Card>
            </Column>

            @* ===== TASKS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden w-100">
                    <CardHeader>
                        <Heading Size="HeadingSize.Is4">
                            @L["Tasks"]
                        </Heading>
                    </CardHeader>

                    <CardBody>

