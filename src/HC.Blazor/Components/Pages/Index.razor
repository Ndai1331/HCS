@page "/"
@attribute [Authorize]
@using HC.Workflows
@using HC.Projects
@using HC.ProjectTasks
@using HC.CalendarEvents
@using HC.Documents
@using HC.NotificationReceivers
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@using HC.Blazor.Components.Charts
@inherits HCComponentBase
@inject IWorkflowsAppService WorkflowsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

<style>
    .nav-link {
        padding: 0.675rem 1rem !important;
        border-radius: 0.5rem !important;
        border-bottom: none !important;
    }

    .nav-link:active, .nav-link.active {
        color: #f72585 !important;
        background-color: #f7258526 !important;
    }

    .nav-link.active .text-muted {
        color: #f72585 !important;
        opacity: 1 !important;
    }

    .nav-link:not(.active):hover {
        border-color: rgba(50, 81, 104, 0.08) !important;
        background-color: rgba(50, 81, 104, 0.08) !important;
        color: #062a44 !important;
    }
</style>

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
        <Row>

            @* ===== ACTIVE PROJECTS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden bg-primary text-white w-100">
                    <CardHeader>
                        <Row>
                            <Column>
                                <Heading Size="HeadingSize.Is4" TextColor="TextColor.White">
                                    @L["ActiveProjects"]
                                </Heading>
                                <small class="text-muted">
                                    @ActiveProjectsCount @L["Of"] @TotalProjectsCount @L["Projects"]
                                </small>
                            </Column>
                        </Row>
                    </CardHeader>

                    <CardBody Style="max-height: 370px;" Class="overflow-auto py-2">
                        @if (IsLoading)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border text-white" role="status">
                                    <span class="visually-hidden">@L["Loading"]...</span>
                                </div>
                            </div>
                        }
                        else if (!ActiveProjectsList.Any())
                        {
                            <div class="text-center py-4">
                                <p class="text-white-50">@L["NoProjectsFound"]</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var project in ActiveProjectsList.OrderByDescending(x => x.Project.Status).ThenByDescending(x => x.Project.CreationTime))
                            {
                                var progress = CalculateProjectProgress(project.Project.Status);
                                var progressColor = EnumStatusColorHelper.GetProjectStatusProgressBarColor(project.Project.Status);

                                <div class="mt-3" @onclick="@(() => Navigation.NavigateTo($"/project-detail/{project.Project.Id}"))" style="cursor: pointer;">
                                    <h5 class="mb-1 text-white">@project.Project.Name.TruncateWithPostfix(26)</h5>
                                    <Row class="align-items-center">
                                        <Column>
                                            <div class="progress">
                                                <div class="progress-bar bg-@progressColor"
                                                     style="width:@(progress)%"></div>
                                            </div>
                                        </Column>
                                        <Column ColumnSize="ColumnSize.IsAuto">
                                            <span class="text-muted">%@progress</span>
                                        </Column>
                                    </Row>
                                </div>
                            }
                        }
                    </CardBody>

                    <CardFooter Class="bg-transparent border-0 pt-3">
                        <Button Class="w-100 bg-brand text-white" 
                        Color="Color.Light"
                        Clicked="OpenCreateProjectModalAsync">
                            <Icon Name="IconName.Add" Class="me-1" /> @L["NewProject"]
                        </Button>
                    </CardFooter>
                </Card>
            </Column>

            @* ===== TASKS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden w-100">
                    <CardHeader>
                        <Heading Size="HeadingSize.Is4">
                            @L["Tasks"]
                        </Heading>
                    </CardHeader>

                    <CardBody>

                        @* Dynamic Donut Chart with Real Data *@
                        @* Task Distribution Donut Chart *@
                        @if (IsLoading)
                        {
                            <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">@L["Loading"]...</span>
                                </div>
                            </div>
                        }
                        else if (TotalTasksCount == 0)
                        {
                            <div class="d-flex justify-content-center align-items-center" style="min-height: 300px;">
                                <p class="text-muted">@L["NoTasksFound"]</p>
                            </div>
                        }
                        else
                        {
                            <PieChart ChartId="taskDistributionChart"
                                      Labels="@TaskChartLabels"
                                      Data="@TaskChartData"
                                      BackgroundColors="@TaskChartColors"
                                      IsDoughnut="true"
                                      ShowLegend="false" />
                        }

                        <div class="mt-3">
                            @if (IsLoading)
                            {
                                <div class="text-center py-2">
                                    <div class="spinner-border spinner-border-sm" role="status">
                                        <span class="visually-hidden">@L["Loading"]...</span>
                                    </div>
                                </div>
                            }
                            else if (TotalTasksCount == 0)
                            {
                                <p class="text-muted text-center">@L["NoTasksFound"]</p>
                            }
                            else
                            {
                                @foreach (var statusKvp in TasksByStatus.OrderBy(x => Enum.Parse<ProjectTaskStatus>(x.Key)))
                                {
                                    var percentage = GetTaskPercentage(statusKvp.Key);
                                    var status = Enum.Parse<ProjectTaskStatus>(statusKvp.Key);
                                    var colorClass = EnumStatusColorHelper.GetProjectTaskStatusProgressChartColor(status);

                                    <div class="d-flex align-items-baseline mb-1">
                                        <span class="bg-@colorClass me-2 p-1 rounded-circle"></span>
                                        <span><span class="text-@colorClass me-2">%@percentage</span> @L[$"Enum:ProjectTaskStatus.{statusKvp.Key}"] (@statusKvp.Value)</span>
                                    </div>
                                }
                            }
                        </div>

                    </CardBody>
                </Card>
            </Column>

        </Row>
    </Column>

    <!-- Calendar -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
        <Card Class="w-100 overflow-hidden">
            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["Calendar"]</Heading>
                <small class="text-muted d-block">@L["Total"] @TotalEvents @L["CalenderEvents"]</small>
            </CardHeader>

            <CardBody>
                <!-- Tabs -->
                <Tabs SelectedTab="@SelectedDayTab"
                    SelectedTabChanged="@(tab => SelectedDayTab = tab)"
                    Class="mb-2.5 d-flex justify-content-between">

                    <Items>
                        @foreach (var tab in DayTabs)
                        {
                            <Tab Name="@tab.Key">
                                <div class="text-center">
                                    <span class="d-block mb-1 text-muted">@tab.Day</span>
                                    <strong>@tab.Date</strong>
                                </div>
                            </Tab>
                        }
                    </Items>

                    <Content>
                        @foreach (var tab in DayTabs)
                        {
                            <TabPanel Name="@tab.Key">
                                @if (IsLoading)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm" role="status">
                                            <span class="visually-hidden">@L["Loading"]...</span>
                                        </div>
                                    </div>
                                }
                                else if (!EventsByDay.ContainsKey(tab.Key) || !EventsByDay[tab.Key].Any())
                                {
                                    <div class="text-center py-4">
                                        <p class="text-muted">@L["NoUpcomingEvents"]</p>
                                    </div>
                                }
                                else
                                {
                                    <div style="max-height: 280px;" class="overflow-auto">
                                        <table class="table mb-0">
                                            <tbody>
                                                @foreach (var ev in EventsByDay[tab.Key])
                                                {
                                                    <tr>
                                                        <td class="ps-0">
                                                            <div class="d-flex align-items-center">
                                                                <span class="me-2 rounded-3"
                                                                    style="width:3px;height:66px;
                                                                            background-color:var(--bs-primary)">
                                                                </span>

                                                                <div>
                                                                    <h5 class="mb-1">@ev.StartTime.ToString("HH:mm") - @ev.EndTime.ToString("HH:mm")</h5>
                                                                    <h6 class="text-muted fw-normal mb-0">@ev.Title</h6>
                                                                    @if (!string.IsNullOrEmpty(ev.Description))
                                                                    {
                                                                        <small class="text-muted">@ev.Description</small>
                                                                    }
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <td class="text-end">
                                                            <Button 
                                                             Size="Size.Small"
                                                             Class="bg-brand text-white"
                                                             Clicked="@(() => Navigation.NavigateTo($"/calendar-events"))">
                                                                @L["View"]
                                                            </Button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </TabPanel>
                        }
                    </Content>
                </Tabs>
            </CardBody>
        </Card>
    </Column>

    

    <!-- Notifications -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop" Class="d-flex">
        <Card Class="w-100">

            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["Notifications"]</Heading>
                <small class="text-muted d-block text-truncate">
                    @if (!string.IsNullOrEmpty(LastNotificationTimeAgo))
                    {
                        @L["Update"]@(" ")@LastNotificationTimeAgo
                    }
                    else
                    {
                        @L["NoRecentUpdates"]
                    }
                </small>
            </CardHeader>

            <CardBody>
                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["Loading"]...</span>
                        </div>
                    </div>
                }
                else if (!RecentNotificationsList.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted">@L["NoRecentNotifications"]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive overflow-auto" style="max-height: 280px;">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>@L["Title"]</th>
                                    <th>@L["View"]</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var notification in RecentNotificationsList)
                                {
                                    <tr class="@(notification.NotificationReceiver.IsRead ? "" : "notification-unread")">
                                        <td>
                                            <div>
                                                <h6 class="mb-0">@GetLocalizedTitle(notification.Notification)</h6>
                                                <small class="text-muted">@notification.NotificationReceiver.CreationTime.ToString("dd/MM/yyyy")</small>
                                                @if (!string.IsNullOrEmpty(notification.Notification.Content))
                                                {
                                                    <br />
                                                    <small class="text-black">@GetLocalizedContent(notification.Notification).Substring(0, Math.Min(70, @GetLocalizedContent(notification.Notification).Length))...</small>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <Button Color="Color.Dark"
                                                    Class="grey px-1 py-0 bg-brand text-white"
                                                    Clicked="@(() => Navigation.NavigateTo($"/notification-receivers"))">
                                                <i class="bi bi-arrow-right fs-5"></i>
                                            </Button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </CardBody>

        </Card>
    </Column>

    <!-- Documents -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop" Class="d-flex">
        <Card Class="w-100">
            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["Documents"]</Heading>
                <small class="text-muted d-block text-truncate">
                    @if (!string.IsNullOrEmpty(LastDocumentTimeAgo))
                    {
                        @L["Update"]@(" ")@LastDocumentTimeAgo
                    } 
                    else
                    {
                        @L["NoRecentUpdates"]
                    }
                </small>
            </CardHeader>

            <CardBody>
                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["Loading"]...</span>
                        </div>
                    </div>
                }
                else if (!RecentDocumentsList.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted">@L["NoRecentDocuments"]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <tbody>
                                @foreach (var doc in RecentDocumentsList)
                                {
                                    var shortName = doc.Document.Title?.Substring(0, Math.Min(1, doc.Document.Title.Length)).ToUpper() ?? "D";
                                    var bgClass = "bg-primary";

                                    <tr>
                                        <td class="ps-0">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-3 me-2 flex-center text-white @bgClass"
                                                    style="width:36px;height:36px">
                                                    <h4 class="mb-0">@shortName</h4>
                                                </div>

                                                <div>
                                                    <h6 class="mb-0 text-dark">@doc.Document.Title</h6>
                                                    <small class="text-muted">@doc.DocumentAssignment.CreationTime.ToString("dd/MM/yyyy")</small>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-end">
                                            <Button 
                                                Class="bg-brand text-white"
                                                Size="Size.Small" 
                                                Clicked="@(() => OpenDocumentPdfViewerModalAsync(doc))">
                                                <Icon Name="IconName.Eye" />
                                            </Button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </CardBody>

        </Card>
    </Column>


    
    <!-- My Tasks -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop" Class="d-flex">
        <Card Class="w-100">
            <CardHeader>
                <Heading Size="HeadingSize.Is4">@L["MyTasks"]</Heading>
            </CardHeader>

            <CardBody>
                @if (IsLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">@L["Loading"]...</span>
                        </div>
                    </div>
                }
                else if (!MyTasksList.Any())
                {
                    <div class="text-center py-4">
                        <p class="text-muted">@L["NoRecentDocuments"]</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive" style="max-height: 350px;">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>@L["Title"]</th>
                                    <th>@L["Description"]</th>
                                    <th style="width: 30%;">@L["StartDateAndEndDate"]</th>
                                    <th style="width: 100px;">@L["Status"]</th>
                                    <th>@L["Priority"]</th>
                                    <th>@L["ProgressPercent"]</th>
                                    <th class="text-end">@L["Actions"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var task in MyTasksList)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <h6 class="mb-0 text-dark">@task.ProjectTask.Title</h6>
                                            </div>
                                            <small class="text-muted">@task.ProjectTask.Code</small>
                                        </td>
                                        <td>
                                            <small>@(task.ProjectTask.Description?.TruncateWithPostfix(130, "...") ?? "-")</small>
                                        </td>
                                        <td>
                                            <span>
                                                <i class="bi bi-calendar text-success"></i> @task.ProjectTask.StartDate.ToString("dd/MM/yyyy HH:mm") - 
                                                <i class="bi bi-calendar-check text-brand me-1"></i>@task.ProjectTask.DueDate.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="hc-badge-subtle
                                                hc-badge-@(GetStatusBadgeColor(task.ProjectTask.Status))-subtle">
                                                @L[$"Enum:ProjectTaskStatus.{task.ProjectTask.Status}"]
                                            </span>
                                        </td>

                                        <td>
                                             <Badge Color="@GetPriorityBadgeColor(task.ProjectTask.Priority)"
                                             Class="text-white">
                                                @L[$"Enum:ProjectTaskPriority.{task.ProjectTask.Priority}"]
                                            </Badge>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress" style="width: 80px; height: 8px;">
                                                    <div class="progress-bar" 
                                                         style="width: @task.ProjectTask.ProgressPercent%"
                                                         role="progressbar">
                                                    </div>
                                                </div>
                                                <small class="text-muted">@task.ProjectTask.ProgressPercent%</small>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <Button 
                                                Size="Size.Small" 
                                                Class="bg-brand text-white"
                                                Clicked="@(() => OpenTaskDetailModalAsync(task))">
                                                <Icon Name="IconName.Eye" />
                                            </Button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </CardBody>

        </Card>
    </Column>
</Row>

@code {
    // Calendar
    private string SelectedDayTab { get; set; } = "";

    private List<CalendarDayTab> DayTabs { get; set; } = new();
    private Dictionary<string, List<CalendarEventDto>> EventsByDay { get; set; } = new();

    private void GenerateCalendarTabs()
    {
        DayTabs.Clear();
        EventsByDay.Clear();

        var today = DateTime.Now.Date;
        for (int i = 0; i < 7; i++)
        {
            var date = today.AddDays(i);
            var key = $"day-{i}";
            var dayName = date.ToString("ddd");
            var dayNumber = date.Day;

            DayTabs.Add(new CalendarDayTab(key, dayName, dayNumber));

            // Group events by day
            var eventsForDay = CalendarEventsList
                .Where(e => e.StartTime.Date <= date)
                .Where(e => e.EndTime.Date >= date)
                .OrderBy(e => e.StartTime)
                .ToList();

            EventsByDay[key] = eventsForDay;
        }

        // Set first tab as selected
        SelectedDayTab = DayTabs.FirstOrDefault()?.Key ?? "";
    }

    record CalendarDayTab(string Key, string Day, int Date);

    // Task Chart Data for PieChart component
    private List<string> TaskChartLabels => TasksByStatus.OrderBy(x => x.Key).Select(x => L[$"Enum:ProjectTaskStatus.{x.Key}"].ToString()).ToList();

    private List<double> TaskChartData => TasksByStatus.OrderBy(x => x.Key).Select(x => (double)x.Value).ToList();

    private List<string> TaskChartColors => TasksByStatus.OrderBy(x => x.Key).Select(x => x.Key switch
    {
        "TODO" => "#355dff",           // primary
        "IN_PROGRESS" => "#4fbf67",    // success
        "WAITING" => "#ff9f38",        // warning
        "DONE" => "#f72585",           // brand
        "CANCELLED" => "#c00d49",      // danger
        _ => "#355dff"                 // primary
    }).ToList();

}

@* ************************* TASK DETAIL MODAL ************************* *@


 <Modal @ref="TaskDetailModal">
        <ModalContent Size="ModalSize.ExtraLarge" Centered="true">
            <ModalHeader>
                <ModalTitle>@L["TaskDetail"]</ModalTitle>
                <CloseButton Clicked="CloseTaskDetailModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Tabs SelectedTab="@SelectedTab" SelectedTabChanged="OnSelectedTabChanged">
                    <Items>
                        <Tab Name="general">
                            <Icon Name="IconName.Info" Class="me-1" />
                            @L["Tab:GeneralInformation"]
                        </Tab>
                        <Tab Name="assignments">
                            <Icon Name="IconName.Users" Class="me-1" />
                            @L["Tab:Assignments"]
                        </Tab>
                        <Tab Name="documents">
                            <Icon Name="IconName.File" Class="me-1" />
                            @L["Tab:Documents"]
                        </Tab>
                    </Items>
                    <Content>
                        @* General Tab *@
                        <TabPanel Name="general">
                            <div class="mb-3">
                                <label class="form-label fw-bold">@L["Code"]</label>
                                <div>@(SelectedTask?.ProjectTask.Code ?? "-")</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">@L["Title"]</label>
                                <div>@(SelectedTask?.ProjectTask.Title ?? "-")</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">@L["Description"]</label>
                                <div>@(SelectedTask?.ProjectTask.Description ?? "-")</div>
                            </div>
                            <Row class="g-3">
                                <Column ColumnSize="ColumnSize.Is6">
                                    <label class="form-label fw-bold">@L["Status"]</label>
                                    <div>
                                        <Badge Color="@GetStatusBadgeColor(SelectedTask?.ProjectTask.Status ?? "")">
                                            @L[$"Enum:ProjectTaskStatus.{SelectedTask?.ProjectTask.Status ?? ""}"]
                                        </Badge>
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <label class="form-label fw-bold">@L["Priority"]</label>
                                    <div>
                                        <Badge Color="@GetPriorityBadgeColor(SelectedTask?.ProjectTask.Priority ?? "")">
                                            @L[$"Enum:ProjectTaskPriority.{SelectedTask?.ProjectTask.Priority ?? ""}"]
                                        </Badge>
                                    </div>
                                </Column>
                            </Row>
                            <div class="mt-3">
                                <label class="form-label fw-bold">@L["ProgressPercent"]</label>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="progress" style="flex: 1; height: 8px;">
                                        <div class="progress-bar" 
                                             style="width: @(SelectedTask?.ProjectTask.ProgressPercent ?? 0)%"
                                             role="progressbar">
                                        </div>
                                    </div>
                                    <span>@(SelectedTask?.ProjectTask.ProgressPercent ?? 0)%</span>
                                </div>
                            </div>
                            <Row class="g-3 mt-3">
                                <Column ColumnSize="ColumnSize.Is6">
                                    <label class="form-label fw-bold">@L["StartDate"]</label>
                                    <div>@(SelectedTask?.ProjectTask.StartDate.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is6">
                                    <label class="form-label fw-bold">@L["DueDate"]</label>
                                    <div>@(SelectedTask?.ProjectTask.DueDate.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                </Column>
                            </Row>
                            <div class="mt-3">
                                <label class="form-label fw-bold">@L["Project"]</label>
                                <div>@(SelectedTask?.Project?.Name ?? "-")</div>
                            </div>
                        </TabPanel>

                        @* Assignments Tab *@
                        <TabPanel Name="assignments">
                            @if (!SelectedTaskAssignments.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    @L["NoAssignments"]
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>@L["Members"]</th>
                                                <th>@L["MemberRole"]</th>
                                                <th>@L["AssignedAt"]</th>
                                                <th>@L["Note"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var assignment in SelectedTaskAssignments)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" 
                                                                 style="width: 32px; height: 32px;">
                                                                <span class="fs-6">@GetUserInitial(assignment.User)</span>
                                                            </div>
                                                            <span>@GetUserDisplayName(assignment.User)</span>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-info">
                                                            @L[$"Enum:ProjectTaskAssignmentRole.{assignment.ProjectTaskAssignment.AssignmentRole}"]
                                                        </span>
                                                    </td>
                                                    <td>@assignment.ProjectTaskAssignment.AssignedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                    <td>@(assignment.ProjectTaskAssignment.Note ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </TabPanel>

                        @* Documents Tab *@
                        <TabPanel Name="documents">
                            @if (!SelectedTaskDocuments.Any())
                            {
                                <div class="text-center text-muted py-4">
                                    @L["NoDocumentsAvailable"]
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>@L["Title"]</th>
                                                <th>@L["Purpose"]</th>
                                                <th>@L["Actions"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var doc in SelectedTaskDocuments)
                                            {
                                                <tr>
                                                    <td>@doc.Document?.Title</td>
                                                    <td>
                                                        <span class="badge bg-secondary">
                                                            @L[$"Enum:ProjectTaskDocumentPurpose.{doc.ProjectTaskDocument.DocumentPurpose}"]
                                                        </span>
                                                    </td>
                                                    <td>
                                                        @if (doc.Document != null && DocumentHasPdfFile(doc.Document.Id))
                                                        {
                                                            <Button Color="Color.Info" Size="Size.Small" 
                                                                    Clicked="@(() => OpenPdfViewerModalForDocumentAsync(doc))">
                                                                <Icon Name="IconName.Eye" />
                                                            </Button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </TabPanel>
                    </Content>
                </Tabs>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="CloseTaskDetailModalAsync">
                    @L["Close"]
                </Button>
            </ModalFooter>
        </ModalContent>
    </Modal>

@* ************************* PDF VIEWER MODAL ************************* *@
<Modal @ref="PdfViewerModal" Class="pdf-viewer-modal" Size="ModalSize.ExtraLarge" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@L["DocumentPreview"]</ModalTitle>
            <CloseButton Clicked="ClosePdfViewerModalAsync" />
        </ModalHeader>
        <ModalBody Class="pdf-viewer-modal-body">
            @if (IsPdfFile && !string.IsNullOrEmpty(PdfFileUrl))
            {
                <PdfViewerContainer Height="Height.Rem(35)">
                    <PdfViewerToolbar />
                    <PdfViewer Source="@PdfFileUrl" />
                </PdfViewerContainer>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="ClosePdfViewerModalAsync">
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@* ************************* CREATE PROJECT MODAL ************************* *@
<Modal @ref="CreateProjectModal">
    <ModalContent Size="ModalSize.Large" Centered="true">
        <Form id="CreateProjectForm">
            <ModalHeader>
                <ModalTitle>@L["NewProject"]</ModalTitle>
                <CloseButton Clicked="CloseCreateProjectModalAsync" />
            </ModalHeader>
            <ModalBody>
                @if (!string.IsNullOrWhiteSpace(CreateProjectValidationErrorKey))
                {
                    <Alert Color="Color.Danger">
                        <AlertMessage>@L["NotificationError"]!</AlertMessage>
                        <AlertDescription>@L[CreateProjectValidationErrorKey]</AlertDescription>
                    </Alert>
                }
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Code"] *</FieldLabel>
                            <TextEdit Text="@NewProject.Code"
                                      TextChanged="@((string value) => { NewProject.Code = value; CreateProjectFieldErrors.Remove("Code"); })"
                                      MaxLength="ProjectConsts.CodeMaxLength"
                                      Autofocus="true"
                                      ReadOnly="true"
                                      Style="@(HasCreateProjectFieldError("Code") ? "border-color: #dc3545;" : "")" />
                            @if (HasCreateProjectFieldError("Code"))
                            {
                                <div class="invalid-feedback d-block">@GetCreateProjectFieldError("Code")</div>
                            }
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Name"] *</FieldLabel>
                            <TextEdit Text="@NewProject.Name"
                                      TextChanged="@((string value) => { NewProject.Name = value; CreateProjectFieldErrors.Remove("Name"); })"
                                      MaxLength="ProjectConsts.NameMaxLength"
                                      Style="@(HasCreateProjectFieldError("Name") ? "border-color: #dc3545;" : "")" />
                            @if (HasCreateProjectFieldError("Name"))
                            {
                                <div class="invalid-feedback d-block">@GetCreateProjectFieldError("Name")</div>
                            }
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Description"]</FieldLabel>
                            <MemoEdit @bind-Text="@NewProject.Description" />
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["StartDate"]</FieldLabel>
                            <Addons>
                                <Addon AddonType="AddonType.Body">
                                    <DatePicker TValue="DateTime"
                                                InputMode="DateInputMode.DateTime"
                                                Date="@NewProject.StartDate"
                                                DateChanged="@(v => NewProject.StartDate = v)"
                                                Placeholder="@string.Empty"
                                                DisplayFormat="dd/MM/yyyy HH:mm"
                                                InputFormat="dd/MM/yyyy HH:mm"
                                                @ref="@NewProjectStartDateDatePicker" />
                                </Addon>
                                <Addon AddonType="AddonType.End">
                                    <Button Color="Color.Light" Clicked="@(() => NewProjectStartDateDatePicker?.ToggleAsync())">
                                        <Icon Name="IconName.CalendarDay" />
                                    </Button>
                                </Addon>
                            </Addons>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["EndDate"]</FieldLabel>
                            <Addons>
                                <Addon AddonType="AddonType.Body">
                                    <DatePicker TValue="DateTime"
                                                InputMode="DateInputMode.DateTime"
                                                Date="@NewProject.EndDate"
                                                DateChanged="@(v => NewProject.EndDate = v)"
                                                Placeholder="@string.Empty"
                                                DisplayFormat="dd/MM/yyyy HH:mm"
                                                InputFormat="dd/MM/yyyy HH:mm"
                                                @ref="@NewProjectEndDateDatePicker" />
                                </Addon>
                                <Addon AddonType="AddonType.End">
                                    <Button Color="Color.Light" Clicked="@(() => NewProjectEndDateDatePicker?.ToggleAsync())">
                                        <Icon Name="IconName.CalendarDay" />
                                    </Button>
                                </Addon>
                            </Addons>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Status"] *</FieldLabel>
                            <Select TValue="ProjectStatus"
                                    SelectedValue="@NewProject.Status"
                                    SelectedValueChanged="@((ProjectStatus value) => { NewProject.Status = value; })">
                                <ChildContent>
                                    @foreach (var status in Enum.GetValues<ProjectStatus>())
                                    {
                                        <SelectItem TValue="ProjectStatus" Value="@status">
                                            @L[$"Enum:ProjectStatus.{status}"]
                                        </SelectItem>
                                    }
                                </ChildContent>
                            </Select>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Department"]</FieldLabel>
                            <Select2 IdSelector="c => c.Id.ToString()"
                                    TextSelector="c => c.DisplayName"
                                    FilterFunction="GetDepartmentCollectionLookupAsync"
                                    GetElementById="async (items, id, token) => items.FirstOrDefault(x => x.Id.ToString() == id)!"
                                    Datasource="DepartmentsCollection"
                                    Value="@SelectedDepartment"
                                    OnValueChanged="OnDepartmentIdChanged"
                                    Cache="__MemoryCache"
                                    Multiselect="false" />
                        </Field>
                    </Column>
                </Row>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="CloseCreateProjectModalAsync">
                    @L["Cancel"]
                </Button>
                <Button Color="Color.Primary" 
                        Type="ButtonType.Submit" 
                        PreventDefaultOnSubmit="true"
                        Clicked="CreateProjectAsync"
                        Disabled="@IsCreatingProject">
                    @if (IsCreatingProject)
                    {
                        <RadarSpinner/>
                    }
                    @L["Save"]
                </Button>
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

@* ************************* DOCUMENT PDF VIEWER MODAL ************************* *@
<Modal @ref="DocumentPdfViewerModal" Class="pdf-viewer-modal" Size="ModalSize.ExtraLarge" Centered="true">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@L["DocumentPreview"]</ModalTitle>
            <CloseButton Clicked="CloseDocumentPdfViewerModalAsync" />
        </ModalHeader>
        <ModalBody Class="pdf-viewer-modal-body">
            @if (IsDocumentPdfFile && !string.IsNullOrEmpty(DocumentPdfFileUrl))
            {
                <PdfViewerContainer Height="Height.Rem(35)">
                    <PdfViewerToolbar />
                    <PdfViewer Source="@DocumentPdfFileUrl" />
                </PdfViewerContainer>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CloseDocumentPdfViewerModalAsync">
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<style>
    /* PDF Viewer Modal */
    .pdf-viewer-modal .modal-content {
        position: relative;
        max-height: 90vh;
        overflow: hidden;
    }
    
    .pdf-viewer-modal .modal-body {
        max-height: calc(90vh - 120px);
        overflow: auto;
    }
</style>