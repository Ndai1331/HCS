                                <line id="SvgjsLine1049" x1="0" y1="0" x2="183.33333333333334" y2="0" stroke-dasharray="0" stroke-width="0" stroke-linecap="butt" class="apexcharts-ycrosshairs-hidden"></line> *@
                                </g><g id="SvgjsG1034" class="apexcharts-datalabels-group" transform="translate(0, 0) scale(1)"></g><g id="SvgjsG1035" class="apexcharts-datalabels-group" transform="translate(0, 0) scale(1)"></g></svg>
                            </div>
                        </div>

                        <div class="mt-3">
                            <div class="d-flex align-items-baseline mb-1">
                                <span class="bg-primary me-2 p-1 rounded-circle"></span>
                                <span><span class="text-primary me-2">%40</span> Open</span>
                            </div>

                            <div class="d-flex align-items-baseline mb-1">
                                <span class="bg-success me-2 p-1 rounded-circle"></span>
                                <span><span class="text-success me-2">%30</span> In Progress</span>
                            </div>

                            <div class="d-flex align-items-baseline mb-1">
                                <span class="bg-warning me-2 p-1 rounded-circle"></span>
                                <span><span class="text-warning me-2">%10</span> Waiting for Review</span>
                            </div>

                            <div class="d-flex align-items-baseline mb-1">
                                <span class="bg-brand me-2 p-1 rounded-circle"></span>
                                <span><span class="text-brand me-2">%20</span> Done</span>
                            </div>
                        </div>

                    </CardBody>
                </Card>
            </Column>

        </Row>
    </Column>

    <!-- Calendar -->
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
        <Card Class="w-100 overflow-hidden">
            <CardHeader>
                <Heading Size="HeadingSize.Is4">Calendar</Heading>
                <small class="text-muted d-block">Total 424,567 deliveries</small>
            </CardHeader>

            <CardBody>
                <!-- Tabs -->
                <Tabs SelectedTab="@SelectedDayTab"
                    SelectedTabChanged="@(tab => SelectedDayTab = tab)"
                    Class="mb-3 d-flex justify-content-between">

                    <Items>
                        @foreach (var tab in DayTabs)
                        {
                            <Tab Name="@tab.Key" Style="padding: 0.675rem 1.25rem;">
                                <div class="text-center">
                                    <span class="d-block mb-1 text-muted">@tab.Day</span>
                                    <strong>@tab.Date</strong>
                                </div>
                            </Tab>
                        }
                    </Items>

                    <Content>
                        @foreach (var tab in DayTabs)
                        {
                            <TabPanel Name="@tab.Key">
                                <table class="table mb-0">
                                    <tbody>
                                        @foreach (var ev in EventsByDay[tab.Key])
                                        {
                                            <tr>
                                                <td class="ps-0">
                                                    <div class="d-flex align-items-center">
                                                        <span class="me-2 rounded-3"
                                                            style="width:3px;height:66px;
                                                                    background-color:@(ev.IsBrand ? "var(--bs-primary)" : "var(--bs-secondary)")">
                                                        </span>

                                                        <div>
                                                            <h5 class="mb-1">@ev.Time</h5>
                                                            <h6 class="text-muted fw-normal mb-0">@ev.Title</h6>
                                                            <small class="text-muted">
                                                                Lead by <span class="text-primary">@ev.LeadBy</span>
                                                            </small>
                                                        </div>
                                                    </div>
                                                </td>

                                                <td class="text-end">
                                                    <Button Color="Color.Light" Size="Size.Small">
                                                        View
                                                    </Button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </TabPanel>
                        }
                    </Content>
                </Tabs>
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop" Class="d-flex">
        <Card Class="w-100">

            <CardHeader>
                <Heading Size="HeadingSize.Is4">Documents</Heading>
                <small class="text-muted d-block text-truncate">
                    Card description is here (small, text-muted)
                </small>
            </CardHeader>

            <CardBody>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <tbody>
                            @foreach (var task in Tasks)
                            {
                                <tr>
                                    <td class="ps-0">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-3 me-2 flex-center text-white @task.BgClass"
                                                style="width:36px;height:36px">
                                                <h4 class="mb-0">@task.ShortName</h4>
                                            </div>

                                            <div>
                                                <h6 class="mb-0 text-dark">@task.Name</h6>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="pt-2" style="width:140px">
                                        <div class="progress mt-1">
                                            <div class="progress-bar @task.BgClass"
                                                role="progressbar"
                                                style="width:@($"{task.Progress}%")"
                                                aria-valuenow="@task.Progress"
                                                aria-valuemin="0"
                                                aria-valuemax="100">
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-end pt-2" style="width:50px">
                                        <small class="text-muted">%@(task.Progress)</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </CardBody>

        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop" Class="d-flex">
        <Card Class="w-100">

            <CardHeader>
                <Heading Size="HeadingSize.Is4">Notifications</Heading>
                <small class="text-muted d-block text-truncate">
                    Update 37 minutes ago
                </small>
            </CardHeader>

            <CardBody>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>ITEM</th>
                                <th>BUDGET</th>
                                <th>PROGRESS</th>
                                <th>STATUS</th>
                                <th>VIEW</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var project in Projects)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@project.Avatar"
                                                class="rounded-2 me-2"
                                                style="width:40px"
                                                alt="" />

                                            <div>
                                                <h6 class="mb-0">@project.Name</h6>
                                                <span class="text-muted">@project.Owner</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span>$@project.Budget</span>
                                    </td>

                                    <td>
                                        <div class="badge soft @project.ProgressClass">
                                            %@project.Progress
                                        </div>
                                    </td>

                                    <td>
                                        <div class="badge soft @project.StatusClass">
                                            @project.Status
                                        </div>
                                    </td>

                                    <td>
                                        <Button Color="Color.Dark"
                                                Class="grey px-1 py-0">
                                            <i class="bi bi-arrow-right fs-5"></i>
                                        </Button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </CardBody>

        </Card>
    </Column>
</Row>

@code {
    // Calendar
    private string SelectedDayTab = "fr-20";

    private readonly List<CalendarDayTab> DayTabs = new()
    {
        new("fr-20", "Fr", 20),
        new("sa-20", "Sa", 21),
        new("su-20", "Su", 22),
        new("tu-20", "Tu", 23),
        new("we-20", "We", 24),
        new("th-20", "Th", 25),
        new("fri-20", "Fri", 26),
    };

    private readonly Dictionary<string, List<DayEvent>> EventsByDay = new()
    {
        ["fr-20"] = SampleEvents(),
        ["sa-20"] = SampleEvents(),
        ["su-20"] = SampleEvents(),
        ["tu-20"] = SampleEvents(),
        ["we-20"] = SampleEvents(),
        ["th-20"] = SampleEvents(),
        ["fri-20"] = SampleEvents(),
    };

    private static List<DayEvent> SampleEvents() => new()
    {
        new("10:20 - 11:00 AM", "9 Degree Project Estimation Meeting", "Peter Marcus", true),
        new("13:20 - 14:00 AM", "9 Degree Project Estimation Meeting", "Mark Morris", false),
    };

    record CalendarDayTab(string Key, string Day, int Date);
    record DayEvent(string Time, string Title, string LeadBy, bool IsBrand);

    // Documents
    private List<TaskProgress> Tasks = new()
    {
        new("R", "Research", 50, "bg-success"),
        new("P", "Phase 2.6 QA", 87, "bg-brand"),
        new("U", "UI Design", 32, "bg-primary"),
        new("D", "Development", 44, "bg-secondary"),
        new("P", "Phase 2.6 QA", 87, "bg-brand"),
        new("D", "Development", 44, "bg-secondary"),
    };

    record TaskProgress(
        string ShortName,
        string Name,
        int Progress,
        string BgClass
    );

    // Notifications
    private List<ProjectStat> Projects = new()
    {
        new("Mivy App", "Jane Cooper", "user-01.png", 630, 9.2, "In Process", "bg-success", "bg-primary"),
        new("Avionica", "Davis Kenter", "user-02.png", 630, 4.2, "Pending", "bg-brand", "bg-warning"),
        new("Charto CRM", "Jocelyn Geidt", "user-03.png", 320, 1.2, "In Process", "bg-success", "bg-primary"),
        new("Tower Hill", "Carla Bator", "user-04.png", 420, 9.2, "Completed", "bg-success", "bg-success"),
        new("3 Degree", "Craig Vetrovs", "user-05.png", 560, 0.2, "In Process", "bg-brand", "bg-primary"),
    };

    record ProjectStat(
        string Name,
        string Owner,
        string AvatarFile,
        decimal Budget,
        double Progress,
        string Status,
        string ProgressClass,
        string StatusClass
    )
    {
        public string Avatar => $"https://x.leptontheme.com/assets/img/avatars/{AvatarFile}";
    }
}