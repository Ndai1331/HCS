@page "/"
@using HC.Workflows
@using HC.Projects
@using HC.ProjectTasks
@using HC.CalendarEvents
@using HC.Documents
@using HC.NotificationReceivers
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits HCComponentBase
@inject IWorkflowsAppService WorkflowsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager

<Row>
    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
        <Row>

            @* ===== ACTIVE PROJECTS ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden bg-primary text-white w-100">
                    <CardHeader>
                        <Row>
                            <Column>
                                <Heading Size="HeadingSize.Is4" TextColor="TextColor.White">
                                    Active Projects
                                </Heading>
                                <small class="text-muted">
                                    3 of 4 projects are active now.
                                </small>
                            </Column>
                        </Row>
                    </CardHeader>

                    <CardBody>

                        @* Project item *@
                        <div class="mt-3">
                            <h5 class="mb-1 text-white">Mobile App</h5>
                            <Row class="align-items-center">
                                <Column>
                                    <div class="progress">
                                        <div class="progress-bar bg-brand"
                                             style="width:70%"></div>
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.IsAuto">
                                    <span class="text-muted">%70</span>
                                </Column>
                            </Row>
                        </div>

                        <div class="mt-3">
                            <h5 class="mb-1 text-white">My Book Store</h5>
                            <Row class="align-items-center">
                                <Column>
                                    <div class="progress">
                                        <div class="progress-bar bg-warning"
                                             style="width:52%"></div>
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.IsAuto">
                                    <span class="text-muted">%52</span>
                                </Column>
                            </Row>
                        </div>

                        <div class="mt-3">
                            <h5 class="mb-1 text-white">Questions &amp; Answers</h5>
                            <Row class="align-items-center">
                                <Column>
                                    <div class="progress">
                                        <div class="progress-bar bg-success"
                                             style="width:15%"></div>
                                    </div>
                                </Column>
                                <Column ColumnSize="ColumnSize.IsAuto">
                                    <span class="text-muted">%15</span>
                                </Column>
                            </Row>
                        </div>

                        <Button Color="Color.Light" Class="w-100 mt-4">
                            <Icon Name="IconName.Add" Class="me-1" />
                            Add New Project
                        </Button>

                    </CardBody>
                </Card>
            </Column>

            @* ===== TASKS & ISSUES ===== *@
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card Class="overflow-hidden w-100">
                    <CardHeader>
                        <Heading Size="HeadingSize.Is4">
                            Tasks &amp; Issues
                        </Heading>
                    </CardHeader>

                    <CardBody>

                        @* Chart giữ nguyên *@
                        <div id="chart1" class="d-flex justify-content-center" style="min-height: 187px;">
                            <div id="apexcharts2h82xou5" class="apexcharts-canvas apexcharts2h82xou5 apexcharts-theme-" style="width: 220px; height: 187px;">
