@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div style="position: relative; height: 300px;">
    <canvas id="@ChartId" width="400" height="300"></canvas>
</div>

@code
{
    [Parameter] public string ChartId { get; set; } = Guid.NewGuid().ToString();
    [Parameter] public List<string> Labels { get; set; } = new();
    [Parameter] public List<double> Data { get; set; } = new();
    [Parameter] public List<string> BackgroundColors { get; set; } = new();
    [Parameter] public bool IsDoughnut { get; set; } = false;
    [Parameter] public string? Title { get; set; }

    private IJSObjectReference? _chartModule;
    private IJSObjectReference? _chartInstance;
    private bool _chartRendered = false;
    private int _lastLabelsCount = 0;
    private int _lastDataCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Labels.Count > 0 && Data.Count > 0 && Labels.Count == Data.Count)
        {
            if (_chartInstance == null && !_chartRendered)
            {
                // Wait a bit for the canvas to be rendered in the DOM
                await Task.Delay(200);
                await RenderChart();
                _chartRendered = true;
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Check if data has changed
        if (Labels.Count > 0 && Data.Count > 0 && Labels.Count == Data.Count)
        {
            var labelsChanged = _lastLabelsCount != Labels.Count;
            var dataChanged = _lastDataCount != Data.Count;
            
            _lastLabelsCount = Labels.Count;
            _lastDataCount = Data.Count;

            if (_chartInstance != null && (labelsChanged || dataChanged))
            {
                // Update existing chart
                await Task.Delay(200); // Small delay to ensure DOM is ready
                await UpdateChart();
            }
            else if (_chartInstance == null && !_chartRendered)
            {
                // Trigger render in OnAfterRenderAsync
                _chartRendered = false;
            }
        }
    }

    private async Task RenderChart()
    {
        if (Labels.Count == 0 || Data.Count == 0 || Labels.Count != Data.Count)
        {
            return;
        }

        try
        {
            // Check if canvas exists
            var canvasExists = await JSRuntime.InvokeAsync<bool>("eval", 
                $"document.getElementById('{ChartId}') !== null");
            
            if (!canvasExists)
            {
                // Canvas not ready yet, try again later
                await Task.Delay(200);
                canvasExists = await JSRuntime.InvokeAsync<bool>("eval", 
                    $"document.getElementById('{ChartId}') !== null");
                if (!canvasExists)
                {
                    Console.WriteLine($"Canvas with id {ChartId} not found");
                    return;
                }
            }

            // Load Chart.js and datalabels plugin if needed
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (typeof window.loadChartJs === 'undefined') {
                    window.loadChartJs = function() {
                        return new Promise((resolve, reject) => {
                            if (typeof Chart !== 'undefined' && typeof ChartDataLabels !== 'undefined') {
                                resolve();
                                return;
                            }
                            
                            const loadChart = () => {
                                if (typeof Chart !== 'undefined') {
                                    const script = document.createElement('script');
                                    script.src = 'https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js';
                                    script.onload = () => resolve();
                                    script.onerror = () => reject(new Error('Failed to load Chart.js datalabels plugin'));
                                    document.head.appendChild(script);
                                } else {
                                    const chartScript = document.createElement('script');
                                    chartScript.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
                                    chartScript.onload = () => {
                                        const datalabelsScript = document.createElement('script');
                                        datalabelsScript.src = 'https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js';
                                        datalabelsScript.onload = () => resolve();
                                        datalabelsScript.onerror = () => reject(new Error('Failed to load Chart.js datalabels plugin'));
                                        document.head.appendChild(datalabelsScript);
                                    };
                                    chartScript.onerror = () => reject(new Error('Failed to load Chart.js'));
                                    document.head.appendChild(chartScript);
                                }
                            };
                            
                            loadChart();
                        });
                    };
                }
            ");

            await JSRuntime.InvokeVoidAsync("loadChartJs");

            // Ensure helper functions exist
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (typeof window.createPieChartHelper === 'undefined') {
                    window.createPieChartHelper = function(canvasId, labels, data, colors, isDoughnut, title) {
                        const canvas = document.getElementById(canvasId);
                        if (!canvas) {
                            console.error('Canvas with id ' + canvasId + ' not found');
                            return null;
                        }

                        const ctx = canvas.getContext('2d');
                        const chartType = isDoughnut ? 'doughnut' : 'pie';
                        
                        // Destroy existing chart if exists
                        if (window.chartInstances && window.chartInstances[canvasId]) {
                            window.chartInstances[canvasId].destroy();
                        }
                        
                        if (!window.chartInstances) {
                            window.chartInstances = {};
                        }
                        
                        // Convert hex/rgb colors to rgba with opacity (same as LineChart/BarChart)
                        const convertToRgba = (color, opacity) => {
                            if (color.startsWith('rgba')) {
                                return color.replace(/[\d\.]+\)$/g, opacity + ')');
                            }
                            if (color.startsWith('rgb')) {
                                return color.replace('rgb', 'rgba').replace(')', ', ' + opacity + ')');
                            }
                            // Hex color
                            const hex = color.replace('#', '');
                            const r = parseInt(hex.substring(0, 2), 16);
                            const g = parseInt(hex.substring(2, 4), 16);
                            const b = parseInt(hex.substring(4, 6), 16);
                            return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + opacity + ')';
                        };
                        
                        // Apply opacity to colors (1.0 for background, 1.0 for border)
                        const backgroundColorWithOpacity = colors.map(color => convertToRgba(color, 1.0));
                        const borderColorWithOpacity = colors.map(color => convertToRgba(color, 1));
                        
                        const chart = new Chart(ctx, {
                            type: chartType,
                            data: {
                                labels: labels,
                                datasets: [{
                                    data: data,
                                    backgroundColor: backgroundColorWithOpacity,
                                    borderColor: borderColorWithOpacity,
                                    borderWidth: 2
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: {
                                        position: 'bottom',
                                        labels: {
                                            padding: 15,
                                            usePointStyle: true
                                        }
                                    },
                                    title: {
                                        display: title != null && title !== '',
                                        text: title || '',
                                        position: 'top'
                                    },
                                    tooltip: {
                                        callbacks: {
                                            label: function(context) {
                                                const label = context.label || '';
                                                const value = context.parsed || 0;
                                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                                const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                                return label + ': ' + value + ' (' + percentage + '%)';
                                            }
                                        }
                                    },
                                    datalabels: {
                                        color: '#ffffff',
                                        font: {
                                            weight: 'bold',
                                            size: 12
                                        },
                                        formatter: function(value, context) {
                                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                                            return percentage + '%';
                                        }
                                    }
                                }
                            },
                            plugins: typeof ChartDataLabels !== 'undefined' ? [ChartDataLabels] : []
                        });
                        
                        window.chartInstances[canvasId] = chart;
                        return chart;
                    };
                    
                    window.updatePieChartHelper = function(canvasId, labels, data, colors) {
                        if (window.chartInstances && window.chartInstances[canvasId]) {
                            const chart = window.chartInstances[canvasId];
                            
                            // Convert hex/rgb colors to rgba with opacity (same as LineChart/BarChart)
                            const convertToRgba = (color, opacity) => {
                                if (color.startsWith('rgba')) {
                                    return color.replace(/[\d\.]+\)$/g, opacity + ')');
                                }
                                if (color.startsWith('rgb')) {
                                    return color.replace('rgb', 'rgba').replace(')', ', ' + opacity + ')');
                                }
                                // Hex color
                                const hex = color.replace('#', '');
                                const r = parseInt(hex.substring(0, 2), 16);
                                const g = parseInt(hex.substring(2, 4), 16);
                                const b = parseInt(hex.substring(4, 6), 16);
                                return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + opacity + ')';
                            };
                            
                            // Apply opacity to colors (1.0 for background, 1.0 for border)
                            const backgroundColorWithOpacity = colors.map(color => convertToRgba(color, 1.0));
                            const borderColorWithOpacity = colors.map(color => convertToRgba(color, 1));
                            
                            chart.data.labels = labels;
                            chart.data.datasets[0].data = data;
                            chart.data.datasets[0].backgroundColor = backgroundColorWithOpacity;
                            chart.data.datasets[0].borderColor = borderColorWithOpacity;
                            chart.update();
                        }
                    };
                    
                    window.destroyChartHelper = function(canvasId) {
                        if (window.chartInstances && window.chartInstances[canvasId]) {
                            window.chartInstances[canvasId].destroy();
                            delete window.chartInstances[canvasId];
                        }
                    };
                }
            ");

            var defaultColors = new List<string>
            {
                "#3498db", "#2ecc71", "#e74c3c", "#f39c12", "#9b59b6",
                "#1abc9c", "#34495e", "#e67e22", "#95a5a6", "#16a085"
            };

            var colors = BackgroundColors.Count > 0 ? BackgroundColors : defaultColors.Take(Labels.Count).ToList();

            await JSRuntime.InvokeVoidAsync("createPieChartHelper",
                ChartId,
                Labels.ToArray(),
                Data.ToArray(),
                colors.ToArray(),
                IsDoughnut,
                Title);
            
            _chartRendered = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering chart: {ex.Message}");
            _chartRendered = false;
        }
    }

    private async Task UpdateChart()
    {
        if (Labels.Count == 0 || Data.Count == 0 || Labels.Count != Data.Count)
        {
            return;
        }

        try
        {
            var defaultColors = new List<string>
            {
                "#3498db", "#2ecc71", "#e74c3c", "#f39c12", "#9b59b6",
                "#1abc9c", "#34495e", "#e67e22", "#95a5a6", "#16a085"
            };

            var colors = BackgroundColors.Count > 0 ? BackgroundColors : defaultColors.Take(Labels.Count).ToList();

            await JSRuntime.InvokeVoidAsync("updatePieChartHelper",
                ChartId,
                Labels.ToArray(),
                Data.ToArray(),
                colors.ToArray());
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating chart: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyChartHelper", ChartId);
        }
        catch (JSDisconnectedException)
        {
            // Ignore if JS is disconnected
        }
        catch (Exception)
        {
            // Ignore other errors during disposal
        }
    }
}

