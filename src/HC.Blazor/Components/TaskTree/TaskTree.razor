@using HC.ProjectTasks
@inject Microsoft.Extensions.Logging.ILogger<TaskTree> Logger

<DataGrid TItem="ProjectTaskWithNavigationPropertiesDto"
        Data="@Tasks"
        ShowPager="false"
        Responsive="true"
        Class="@("child-tasks-grid " + (Level == 0 ? "" : $"level-{Level}"))"
        DetailRowTrigger="@DetailRowTriggerHandler">
    <LoadingTemplate>
        <Row Class="w-100 align-items-center" Style="height: 90px;">
            <Column>
                <RadarSpinner />
            </Column>
        </Row>
    </LoadingTemplate>
    <DataGridColumns>
        @if (Level == 0)
        {
            @* Expand/Collapse column for root level *@
            <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto"
                            Field="ProjectTask.Id"
                            Width="0.5rem">
                <DisplayTemplate Context="task">
                    @if (GetChildTaskCount(task) > 0)
                    {
                        @if (IsTaskExpanded(task))
                        {
                            <i class="fas fa-chevron-up" @onclick="@(async () => await ToggleTaskDetails(task))" style="cursor: pointer;" />
                        }
                        else
                        {
                            <i class="fas fa-chevron-down" @onclick="@(async () => await ToggleTaskDetails(task))" style="cursor: pointer;" />
                        }
                    }
                </DisplayTemplate>
            </DataGridColumn>
        }
        else
        {
            @* Indentation for nested levels *@
            <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Width="@($"{Level * 20}px")">
                <DisplayTemplate></DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto"
                            Field="ProjectTask.Id"
                            Width="0.5rem">
                <DisplayTemplate Context="task">
                    @if (GetChildTaskCount(task) > 0)
                    {
                        @if (IsTaskExpanded(task))
                        {
                            <i class="fas fa-chevron-up" @onclick="@(async () => await ToggleTaskDetails(task))" style="cursor: pointer;" />
                        }
                        else
                        {
                            <i class="fas fa-chevron-down" @onclick="@(async () => await ToggleTaskDetails(task))" style="cursor: pointer;" />
                        }
                    }
                </DisplayTemplate>
            </DataGridColumn>
        }

        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Code" Caption="@CodeCaption">
            <DisplayTemplate Context="task">
                <a target="_blank" href="@GetTaskDetailUrl(task)">
                    <span>#@GetTaskCode(task)</span>
                </a>
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Title" Caption="@TitleCaption">
            <DisplayTemplate Context="task">
                @* @if (Level > 0 && !string.IsNullOrWhiteSpace(GetTaskParentTaskId(task)))
                {
                    <div class="text-muted">
                        @ParentTaskTitleLabel: #@GetTaskParentTaskId(task) - @GetParentTaskTitle(task)
                    </div>
                } *@
                <div class="d-flex align-items-center gap-2">
                    <span>@GetTaskTitle(task)</span>
                    @if (GetChildTaskCount(task) > 0)
                    {
                        <span class="text-muted">
                            <i aria-hidden="true" class="fa fa-list me-1"></i>@GetChildTaskCount(task)
                        </span>
                    }
                </div>
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.StartDate" Caption="@StartDateCaption">
            <DisplayTemplate Context="task">
                @GetTaskStartDate(task).ToString("dd/MM/yyyy HH:mm")
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.DueDate" Caption="@DueDateCaption">
            <DisplayTemplate Context="task">
                @GetTaskDueDate(task).ToString("dd/MM/yyyy HH:mm")
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Status" Caption="@StatusCaption">
            <DisplayTemplate Context="task">
                <Badge Color="@GetStatusBadgeColor(GetTaskStatus(task))">
                    <span class="text-white">@GetStatusText(GetTaskStatus(task))</span>
                </Badge>
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Priority" Caption="@PriorityCaption">
            <DisplayTemplate Context="task">
                <Badge Color="@GetPriorityBadgeColor(GetTaskPriority(task))">
                    <span class="text-white">@GetPriorityText(GetTaskPriority(task))</span>
                </Badge>
            </DisplayTemplate>
        </DataGridColumn>
        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.ProgressPercent" Caption="@ProgressPercentCaption">
            <DisplayTemplate Context="task">
                <div class="d-flex align-items-center gap-2">
                    <Progress Value="@GetTaskProgressPercent(task)" Max="100" Class="hc-progress" />
                    <span class="text-muted small">@GetTaskProgressPercent(task)%</span>
                </div>
            </DisplayTemplate>
        </DataGridColumn>
    </DataGridColumns>

    <DetailRowTemplate Context="task">
        @if (GetChildTaskCount(task) > 0 && IsTaskExpanded(task))
        {
            var childTasks = GetChildTasksForTask(task);
            if (childTasks != null && childTasks.Count > 0)
            {
                <div class="bg-light rounded p-3 pb-2">
                    @* Recursive call to render child tasks *@
                    <TaskTree Tasks="@childTasks"
                             Level="@(Level + 1)"
                             ChildTasksByParentCode="@ChildTasksByParentCode"
                             ExpandedTasks="@ExpandedTasks"
                             OnTaskExpanded="@HandleTaskExpanded"
                             GetChildTaskCount="@GetChildTaskCount"
                             GetChildTasksForTask="@GetChildTasksForTask"
                             GetTaskCode="@GetTaskCode"
                             GetTaskTitle="@GetTaskTitle"
                             GetTaskStartDate="@GetTaskStartDate"
                             GetTaskDueDate="@GetTaskDueDate"
                             GetTaskStatus="@GetTaskStatus"
                             GetTaskPriority="@GetTaskPriority"
                             GetTaskProgressPercent="@GetTaskProgressPercent"
                             GetTaskDetailUrl="@GetTaskDetailUrl"
                             GetTaskParentTaskId="@GetTaskParentTaskId"
                             GetParentTaskTitle="@GetParentTaskTitle"
                             CodeCaption="@CodeCaption"
                             TitleCaption="@TitleCaption"
                             StartDateCaption="@StartDateCaption"
                             DueDateCaption="@DueDateCaption"
                             StatusCaption="@StatusCaption"
                             PriorityCaption="@PriorityCaption"
                             ProgressPercentCaption="@ProgressPercentCaption"
                             ParentTaskTitleLabel="@ParentTaskTitleLabel"
                             GetStatusBadgeColor="@GetStatusBadgeColor"
                             GetPriorityBadgeColor="@GetPriorityBadgeColor"
                             GetStatusText="@GetStatusText"
                             GetPriorityText="@GetPriorityText" />
                </div>
            }
        }
    </DetailRowTemplate>
</DataGrid>

<style>
    .hc-progress {
        width: 140px;
        height: 8px;
    }
    
    @@media (max-width: 576px) {
        .hc-progress {
            width: 100px;
        }
    }
</style>