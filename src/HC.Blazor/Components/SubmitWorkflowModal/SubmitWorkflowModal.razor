@using HC.Documents
@using HC.DocumentWorkflowInstances
@using HC.Blazor.Pages
@using Excubo.Blazor.TreeViews
@using HC.Blazor.Components.Select2
@using HC.Shared
@using Blazorise
@using Blazorise.Components
@using Blazorise.RichTextEdit
@using Volo.Abp.Application.Dtos

@inherits HCComponentBase

<Modal @ref="ModalRef" Closing="@ModalRef.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>@L["CreateSigning"]</ModalTitle>
            <CloseButton Clicked="CloseModalAsync" />
        </ModalHeader>
        <ModalBody Style="position: relative; min-height: 320px;">
            <div class="@(IsModalBusy ? "pe-none user-select-none" : null)" style="@(IsModalBusy ? "opacity: 0.55;" : null)">
            @* Pre-selected document info (when opened from Documents page) *@
            @if (HasPreSelectedDocument && PreSelectedDocument != null)
            {
                <Alert Color="Color.Info" Visible="true" Class="mb-3">
                    <AlertMessage>
                        <i class="bi bi-file-earmark-text me-1"></i>@L["Document"]:
                    </AlertMessage>
                    <AlertDescription>
                        @PreSelectedDocument.Document.Title - #@PreSelectedDocument.Document.No (@PreSelectedDocument.Document.StorageNumber)
                    </AlertDescription>
                </Alert>
            }

            @* Step 1: Select Workflow *@
            <Field>
                <FieldLabel>@L["SelectWorkflow"] <span class="text-danger">*</span></FieldLabel>
                <div class="hc-select2-full">
                    <Select2 IdSelector="c => c.Id.ToString()"
                             TextSelector="c => c.DisplayName"
                             FilterFunction="GetWorkflowCollectionLookupAsync"
                             GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                             Datasource="WorkflowsCollection"
                             Value="@SelectedWorkflow"
                             OnValueChanged="@OnWorkflowSelect2ChangedAsync"
                             Cache="__MemoryCache"
                             Multiselect="false"
                             Disabled="@IsModalBusy" />
                </div>
            </Field>

            @* Step 2: Template file option (only when NOT pre-selected and workflow has template) *@
            @if (!HasPreSelectedDocument && WorkflowSubmitInfo != null && WorkflowSubmitInfo.HasTemplateFile && !string.IsNullOrWhiteSpace(GetWorkflowTemplateFilePath(WorkflowSubmitInfo)))
            {
                <Card Class="mt-2 mb-2 border-info">
                    <CardBody>
                        <div class="d-flex align-items-center">
                            <Check TValue="bool"
                                Checked="@UseWorkflowTemplateFile"
                                CheckedChanged="@OnUseWorkflowTemplateFileChanged"
                                Class="me-2">
                                <ChildContent>@L["UseWorkflowTemplateFile"]</ChildContent>
                            </Check>
                        </div>
                        <div class="mt-2 p-2 bg-light rounded">
                            <small class="text-muted">@L["WorkflowTemplateFile"]:</small>
                            <div class="d-flex align-items-center mt-1">
                                <Icon Name="IconName.File" Class="me-2 text-primary" />
                                <span class="fw-bold">@GetWorkflowTemplateFileName(WorkflowSubmitInfo)</span>
                            </div>
                            <small class="text-muted d-block mt-1">@GetWorkflowTemplateFilePath(WorkflowSubmitInfo)</small>
                        </div>
                    </CardBody>
                </Card>
            }

            @* Step 3: Select Document (only when NOT pre-selected and NOT using template file) *@
            @if (!HasPreSelectedDocument && !UseWorkflowTemplateFile)
            {
                <Field Class="mt-2">
                    <FieldLabel>
                        @if (WorkflowSubmitInfo != null && WorkflowSubmitInfo.HasTemplateFile)
                        {
                            @L["OrSelectFromMyDocuments"]
                        }
                        else
                        {
                            @L["SelectDocument"]
                        }
                        <span class="text-danger">*</span>
                    </FieldLabel>
                    <Autocomplete @key="ModalResetKey"
                        TItem="DocumentWithNavigationPropertiesDto"
                        TValue="Guid?"
                        Data="@MyDocumentsList"
                        TextField="@(item => $"{item.Document.StorageNumber} - {item.Document.Title}")"
                        ValueField="@(item => (Guid?)item.Document.Id)"
                        SelectedValue="@SelectedDocumentId"
                        SelectedValueChanged="@OnDocumentSelectedAsync"
                        Placeholder="@L["SearchByTitleOrNumber"]"
                        FreeTyping
                        MinLength="0"
                        Filter="AutocompleteFilter.Contains">
                    </Autocomplete>
                </Field>

                @if (SelectedDocumentId.HasValue && SelectedDocumentDto != null)
                {
                    <Alert Color="Color.Info" Visible="true" Class="mb-0">
                        <AlertMessage>
                            <i class="bi bi-file-earmark-text me-1"></i>@L["Document"]:
                        </AlertMessage>
                        <AlertDescription>
                            @SelectedDocumentDto.Document.Title - #@SelectedDocumentDto.Document.No (@SelectedDocumentDto.Document.StorageNumber)
                        </AlertDescription>
                    </Alert>
                }
            }

            @* Step 4: Workflow steps info *@
            @if (WorkflowSubmitInfo != null)
            {
                <Card>
                    <CardHeader>
                        <strong>@L["WorkflowSteps"]</strong> - @WorkflowSubmitInfo.WorkflowName
                    </CardHeader>
                    <CardBody>
                        @foreach (var step in WorkflowSubmitInfo.Steps)
                        {
                            <div class="d-flex align-items-start mb-1 p-2 border rounded">
                                <div class="me-3">
                                    <Badge Color="Color.Primary" Pill>@step.Order</Badge>
                                </div>
                                <div class="flex-grow-1">
                                    <strong>@step.Name</strong>
                                    <small class="text-muted ms-2">(@L[step.Type])</small>
                                    @if (step.SLADays.HasValue)
                                    {
                                        <small class="text-warning ms-2">
                                            <i class="bi bi-clock"></i> @step.SLADays @L["Days"]
                                        </small>
                                    }
                                    @if (!step.CandidateUsers.Any())
                                    {
                                        <div class="mt-1">
                                            <small class="text-danger">@L["NoWorkflowAssigneeCandidatesFound"]</small>
                                        </div>
                                    }
                                    else if (step.IsViewStep)
                                    {
                                        var viewEditor = ViewStepScopeEditors.FirstOrDefault(e => e.StepId == step.StepId);
                                        if (viewEditor != null)
                                        {
                                            <div class="mt-2">
                                                <small class="text-muted d-block mb-1">@L["ViewStepScopeSelectionHint"]</small>
                                                <FieldLabel>@L["OrganizationUnit"]</FieldLabel>
                                                @if (ViewStepDepartmentTreeViews.Any())
                                                {
                                                    <TreeView Items="ViewStepDepartmentTreeViews"
                                                              GetChildren="@(item => item.Children)"
                                                              HasChildren="@(item => item.HasChildren)"
                                                              AllowSelection="true"
                                                              @bind-SelectedItems="viewEditor.SelectedDepartments" />
                                                }
                                                <FieldLabel class="mt-2">@L["IdentityUser"]</FieldLabel>
                                                <div class="hc-select2-full">
                                                    <UserSelect2 FilterFunction="GetIdentityUserCollectionLookupAsync"
                                                                 GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                                                 Datasource="IdentityUsersCollection"
                                                                 Value="@viewEditor.SelectedUsers"
                                                                 ValueChanged="@(async (List<LookupDto<Guid>> v) => { viewEditor.SelectedUsers = v ?? new(); await InvokeAsync(StateHasChanged); })"
                                                                 Cache="__MemoryCache"
                                                                 Multiselect="true" />
                                                </div>
                                            </div>
                                        }
                                    }
                                    else if (step.RequiresSignerSelection)
                                    {
                                        <div class="mt-2">
                                            @if (!string.IsNullOrWhiteSpace(step.RoleName))
                                            {
                                                <small class="text-muted d-block mb-1">@L["Role"]: @step.RoleName</small>
                                            }
                                            <FieldLabel>@L["SelectWorkflowSigner"] *</FieldLabel>
                                            <Select TValue="Guid?" SelectedValue="@(StepSignerSelections.TryGetValue(step.StepId, out var sel) ? sel : null)" SelectedValueChanged="@(v => OnSignerSelectionChanged(step.StepId, v))">
                                                <SelectItem TValue="Guid?" Value="@((Guid?)null)">@L["PleaseSelect"]</SelectItem>
                                                @foreach (var user in step.CandidateUsers)
                                                {
                                                    <SelectItem TValue="Guid?" Value="@user.UserId">@GetCandidateDisplayLabel(user)</SelectItem>
                                                }
                                            </Select>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="mt-1">
                                            @{
                                                var single = step.CandidateUsers.First();
                                            }
                                            <small class="badge bg-light text-dark me-1">
                                                <i class="bi bi-person"></i>
                                                @GetCandidateDisplayLabel(single)
                                                @if (single.IsPrimary)
                                                {
                                                    <i class="bi bi-star-fill text-warning ms-1"></i>
                                                }
                                            </small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </CardBody>
                </Card>
            }

            @* Signing Content (required when source file is .doc/.docx) *@
            @if (RequireSigningContent)
            {
                <Field>
                    <FieldLabel>@L["SigningContent"] <span class="text-danger">*</span></FieldLabel>
                    <RichTextEdit @ref="SigningContentEditorRef"
                                  @key="ModalResetKey"
                                  @bind-Value="@SigningContent"
                                  Theme="RichTextEditTheme.Snow"
                                  PlaceHolder="@L["EnterSigningContent"]"
                                  ToolbarPosition="Placement.Bottom">
                        <Toolbar>
                            <RichTextEditToolbarGroup>
                                <RichTextEditToolbarButton Action="RichTextEditAction.Bold" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Italic" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Underline" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Strike" />
                            </RichTextEditToolbarGroup>
                            <RichTextEditToolbarGroup>
                                <RichTextEditToolbarButton Action="RichTextEditAction.List" Value="ordered" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.List" Value="bullet" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Link" />
                                <RichTextEditToolbarButton Action="RichTextEditAction.Clean" />
                            </RichTextEditToolbarGroup>
                            <RichTextEditToolbarGroup>
                                <RichTextEditToolbarButton Action="RichTextEditAction.Table" />
                            </RichTextEditToolbarGroup>
                        </Toolbar>
                    </RichTextEdit>
                </Field>
            }

            @* Attach Files *@
            <Field Class="mt-2">
                <FieldLabel>@L["AttachFiles"]</FieldLabel>
                <FilePicker @ref="WorkflowFilePicker"
                    Multiple
                    Upload="OnFileUpload"
                    ShowMode="FilePickerShowMode.List"
                    MaxFileSize="52428800"
                    FilePickerLocalizer="FilePickerHelper.FilePickerLocalizer">
                </FilePicker>
                @if (UploadedFiles.Any())
                {
                    <div class="mt-2">
                        @foreach (var file in UploadedFiles)
                        {
                            <Alert Color="Color.Success" Dismissible="false" Class="mb-1 py-1 px-2">
                                <small><Icon Name="IconName.CheckCircle" Class="me-1" />@file.Name</small>
                            </Alert>
                        }
                    </div>
                }
            </Field>
            </div>
            @if (IsModalBusy)
            {
                <div class="d-flex align-items-center justify-content-center"
                     style="position: absolute; inset: 0; z-index: 10; background: rgba(255, 255, 255, 0.94);">
                    <RadarSpinner />
                </div>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CloseModalAsync" Disabled="@IsModalBusy">@L["Cancel"]</Button>
            <Button Color="Color.Primary" Clicked="ConfirmSubmitAsync"
                    Disabled="@(IsModalBusy || (!UseWorkflowTemplateFile && !SelectedDocumentId.HasValue) || !SelectedWorkflowId.HasValue || WorkflowSubmitInfo == null)">
                <Icon Name="IconName.Check" Class="me-1" />@L["Submit"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>
