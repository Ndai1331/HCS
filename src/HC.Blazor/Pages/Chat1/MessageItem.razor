@using HC.Chat
@using HC.Chat.Messages
@using HC.Chat.Conversations
@using HC.Chat.Users
@using HC.Localization
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.Timing
@using Volo.Abp.Localization
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inherits HCComponentBase


<div class="chat-row d-flex mb-2
     @(Message.Side == ChatMessageSide.Sender ? "" : "justify-content-start")">

    <div class="chat-item d-flex align-items-start
         @(Message.Side == ChatMessageSide.Sender ? "sender flex-row-reverse" : "")">

        @* Avatar *@
        @if (Message.Side == ChatMessageSide.Receiver && Message.SenderUserId.HasValue)
        {
            <canvas id="sender-avatar-@Message.Id"
                    width="32"
                    height="32"
                    class="me-2 rounded-circle"></canvas>
        }

        <div class="message-wrapper">

            @* Sender name (group chat) *@
            @if (Message.Side == ChatMessageSide.Receiver
            && CurrentChatContact?.Type != ConversationType.User
            && Message.SenderUserId.HasValue)
            {
                <small class="text-muted fw-bold d-block mb-1">
                    @GetSenderName(Message)
                </small>
            }

            @* Forward preview *@
            @if (Message.ForwardedFromMessage != null)
            {
                <div class="forward-box mb-1">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-forward-fill forward-icon me-2"></i>
                        <div class="flex-grow-1">
                            <small class="forward-title d-block">
                                @L["ForwardedFrom"]:
                                @if (!string.IsNullOrWhiteSpace(Message.ForwardedFromMessage.SenderName))
                                {
                                    <span>
                                        @Message.ForwardedFromMessage.SenderName
                                        @Message.ForwardedFromMessage.SenderSurname
                                    </span>
                                }
                                else if (!string.IsNullOrWhiteSpace(Message.ForwardedFromMessage.SenderUsername))
                                {
                                    <span>@Message.ForwardedFromMessage.SenderUsername</span>
                                }
                            </small>
                            <small class="forward-text d-block">
                                @Message.ForwardedFromMessage.Message.TruncateWithPostfix(50, "…")
                            </small>
                        </div>
                    </div>
                </div>
            }

            @* 🔥 MESSAGE CONTENT (bubble + date) *@
            <div class="message-content">

                <div class="@GetMessageBoxClass() message-bubble px-2 py-1 shadow-sm">

                    @if (Message.IsSending)
                    {
                        <span class="spinner-border spinner-border-sm position-absolute top-0 end-0 m-1"></span>
                    }
                    <p class="mb-0 message-text">@Message.Message</p>
                    @if (Message.Files?.Any() == true)
                    {
                        <div class="mt-2 message-file-items">
                            @foreach (var file in Message.Files)
                            {
                                @if (file.IsImage)
                                {
                                    <img src="@GetImageUrl(file.FilePath)"
                                         class="chat-image"
                                         @onclick="() => OnOpenImageViewerAsync(file)" />
                                }
                                else
                                {
                                    <div class="file-item d-flex align-items-center">
                                        <i class="bi bi-file-earmark-text me-2"></i>
                                        <small class="text-truncate flex-grow-1">@file.FileName</small>
                                        <button class="btn btn-sm"
                                                @onclick="() => OnDownloadFileAsync(file.Id)">
                                            <i class="bi bi-download"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @if (Message.IsPinned)
                    {
                        <small class="d-block mt-1">
                            <i class="bi bi-pin-fill text-warning"></i> @L["Pinned"]
                        </small>
                    }
                </div>

                <small class="text-muted message-date">
                    @Clock.ConvertToUserTime(Message.MessageDate)
                </small>
            </div>
        </div>

        @* Dropdown *@
        <div class="dropdown chat-actions">
            <button class="btn p-1" type="button" data-bs-toggle="dropdown">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" @onclick="OnReplyAsync">
                        <i class="bi bi-reply mx-1"></i> @L["Reply"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" @onclick="OnTogglePinAsync">
                        @if (Message.IsPinned)
                        {
                            <i class="bi bi-pin-angle mx-1"></i> @L["UnpinMessage"]
                        }
                        else
                        {
                            <i class="bi bi-pin-fill mx-1"></i> @L["PinMessage"]
                        }
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" @onclick="OnForwardAsync">
                        <i class="bi bi-arrow-up-right mx-1"></i> @L["Forward"]
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" @onclick="OnCreateTaskAsync">
                        <i class="bi bi-plus-circle mx-1"></i> @L["CreateTask"]
                    </a>
                </li>
                @if (IsDeletingEnabled)
                {
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" @onclick="OnDeleteAsync">
                            <i class="bi bi-trash mx-1"></i> @L["Delete"]
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<style>
.chat-row {
    width: 100%;
}

.chat-item {
    display: flex;
    align-items: flex-start;
    gap: 6px;

    max-width: 75%;
    width: fit-content;
}

/* Sender luôn bám phải */
.chat-item.sender {
    margin-left: auto;
}

.message-content {
    width: 100%;
    display: flex;
    flex-direction: column;
}

.message-bubble {
    max-width: 100%;
    min-width: 120px;
    padding: 8px 12px;
    border-radius: 12px;

    white-space: pre-line;
    word-break: break-word;
}

.message-date {
    align-self: flex-end;
    white-space: nowrap;
    opacity: 0.4;
}


.message-file-items
{
    background: white;
    border-radius: 4px;
    padding: 4px;
    transition: background-color 0.2s;
}


.lpx-theme-dark .bg-danger-subtle{
    background-color: #fff !important;
}
</style>

@code {
    [Inject] public IConversationAppService ConversationAppService { get; set; }
    [Inject] public IClock Clock { get; set; }

    [Parameter] public ChatMessageDto Message { get; set; }
    [Parameter] public ChatContactDto CurrentChatContact { get; set; }

    [Parameter] public EventCallback<ChatMessageDto> OnReply { get; set; }
    [Parameter] public EventCallback<ChatMessageDto> OnTogglePin { get; set; }
    [Parameter] public EventCallback<ChatMessageDto> OnForward { get; set; }
    [Parameter] public EventCallback<ChatMessageDto> OnCreateTask { get; set; }
    [Parameter] public EventCallback<ChatMessageDto> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnDownloadFile { get; set; }
    [Parameter] public bool IsDeletingEnabled { get; set; }
    [Parameter] public Func<string, string> GetImageUrl { get; set; } = null!;
    [Parameter] public EventCallback<MessageFileDto> OnOpenImageViewer { get; set; }

    private string GetSenderName(ChatMessageDto m)
        => !string.IsNullOrEmpty(m.SenderName) || !string.IsNullOrEmpty(m.SenderSurname)
            ? $"{m.SenderName} {m.SenderSurname}".Trim()
            : m.SenderUsername ?? "Unknown";

    private string GetMessageBoxClass()
        => Message.Side == ChatMessageSide.Sender
            ? "bg-primary text-white rounded"
            : "bg-danger-subtle text-black rounded";

    private async Task OnReplyAsync() => await OnReply.InvokeAsync(Message);
    private async Task OnTogglePinAsync() => await OnTogglePin.InvokeAsync(Message);
    private async Task OnForwardAsync() => await OnForward.InvokeAsync(Message);
    private async Task OnCreateTaskAsync() => await OnCreateTask.InvokeAsync(Message);
    private async Task OnDeleteAsync() => await OnDelete.InvokeAsync(Message);
    private async Task OnDownloadFileAsync(Guid id) => await OnDownloadFile.InvokeAsync(id);

    private async Task OnOpenImageViewerAsync(MessageFileDto file)
        => await OnOpenImageViewer.InvokeAsync(file);
}
