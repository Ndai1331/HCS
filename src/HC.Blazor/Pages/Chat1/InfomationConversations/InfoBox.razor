
@using HC.Localization
@using Volo.Abp.AspNetCore.Components.BlockUi
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Progression
@using Volo.Abp.Features
@using Volo.Abp.Timing
@using HC.Chat
@using HC.Chat.Authorization
@using HC.Chat.Conversations
@using HC.Chat.Messages
@using Volo.Abp.AspNetCore.Components.Web
@using HC.Shared
@using HC.Projects
@using HC.ProjectTasks
@using HC.ProjectMembers
@using HC.ProjectTaskAssignments
@using Microsoft.Extensions.Caching.Memory
@using HC.Chat.Users
@using Volo.Abp.BlazoriseUI
@using Blazorise

@attribute [Authorize(ChatPermissions.Messaging)]
@attribute [RequiresFeature(ChatFeatures.Enable)]
@inherits HCComponentBase
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IClock Clock
@inject IMemoryCache __MemoryCache
@inject IProjectsAppService ProjectsAppService
@inject IProjectTasksAppService ProjectTasksAppService
@inject IProjectMembersAppService ProjectMembersAppService
@inject IUiMessageService UiMessageService
@inject IBlockUiService BlockUiService

<style> 

    

.select2-dropdown {
    z-index: 9999999 !important;
}

.select2-container--default
.select2-selection--single {
    --tw-bg-opacity: 1;
    background-color: rgb(249 251 253 / var(--tw-bg-opacity)) !important;
    height: 40px !important;
    min-width: 150px;
    background-color: #f0f4f7 !important;
    border-radius: 0.5rem !important;
    border-color: #e8eef3 !important;
}

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        line-height: 38px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 35px !important;
    }

.select2-selection--single {
    border: 1px solid #323a461a !important;
}

.select2-selection__rendered {
    border-radius: 4px !important;
}

.select2-selection__arrow {
    border-radius: 4px !important;
}

.select2-disabled .select2-selection {
    pointer-events: none;
    opacity: 0.75;
}

.select2-disabled .select2-selection > span {
    background-color: inherit !important;
}

    .accordion-button,
    .accordion-body{
        padding:12px 6px !important;
        hover: background-color: #f8f9fa !important;
        &:hover {
            background-color: #f8f9fa !important;

        }
    }

    .accordion-button::after{
        background-size:16px !important; 
    }

    .accordion-item {
        border:none !important;
    }


    .hover-bg-brand-light
    {
        &:hover {
            background-color: #f72585 !important;
            color: #fff !important;

        }
    }
</style>


<Column Size="ColumnSize.Is12.OnMobile.Is3.OnDesktop" class="col-12 col-md-3 d-flex align-items-stretch">
    <Card Class="w-100 mb-3 mb-md-0" Style="height: 100vh; display: flex; flex-direction: column;">
        <CardBody Class="p-2" Style="display: flex; flex-direction: column; overflow: hidden;">
            @{
                var activeDiv = ShowDivs.FirstOrDefault(x => x.Value).Key;
            }

            @switch (activeDiv)
            {
                case "Infobox":
                    <Div Class="mt-1 mb-2 d-flex justify-content-center">
                    @if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.User)
                    {
                        <canvas @ref="CanvasElementReferences[CurrentChatContact]" class="canvas-avatar mx-auto rounded-circle" Width="30" Height="30"></canvas>
                    }
                    else if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.Group)
                    {
                        <a href="javascript:void(0)" 
                            Class="bg-light border border-2 rounded-circle d-flex justify-content-center align-items-center text-decoration-none" 
                            Style="width: 30px; height: 30px">
                            <i class="bi bi-people-fill fs-4 text-primary"></i>
                        </a>
                    }
                    else if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.Project)
                    {
                        <a href="javascript:void(0)" 
                            Class="bg-light border border-2 rounded-circle d-flex justify-content-center align-items-center text-decoration-none" 
                            Style="width: 30px; height: 30px">
                            <i class="bi bi-folder-fill fs-4 text-success"></i>
                        </a>
                    }
                    else if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.Task)
                    {
                        <a href="javascript:void(0)" 
                            Class="bg-light border border-2 rounded-circle d-flex justify-content-center align-items-center text-decoration-none" 
                            Style="width: 30px; height: 30px">
                            <i class="bi bi-check2-square fs-4 text-warning"></i>
                        </a>
                    }
                </Div>
                <Div Class="mb-2 text-center">
                    <Heading Size="HeadingSize.Is5" Class="text-brand">
                        @if (CurrentChatContact != null)
                        {
                            @if (CurrentChatContact.Type == ConversationType.User)
                            {
                                @(GetName(CurrentChatContact))
                            }else{
                                @(CurrentChatContact.ConversationName ?? GetName(CurrentChatContact))
                            }
                        }
                    </Heading>  
                </Div>

                <Div Class="mb-2  d-flex justify-content-center align-items-center">
                    @if(CurrentChatContact.Type != ConversationType.User)
                    {
                        <Div Class="mx-2 mb-2 text-center">
                            <div class="d-inline-block bg-light px-1 rounded-4 text-black-50
                            hover-bg-brand-light
                            "
                            @onclick="async () => await ShowModalAddMembersAsync(CurrentChatContact.ConversationId.Value)">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>
                            <span class="d-block">@L["AddMember"]</span>    
                        </Div>
                    }
                    <Div Class="mx-2 mb-2 text-center">
                        <div class="d-inline-block bg-light px-1 rounded-4 text-black-50 hover-bg-brand-light" 
                        
                        @onclick="async () => await FindMessageAsync()">
                        <i class="bi bi-search fs-4"></i>
                        </div>
                        <span class="d-block">@L["FindMessage"]</span>
                    </Div>
                </Div>
                
                <Accordion >
                    <AccordionItem @bind-Visible="@AccordionChatInfoVisible">
                        <AccordionHeader>
                            <Span>
                                <AccordionToggle Class="fw-bolder">@L["ChatInfo"]</AccordionToggle>
                            </Span>
                        </AccordionHeader>
                        <AccordionBody>
                            <Button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center"  @onclick="async () => await ShowPinnedMessagesAsync()">
                                <i class="bi bi-pin-angle-fill fs-5"></i>
                                <span class="d-block ms-2"> @L["ShowPinnedMessages"]</span>
                            </Button>
                        </AccordionBody>
                    </AccordionItem>
                    @if(CurrentChatContact.Type != ConversationType.User)
                    {
                        <AccordionItem @bind-Visible="@AccordionChatMembersVisible">
                            <AccordionHeader>
                                <Span>
                                    <AccordionToggle Class="fw-bolder">@L["ChatMembers"]</AccordionToggle>
                                </Span>
                            </AccordionHeader>
                            <AccordionBody>
                                @if(IsLoadingMembers)
                                {
                                    <div class="d-flex justify-content-center">
                                        <RadarSpinner />
                                    </div>
                                }
                                else
                                {
                                    <Div>
                                        @foreach(var member in Members)
                                        {
                                            <Div Class="d-flex align-items-center justify-content-between gap-2 mb-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <canvas id="member-avatar-@member.UserId" class="canvas-avatar rounded-circle" Width="30" Height="30"></canvas>
                                                    <span>@member.UserInfo?.Surname @member.UserInfo?.Name</span>
                                                </div>
                                                <div class="dropdown d-flex align-items-center gap-2">
                                                    <button class="btn p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="lpx-caret bi-three-dots" aria-hidden="true"></i>
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                    @if(member.UserId != CurrentUserId)
                                                    {
                                                            <li>
                                                                <a class="dropdown-item"
                                                                @onclick="async () => await SendMessageToMemberAsync( new ConversationMemberDto { UserId = member.UserId, ConversationId = CurrentChatContact.ConversationId.Value })">
                                                                    <i class="bi bi-chat-left-text"></i> @L["SendMessage"]
                                                                </a>
                                                            </li>
                                                    }

                                                        @if(member.UserId == CurrentUserId)
                                                        {   
                                    
                                                            <li>
                                                                <a class="dropdown-item" @onclick="async () => await LeaveConversationFromInfoBoxAsync(new RemoveMemberInput { ConversationId = CurrentChatContact.ConversationId.Value, UserId = member.UserId })">
                                                                    <i class="bi bi-arrow-bar-left"></i> @L["LeaveConversation"]
                                                                </a>
                                                            </li>
                                                        }

                                                        @if(IsCurrentUserAdmin && member.UserId != CurrentUserId)
                                                        {
                                                            <li>
                                                                <a class="dropdown-item" @onclick="async () => await RemoveMemberFromInfoBoxAsync(new RemoveMemberInput { ConversationId = CurrentChatContact.ConversationId.Value, UserId = member.UserId })">
                                                                    <i class="bi bi-trash"></i> @L["Delete"]
                                                                </a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </Div> 
                                        }       
                                    </Div>
                                }
                            </AccordionBody>
                        </AccordionItem>
                    }
                    <AccordionItem @bind-Visible="@AccordionMediaFilesVisible">
                        <AccordionHeader>
                            <Span>
                                <AccordionToggle Class="fw-bolder">@L["Files"]</AccordionToggle>
                            </Span>
                        </AccordionHeader>
                        <AccordionBody>
                            <Div Class="d-flex justify-content-between gap-2 mb-2">
                                <Button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center w-100" 
                                @onclick="async () => await ShowImagesAsync()">
                                    <i class="bi bi-image fs-5"></i>
                                    <span class="d-block ms-2"> @L["Images"]</span>
                                </Button>
                                <Button class="btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center w-100" 
                                @onclick="async () => await ShowFilesAsync()">
                                    <i class="bi bi-file-earmark-fill fs-5"></i>
                                    <span class="d-block ms-2"> @L["Files"]</span>
                                </Button>
                            </Div>
                        </AccordionBody>
                    </AccordionItem>
                    
                </Accordion>
                    break;
                case "FindMessage":
                        <Div Class="mt-1 mb-1 d-flex justify-content-start">
                            <button class="btn btn-sm btn-outline-light" @onclick="async () => await CloseFindMessageAsync()">    
                                <i class="bi bi-arrow-left fs-5 text-brand"></i>
                            </button>
                        </Div> 

                        <Div Class="mt-1 mb-1 d-flex justify-content-center">
                            <input type="search" 
                            class="form-control form-control-sm"
                            placeholder="@L["SearchMessage"].Value"
                            aria-label="@L["SearchMessage"].Value"
                            autocomplete="off"
                            spellcheck="false"
                            aria-autocomplete="list"
                            role="combobox"
                            aria-expanded="false"
                            aria-owns="algolia-autocomplete-listbox-0"
                            dir="auto"
                            @bind="SearchMessageValue"
                            @onkeydown="@(async e => await OnSearchMessageKeyupAsync(e))"/>
                        </Div>

                        <Div Class="mb-2 text-center">
                            <span class="text-muted">
                                @L["EnterToFindMessage"]
                            </span>  
                        </Div>

                        <Div Class="mb-2 text-center overflow-y-auto" id="found_messages">
                            @foreach(var message in FoundMessages)
                            {
                                <a class="chat-contact cursor-pointer list-group-item list-group-item-action mb-1 mt-0 px-2 rounded-2
                                bg-white shadow rounded py-1 px-2 mb-1 position-relative">
                                    <div class="media">
                                        <div class="media-body ms-2">
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <h6 class="mb-0 me-1">
                                                    @(message.SenderSurname + " " + message.SenderName)
                                                </h6>
                                            </div>
                                            <p class="d-flex justify-content-between gap-1 mb-0 small last-message">
                                                <span class="text-muted text-start">@message.Message</span>
                                                <span class="text-muted"> @Clock.ConvertToUserTime(message.MessageDate).ToString("d") @Clock.ConvertToUserTime(message.MessageDate).ToString("t")</span>
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            }
                        </Div>
                        

                        @if(ShowLoadMoreFoundMessages)
                        {
                            <Div Class="mb-2 text-center">
                                <button class="btn btn-sm btn-outline-primary" @onclick="async () => await LoadMoreFoundMessagesAsync()">
                                    @L["LoadMore"]
                                </button>
                            </Div>
                        }
                    break;
                case "MediaAndFile":

                <Div Class="mt-1 mb-1 d-flex justify-content-start">
                    <button class="btn btn-sm btn-outline-light" @onclick="async () => await CloseMediaAndFileAsync()">    
                        <i class="bi bi-arrow-left fs-5 text-brand"></i>
                    </button>
                </Div>

                <Div Class="mb-2 text-center overflow-y-auto" id="found_media_and_files">
                    <Tabs SelectedTab="@SelectedTabMediaFiles" SelectedTabChanged="@(async (name) => await OnSelectedTabMediaFilesChanged(name))">
                        <Items>
                            <Tab Name="images">
                                <Icon Name="IconName.Image" Class="me-1" />
                                @L["Images"]
                            </Tab>
                            <Tab Name="files">
                                <Icon Name="IconName.File" Class="me-1" />
                                @L["Files"]
                            </Tab>
                        </Items>
                        <Content>
                            <TabPanel Name="images" Class="overflow-y-auto" Style="max-height: 50vh;">
                                <Div Class="d-flex flex-wrap">
                                    @foreach(var media in FoundMedias)
                                    {
                                        <Card Class="shadow-sm p-0" Style="flex-basis: 33%; min-width: 0;">
                                            <CardBody Class="p-0">
                                                <Div Class="position-relative h-100 p-1">
                                                    <CardImage Source="@GetImageUrl(media.FilePath)" Alt="Placeholder image"
                                                     Class="card-image-full w-100 h-100 object-fit-cover"
                                                     @onclick="async () => await OnOpenImageViewerAsync(media.Id, media.FileName, media.FilePath, media.DownloadUrl)">
                                                    </CardImage>
                                                    <span role="button" class="heart bg-white flex-center rounded-circle position-absolute text-brand" style="width: 20px; height: 20px; top: 4px; right: 4px"
                                                    @onclick="async () => await DownloadFileAsync(media.Id)">
                                                        <i class="bi bi-cloud-download-fill" style="height: 20px"></i></span>
                                                </Div>
                                            </CardBody>
                                        </Card>
                                    }
                                </Div>
                                @if(ShowLoadMoreImages)
                                {
                                    <Div Class="mb-2 text-center">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="async () => await LoadMoreImagesAsync()">
                                            @L["LoadMore"]  
                                        </button>
                                    </Div>
                                }
                            </TabPanel>
                            <TabPanel Name="files" Class="overflow-y-auto" Style="max-height: 50vh;">
                                @foreach(var file in FoundFiles)
                                {
                                    <div class="d-flex align-items-center mb-1 p-1 bg-primary text-white rounded">
                                        <i class="bi bi-file-earmark me-2"></i>
                                        <small class="flex-grow-1 text-truncate">@file.FileName</small>
                                        <button class="btn btn-sm btn-link text-white p-0 ms-2" 
                                        @onclick="async () => await DownloadFileAsync(file.Id)" 
                                        title="@L["DownloadFile"]">
                                            <i class="bi bi-cloud-download-fill"></i>
                                        </button>
                                    </div>
                                }
                                @if(ShowLoadMoreFiles)
                                {
                                    <Div Class="mb-2 text-center">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="async () => await LoadMoreFilesAsync()">
                                            @L["LoadMore"]  
                                        </button>
                                    </Div>
                                }
                            </TabPanel>
                        </Content>
                    </Tabs>
                </Div>

             
                break;
            }
        </CardBody>
    </Card>
</Column>


@* ************************* PINNED MESSAGES MODAL ************************* *@
<Modal @ref="PinnedMessagesModal" Closing="@PinnedMessagesModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Default">
        <ModalHeader>
            <ModalTitle>@L["PinnedMessages"]</ModalTitle>
            <CloseButton Clicked="ClosePinnedMessagesModalAsync" />
        </ModalHeader>
        <ModalBody Class="overflow-y-auto" Style="max-height: 50vh;">
            @foreach (var message in PinnedMessages)
            {
                if (message.SenderUserId == CurrentUserId)
                {
                    <div class="media w-75 mw-65 w-lp-auto mb-2 ms-auto position-relative">
                        <div class="media-body position-relative">
                            @if (message.ReplyToMessage != null)
                            {
                                <div class="bg-dark bg-opacity-25 rounded p-2 mb-1 position-relative" style="border-left: 3px solid #0d6efd; cursor: pointer;">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="flex-grow-1">
                                            <small class="text-muted d-block">@L["ReplyingTo"]:</small>
                                            <small class="text-truncate d-block">@message.ReplyToMessage.Message.TruncateWithPostfix(50, "...")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                            
                            @if (message.ForwardedFromMessage != null)
                            {
                                <div class="bg-dark bg-opacity-25 rounded p-2 mb-1 position-relative" style="border-left: 3px solid #17a2b8;">
                                    <div class="d-flex align-items-start">
                                        <i class="bi bi-forward-fill text-info me-2"></i>
                                        <div class="flex-grow-1">
                                            <small class="text-muted d-block">@L["ForwardedFrom"]: 
                                                @if (!string.IsNullOrWhiteSpace(message.ForwardedFromMessage.SenderName))
                                                {
                                                    <span>@message.ForwardedFromMessage.SenderName @message.ForwardedFromMessage.SenderSurname</span>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(message.ForwardedFromMessage.SenderUsername))
                                                {
                                                    <span>@message.ForwardedFromMessage.SenderUsername</span>
                                                }
                                            </small>
                                            <small class="text-truncate d-block">@message.ForwardedFromMessage.Message.TruncateWithPostfix(50, "...")</small>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="bg-primary text-bg-primary mb-1 px-2 px-lg-3 py-1  rounded shadow-sm position-relative">
                                @if (message.IsSending)
                                {
                                    <div class="position-absolute top-0 end-0 p-1">
                                        <span class="spinner-border spinner-border-sm text-light" role="status" aria-hidden="true"></span>
                                    </div>
                                }
                                <p class="mb-0 message-text text-small">@message.Message</p>
                                @* Message Files *@
                                @if (message.Files != null && message.Files.Any())
                                {
                                    <div class="mt-2">
                                        @foreach (var file in message.Files)
                                        {
                                            <div class="d-flex align-items-center mb-1 p-1 bg-dark bg-opacity-25 rounded">
                                                <i class="bi bi-file-earmark me-2"></i>
                                                <small class="flex-grow-1 text-truncate">@file.FileName</small>
                                                <button class="btn btn-sm btn-link text-light p-0 ms-2" @onclick="async () => await DownloadFileAsync(file.Id)" title="@L["DownloadFile"]">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <p class="left m-0 message-date small text-muted" style="opacity: 0.35; width: 150px; left: -110px; top: 1px; ">@Clock.ConvertToUserTime(message.MessageDate)</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="media w-75 mw-65 w-lp-auto mb-2 position-relative">
                        <div class="media-body position-relative ms-2">
                            <div class="mb-1">
                                <small class="text-muted fw-bold">
                                    @if (!string.IsNullOrEmpty(message.SenderName) || !string.IsNullOrEmpty(message.SenderSurname))
                                    {
                                        @($"{message.SenderSurname} {message.SenderName}".Trim())
                                    }
                                    else if (!string.IsNullOrEmpty(message.SenderUsername))
                                    {
                                        @message.SenderUsername
                                    }
                                    else
                                    {
                                        @L["UnknownUser"]
                                    }
                                </small>
                            </div>
                            <div class="bg-white shadow rounded py-1 px-2 mb-1 position-relative">
                                @if (message.IsSending)
                                {
                                    <div class="position-absolute top-0 end-0 p-1">
                                        <span class="spinner-border spinner-border-sm text-muted" role="status" aria-hidden="true"></span>
                                    </div>
                                }
                                <p class="text-small mb-0 text-black">@message.Message</p>
                                @if (message.Files != null && message.Files.Any())
                                {
                                    <div class="mt-2">
                                        @foreach (var file in message.Files)
                                        {
                                            <div class="d-flex align-items-center mb-1 p-1 bg-white rounded border">
                                                <i class="bi bi-file-earmark me-2"></i>
                                                <small class="flex-grow-1 text-truncate">@file.FileName</small>
                                                <button class="btn btn-sm btn-link p-0 ms-2" @onclick="async () => await DownloadFileAsync(file.Id)" title="@L["DownloadFile"]">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <p class="small text-muted position-absolute m-0" style="opacity: 0.35; width: 100px; right: -110px; top: 1px;">@Clock.ConvertToUserTime(message.MessageDate)</p>
                        </div>
                    </div>
                }
            }

        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary"
                    Clicked="ClosePinnedMessagesModalAsync">
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>


<Modal @ref="AddMembersModal" Closing="@AddMembersModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Default">
        <ModalHeader>
            <ModalTitle>@L["AddMember"]</ModalTitle>
            <CloseButton Clicked="CloseAddMembersModalAsync" />
        </ModalHeader>
        <ModalBody>
            <div class="hc-select2-full">
                <Select2 IdSelector="c => c.Id.ToString()"
                        TextSelector="c => c.DisplayName"
                        FilterFunction="GetIdentityUserCollectionLookupAsync"
                        GetElementById="async (items, id, token) => items.FirstOrDefault(x => x.Id.ToString() == id)!"
                        Datasource="IdentityUsersCollection"
                        Value="@SelectedMembersToAddConversation"
                        ValueChanged="@((List<LookupDto<Guid>> value) => SelectedMembersToAddConversation = value ?? new List<LookupDto<Guid>>())"
                        Cache="__MemoryCache"
                        Multiselect="true" />
            </div>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary"
                    Clicked="CloseAddMembersModalAsync">
                @L["Close"]
            </Button>
            <Button Color="Color.Primary"
                    Clicked="@(async () => await AddMembersToInfoBoxAsync())">
                @L["Add"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>