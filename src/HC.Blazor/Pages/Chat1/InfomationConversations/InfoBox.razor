
@using HC.Localization
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.Features
@using Volo.Abp.Timing
@using HC.Chat
@using HC.Chat.Authorization
@using HC.Chat.Conversations
@using HC.Chat.Messages
@using Volo.Abp.AspNetCore.Components.Web
@using HC.Shared
@using HC.Projects
@using HC.ProjectTasks
@using HC.ProjectMembers
@using HC.ProjectTaskAssignments
@using Microsoft.Extensions.Caching.Memory
@using HC.Chat.Users
@attribute [Authorize(ChatPermissions.Messaging)]
@attribute [RequiresFeature(ChatFeatures.Enable)]
@inherits HCComponentBase
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IClock Clock
@inject IMemoryCache __MemoryCache
@inject IProjectsAppService ProjectsAppService
@inject IProjectTasksAppService ProjectTasksAppService
@inject IProjectMembersAppService ProjectMembersAppService
@inject IUiMessageService UiMessageService


<Column Size="ColumnSize.Is12.OnMobile.Is3.OnDesktop" class="col-12 col-md-3 d-flex align-items-stretch">
    <Card Class="w-100 mb-3 mb-md-0" Style="height: 100vh; display: flex; flex-direction: column;">
        <CardBody Class="p-2" Style="display: flex; flex-direction: column; overflow: hidden;">
            <Div Class="mt-1 mb-2 d-flex justify-content-center">
                @if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.User)
                {
                    <canvas @ref="CanvasElementReferences[CurrentChatContact]" class="canvas-avatar mx-auto rounded-circle" Width="30" Height="30"></canvas>
                }
                else if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.Group)
                {
                    <a href="javascript:void(0)" 
                        Class="bg-light border border-2 rounded-circle d-flex justify-content-center align-items-center text-decoration-none" 
                        Style="width: 30px; height: 30px">
                        <i class="bi bi-people-fill fs-4 text-primary"></i>
                    </a>
                }
                else if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.Project)
                {
                    <a href="javascript:void(0)" 
                        Class="bg-light border border-2 rounded-circle d-flex justify-content-center align-items-center text-decoration-none" 
                        Style="width: 30px; height: 30px">
                        <i class="bi bi-folder-fill fs-4 text-success"></i>
                    </a>
                }
                else if (CurrentChatContact != null && CurrentChatContact.Type == ConversationType.Task)
                {
                    <a href="javascript:void(0)" 
                        Class="bg-light border border-2 rounded-circle d-flex justify-content-center align-items-center text-decoration-none" 
                        Style="width: 30px; height: 30px">
                        <i class="bi bi-check2-square fs-4 text-warning"></i>
                    </a>
                }
            </Div>
            <Div Class="mb-2 text-center">
                <Heading Size="HeadingSize.Is5">
                    @if (CurrentChatContact != null)
                    {
                        @if (CurrentChatContact.Type == ConversationType.User)
                        {
                            @(GetName(CurrentChatContact) + (CurrentChatContact.HasChatPermission ? string.Empty : $" - {L["Volo.Chat:010004"]}"))
                        }else{
                            @(CurrentChatContact.ConversationName ?? GetName(CurrentChatContact))
                        }
                    }
                </Heading>  
            </Div>
            
            <Accordion >
                <AccordionItem @bind-Visible="@AccordionChatInfoVisible">
                    <AccordionHeader>
                        <Span>
                            <AccordionToggle Class="fw-bolder">@L["ChatInfo"]</AccordionToggle>
                        </Span>
                    </AccordionHeader>
                    <AccordionBody>
                        <Button class="btn btn-sm btn-outline-primary" @onclick="async () => await ShowPinnedMessagesAsync()">@L["ShowPinnedMessages"]</Button>
                    </AccordionBody>
                </AccordionItem>
                @if(CurrentChatContact.Type != ConversationType.User)
                {
                    <AccordionItem  @onclick="async () => await LoadMembersAsync()" @bind-Visible="@AccordionChatMembersVisible">
                        <AccordionHeader>
                            <Span>
                                <AccordionToggle Class="fw-bolder">@L["ChatMembers"]</AccordionToggle>
                            </Span>
                        </AccordionHeader>
                        <AccordionBody>
                            @if(IsLoadingMembers)
                            {
                                <div class="d-flex justify-content-center">
                                    <RadarSpinner />
                                </div>
                            }
                            else
                            {
                                <Div>
                                    @foreach(var member in Members)
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <canvas id="member-avatar-@member.UserId" class="canvas-avatar rounded-circle" Width="30" Height="30"></canvas>
                                            <span>@member.UserInfo?.Surname @member.UserInfo?.Name</span>
                                        </div>
                                    }       
                                </Div>
                            }
                        </AccordionBody>
                    </AccordionItem>
                }
                <AccordionItem @bind-Visible="@AccordionMediaFilesVisible">
                    <AccordionHeader>
                        <Span>
                            <AccordionToggle Class="fw-bolder">@L["Files"]</AccordionToggle>
                        </Span>
                    </AccordionHeader>
                    <AccordionBody>
                    </AccordionBody>
                </AccordionItem>
                
            </Accordion>
        </CardBody>
    </Card>
</Column>


<style> 
    .accordion-button,
    .accordion-body{
        padding:12px 6px !important;
        hover: background-color: #f8f9fa !important;
        &:hover {
            background-color: #f8f9fa !important;
        }
    }

    .accordion-button::after{
        background-size:16px !important; 
    }

    .accordion-item {
        border:none !important;
    }
</style>