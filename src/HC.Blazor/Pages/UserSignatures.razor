@page "/user-signatures"
@attribute [Authorize(HCPermissions.UserSignatures.Default)]
@using HC.UserSignatures
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@using HC.SignatureSettings
@inherits HCComponentBase
@inject IUserSignaturesAppService UserSignaturesAppService
@inject ISignatureSettingsAppService SignatureSettingsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager
@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["UserSignatures"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>
<style>
    tr.table-row-selectable:hover {
        cursor: default;
    }
</style>
@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
        <Row>
            <div class="col col-md-8 col-lg-10">
                <div class="mb-0">
                    <Form id="UserSignatureSearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="UserSignatureSearchForm" Clicked="GetUserSignaturesAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
                   <div class="col-md-4 col-lg-2">
            <div class="mb-0">
               <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                         Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                         <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
               </Button>
            </div>
       </div>
        <div style="display: @(!ShowAdvancedFilters ? "none" : "block")"  class="mt-3">
            <Row>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["SignType"]</FieldLabel>
                        <Select TValue="SignType?" 
                                SelectedValue="@FilterSignType"
                                SelectedValueChanged="@OnFilterSignTypeChangedAsync">
                            <ChildContent>
                                <SelectItem TValue="SignType?" Value="@((SignType?)null)">@L["All"]</SelectItem>
                                @foreach (var item in Enum.GetValues<SignType>())
                                {
                                    <SelectItem TValue="SignType?" Value="@item">
                                        @L[$"Enum:SignType.{item}"]
                                    </SelectItem>
                                }
                            </ChildContent>
                        </Select>
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["ProviderCode"]</FieldLabel>
                        <TextEdit Text="@Filter.ProviderCode" TextChanged="@OnProviderCodeChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["TokenRef"]</FieldLabel>
                        <TextEdit Text="@Filter.TokenRef" TextChanged="@OnTokenRefChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["SignatureImage"]</FieldLabel>
                        <TextEdit Text="@Filter.SignatureImage" TextChanged="@OnSignatureImageChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MinValidFrom"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.ValidFromMin"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnValidFromMinChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MaxValidFrom"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.ValidFromMax"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnValidFromMaxChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MinValidTo"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.ValidToMin"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnValidToMinChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MaxValidTo"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.ValidToMax"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnValidToMaxChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["IsActive"]</FieldLabel>
                        <Select TValue="string"
		SelectedValue="@IsActiveFilterValue"
		SelectedValueChanged="@OnIsActiveChangedAsync">
<SelectItem Value="@string.Empty">@L["All"]</SelectItem>
<SelectItem Value="true">@L["Yes"]</SelectItem>
<SelectItem Value="false">@L["No"]</SelectItem>
</Select>                       
                    </Field>
                </Column>
                @if (IsAdmin)
                {
                    <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                        <Field>
                            <FieldLabel>@L["IdentityUser"]</FieldLabel>
                            <Select TValue="Guid?"
                                    SelectedValue="@Filter.IdentityUserId"
                                    SelectedValueChanged="@OnIdentityUserIdChangedAsync">
                                <SelectItem TValue="Guid?" Value="@((Guid?)null)">@L["All"]</SelectItem>
                                @foreach(var item in IdentityUsersCollection)
                                {
                                    <SelectItem TValue="Guid" Value="@item.Id">
                                        @item.DisplayName
                                    </SelectItem>
                                }
                            </Select>                       
                        </Field>
                    </Column>
                }
            </Row>
@*//<suite-custom-code-block-2>*@
@*//</suite-custom-code-block-2>*@
        </div>
        </Row>
@*//<suite-custom-code-block-3>*@
@*//</suite-custom-code-block-3>*@
    </CardBody>
</Card>
@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>        
        <Div  Visibility="@(SelectedUserSignatures.Any() ? Visibility.Visible : Visibility.Invisible)"
              class="d-flex justify-content-between align-items-center mb-2">
              <p class="lead mb-0">
                @if (AllUserSignaturesSelected)
                {
                    @L["AllItemsAreSelected", TotalCount]
                }
                else
                {
                    @if (SelectedUserSignatures.Count > 1)
                    {
                        @L["NumberOfItemsOnThisPageAreSelected", SelectedUserSignatures.Count]
                    }
                    else
                    {
                        @L["OneItemOnThisPageIsSelected"]
                    }
                }
              </p>
            <div>
                @if ((SelectedUserSignatures.Count == PageSize || SelectedUserSignatures.Count == UserSignatureList.Count) && TotalCount > SelectedUserSignatures.Count)
                {
                    if (!AllUserSignaturesSelected)
                    {
                        <Button Clicked="SelectAllItems" Class="mx-1 btn-outline-secondary">@L["SelectAllItems", TotalCount]</Button>
                    }
                    else
                    {
                        <Button Clicked="ClearSelection" Class="mx-1 btn-outline-secondary">@L["ClearSelection"]</Button>
                    }
                }
                <Button Color="Color.Danger" Class="mx-1" Size="Size.Medium" Clicked="DeleteSelectedUserSignaturesAsync">
                    <Icon Name="@IconName.Delete" /> @L["Delete"]
                </Button>
            </div>
        </Div>
        <hr Visibility="@(SelectedUserSignatures.Any() ? Visibility.Visible : Visibility.Invisible)"
            class="my-1 mx-0" />
        <DataGrid TItem="UserSignatureWithNavigationPropertiesDto"
                  @ref="DataGridRef"
                  Data="UserSignatureList"
                  SelectionMode="DataGridSelectionMode.Multiple"
                  SelectedRows="SelectedUserSignatures"
                  RowSelectable="RowSelectableHandler"
                  SelectedRowsChanged="SelectedUserSignatureRowsChanged"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize"
                  Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                       <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>   
            <DataGridColumns>
                @if (CanDeleteUserSignature && UserSignatureList.Any())
                {
                    <DataGridMultiSelectColumn TItem="UserSignatureWithNavigationPropertiesDto" DisplayOrder="-1" Width="30px"></DataGridMultiSelectColumn>
                }
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.SignType"
                      Caption="@L["SignType"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.ProviderCode"
                      Caption="@L["ProviderCode"]"
                        CellStyle="@((item) => "min-width: 180px")"
                        Width="180px">
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.TokenRef"
                      Caption="@L["TokenRef"]"
                        CellStyle="@((item) => "min-width: 180px")"
                        Width="180px">
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.SignatureImage"
                      Caption="@L["SignatureImage"]"
                        CellStyle="@((item) => "min-width: 180px")"
                        Width="180px">
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.ValidFrom"
                      Caption="@L["ValidFrom"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                  <DisplayTemplate>
                        @(context.UserSignature.ValidFrom.HasValue ? context.UserSignature.ValidFrom.Value.ToShortDateString() : string.Empty)
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.ValidTo"
                      Caption="@L["ValidTo"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                  <DisplayTemplate>
                        @(context.UserSignature.ValidTo.HasValue ? context.UserSignature.ValidTo.Value.ToShortDateString() : string.Empty)
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="UserSignature.IsActive"
                      Caption="@L["IsActive"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                    <DisplayTemplate>
                        @if (context.UserSignature.IsActive)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto"
                      Field="IdentityUser.Name"
                      Caption="@L["IdentityUser"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
              </DataGridColumn>
                <DataGridColumn TItem="UserSignatureWithNavigationPropertiesDto" Caption="@L["Actions"]" CellStyle="@((item) => "min-width: 150px")" Width="150px">
                    <DisplayTemplate>
                        <div class="d-flex gap-1">
                            @if (CanEditUserSignature)
                            {
                                <Button Outline Color="Color.Primary"
                                 Size="Size.Small" 
                                 Title="@L["Edit"]"
                                 Clicked="@(() => OpenEditUserSignatureModalAsync(context))">
                                    <Icon Name="IconName.Edit" />
                                </Button>
                            }
                            @if (CanDeleteUserSignature)
                            {
                                <Button Outline Color="Color.Danger" 
                                Size="Size.Small" 
                                Title="@L["Delete"]"
                                Clicked="@(() => DeleteUserSignatureWithConfirmationAsync(context))">
                                    <Icon Name="IconName.Delete" />
                                </Button>
                            }
                        </div>
@*//<suite-custom-code-block-4>*@
@*//</suite-custom-code-block-4>*@
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateUserSignatureModal" Closing="@CreateUserSignatureModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
@*//<suite-custom-code-block-5>*@
@*//</suite-custom-code-block-5>*@
        <Form id="CreateUserSignatureForm">
            <ModalHeader>
                <ModalTitle>@L["NewUserSignature"]</ModalTitle>
                <CloseButton Clicked="CloseCreateUserSignatureModalAsync" />
            </ModalHeader>
            <ModalBody>
                @* Manual validation is used (see ValidateCreateUserSignature). *@
                @if (!string.IsNullOrWhiteSpace(CreateUserSignatureValidationErrorKey))
                {
                    <Alert Color="Color.Danger">
                        <AlertMessage>@L["NotificationError"]!</AlertMessage>
                        <AlertDescription>@L[CreateUserSignatureValidationErrorKey]</AlertDescription>
                    </Alert>
                }
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["SignType"] *</FieldLabel>
                            <Select TValue="SignType?" 
                                    SelectedValue="@NewSignType"
                                    SelectedValueChanged="@((SignType? value) => { NewSignType = value; CreateFieldErrors.Remove("SignType"); })"
                                    Autofocus="true"
                                    Style="@(HasCreateFieldError("SignType") ? "border-color: #dc3545;" : "")">
                                <ChildContent>
                                    <SelectItem TValue="SignType?" Value="@((SignType?)null)">@L[""]</SelectItem>
                                    @foreach (var item in Enum.GetValues<SignType>())
                                    {
                                        <SelectItem TValue="SignType?" Value="@item">
                                            @L[$"Enum:SignType.{item}"]
                                        </SelectItem>
                                    }
                                </ChildContent>
                            </Select>
                            @if (HasCreateFieldError("SignType"))
                            {
                                <div class="invalid-feedback d-block">@GetCreateFieldError("SignType")</div>
                            }
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["ProviderCode"] *</FieldLabel>
                            <Select TValue="Guid?" 
                                    SelectedValue="@NewSignatureSettingId"
                                    SelectedValueChanged="@((Guid? value) => { NewSignatureSettingId = value; CreateFieldErrors.Remove("ProviderCode"); })"
                                    Style="@(HasCreateFieldError("ProviderCode") ? "border-color: #dc3545;" : "")">
                                <SelectItem TValue="Guid?" Value="@((Guid?)null)">@L[""]</SelectItem>
                                @foreach(var item in SignatureSettingsCollection)
                                {
                                    <SelectItem TValue="Guid" Value="@item.Id">
                                        @item.DisplayName
                                    </SelectItem>
                                }
                            </Select>
                            @if (HasCreateFieldError("ProviderCode"))
                            {
                                <div class="invalid-feedback d-block">@GetCreateFieldError("ProviderCode")</div>
                            }
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["TokenRef"]</FieldLabel>
                            <TextEdit @bind-Text="@NewUserSignature.TokenRef" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["SignatureImage"] *</FieldLabel>
                            <TextEdit Text="@NewUserSignature.SignatureImage" 
                                    TextChanged="@((string value) => { NewUserSignature.SignatureImage = value; CreateFieldErrors.Remove("SignatureImage"); })"
                                    Style="@(HasCreateFieldError("SignatureImage") ? "border-color: #dc3545;" : "")" />
                            @if (HasCreateFieldError("SignatureImage"))
                            {
                                <div class="invalid-feedback d-block">@GetCreateFieldError("SignatureImage")</div>
                            }
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["ValidFrom"]</FieldLabel>
                            <DatePicker TValue="DateTime?" 
                                        InputMode="DateInputMode.Date"
                                        Date="@NewUserSignature.ValidFrom"
                                        DateChanged="@((DateTime? value) => { NewUserSignature.ValidFrom = value; })"
                                        Placeholder="@string.Empty" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["ValidTo"]</FieldLabel>
                            <DatePicker TValue="DateTime?" 
                                        InputMode="DateInputMode.Date"
                                        Date="@NewUserSignature.ValidTo"
                                        DateChanged="@((DateTime? value) => { NewUserSignature.ValidTo = value; })"
                                        Placeholder="@string.Empty" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        @if (IsAdmin)
                        {
                            <Field>
                                <FieldLabel>@L["IdentityUser"]</FieldLabel>
                                <Select TValue="Guid" @bind-SelectedValue="@NewUserSignature.IdentityUserId">
                                    @foreach (var identityUser in IdentityUsersCollection)
                                    {
                                        <SelectItem TValue="Guid" Value="@(identityUser.Id)">
                                            @(identityUser.DisplayName)
                                        </SelectItem>
                                    }
                                </Select>
                            </Field>
                        }
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Style="padding-top: 32px;">
                        <Field>
                            <Check TValue="bool" @bind-Checked="@NewUserSignature.IsActive">@L["IsActive"]</Check>
                        </Field>
                    </Column>
                </Row>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateUserSignatureModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateUserSignatureForm" Clicked="CreateUserSignatureAsync"/>
@*//<suite-custom-code-block-6>*@
@*//</suite-custom-code-block-6>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-7>*@
@*//</suite-custom-code-block-7>*@
    </ModalContent>
</Modal>
@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditUserSignatureModal" Closing="@EditUserSignatureModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
@*//<suite-custom-code-block-8>*@
@*//</suite-custom-code-block-8>*@
        <Form id="EditUserSignatureForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditUserSignatureModalAsync" />
            </ModalHeader>
            <ModalBody>
