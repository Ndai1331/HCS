                                @foreach(var item in SignatureSettingsCollection)
                                {
                                    <SelectItem TValue="Guid" Value="@item.Id">
                                        @item.DisplayName
                                    </SelectItem>
                                }
                            </Select>
                            @if (HasEditFieldError("ProviderCode"))
                            {
                                <div class="invalid-feedback d-block">@GetEditFieldError("ProviderCode")</div>
                            }
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["TokenRef"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingUserSignature.TokenRef" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["SignatureImage"] *</FieldLabel>
                            <TextEdit Text="@EditingUserSignature.SignatureImage" 
                                    TextChanged="@((string value) => { EditingUserSignature.SignatureImage = value; EditFieldErrors.Remove("SignatureImage"); })"
                                    Style="@(HasEditFieldError("SignatureImage") ? "border-color: #dc3545;" : "")" />
                            @if (HasEditFieldError("SignatureImage"))
                            {
                                <div class="invalid-feedback d-block">@GetEditFieldError("SignatureImage")</div>
                            }
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["ValidFrom"]</FieldLabel>
                            <DatePicker TValue="DateTime?" 
                                        InputMode="DateInputMode.Date"
                                        Date="@EditingUserSignature.ValidFrom"
                                        DateChanged="@((DateTime? value) => { EditingUserSignature.ValidFrom = value; })"
                                        Placeholder="@string.Empty" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["ValidTo"]</FieldLabel>
                            <DatePicker TValue="DateTime?" 
                                        InputMode="DateInputMode.Date"
                                        Date="@EditingUserSignature.ValidTo"
                                        DateChanged="@((DateTime? value) => { EditingUserSignature.ValidTo = value; })"
                                        Placeholder="@string.Empty" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        @if (IsAdmin)
                        {
                            <Field>
                                <FieldLabel>@L["IdentityUser"]</FieldLabel>
                                <Select TValue="Guid" @bind-SelectedValue="@EditingUserSignature.IdentityUserId">
                                    @foreach (var identityUser in IdentityUsersCollection)
                                    {
                                        <SelectItem TValue="Guid" Value="@(identityUser.Id)">
                                            @(identityUser.DisplayName)
                                        </SelectItem>
                                    }
                                </Select>
                            </Field>
                        }
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Style="padding-top: 32px;">
                        <Field>
                            <Check TValue="bool" @bind-Checked="@EditingUserSignature.IsActive">@L["IsActive"]</Check>
                        </Field>
                    </Column>
                </Row>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditUserSignatureModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditUserSignatureForm" Clicked="UpdateUserSignatureAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@
@*//</suite-custom-code-block-10>*@
    </ModalContent>
</Modal>