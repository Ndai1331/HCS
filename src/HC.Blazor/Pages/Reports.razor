@page "/reports"
@attribute [Authorize(HCPermissions.MasterDatas.ReportsDefault)]
@using HC.Reports
@using HC.Reports
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits HCComponentBase
@inject IReportsAppService ReportsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager
@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["Reports"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>
<style>
    tr.table-row-selectable:hover {
        cursor: default;
    }
</style>
@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
        <Row>
            <div class="col col-md-8 col-lg-10">
                <div class="mb-3">
                    <Form id="ReportSearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="ReportSearchForm" Clicked="GetReportsAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
                   <div class="col-md-4 col-lg-2">
            <div class="mb-3">
               <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                         Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                         <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
               </Button>
            </div>
       </div>
        <div style="display: @(!ShowAdvancedFilters ? "none" : "block")"  class="mt-3">
            <Row>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Name"]</FieldLabel>
                        <TextEdit Text="@Filter.Name" TextChanged="@OnNameChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Url"]</FieldLabel>
                        <TextEdit Text="@Filter.Url" TextChanged="@OnUrlChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MinSortOrder"]</FieldLabel>
                        <NumericEdit TValue="int?" 
             Value="@Filter.SortOrderMin"
             ValueChanged="@OnSortOrderMinChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MaxSortOrder"]</FieldLabel>
                        <NumericEdit TValue="int?" 
             Value="@Filter.SortOrderMax"
             ValueChanged="@OnSortOrderMaxChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Image"]</FieldLabel>
                        <TextEdit Text="@Filter.Image" TextChanged="@OnImageChangedAsync" />                       
                    </Field>
                </Column>
            </Row>
@*//<suite-custom-code-block-2>*@
@*//</suite-custom-code-block-2>*@
        </div>
        </Row>
@*//<suite-custom-code-block-3>*@
@*//</suite-custom-code-block-3>*@
    </CardBody>
</Card>
@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>        
        <Div  Visibility="@(SelectedReports.Any() ? Visibility.Visible : Visibility.Invisible)"
              class="d-flex justify-content-between align-items-center mb-2">
              <p class="lead mb-0">
                @if (AllReportsSelected)
                {
                    @L["AllItemsAreSelected", TotalCount]
                }
                else
                {
                    @if (SelectedReports.Count > 1)
                    {
                        @L["NumberOfItemsOnThisPageAreSelected", SelectedReports.Count]
                    }
                    else
                    {
                        @L["OneItemOnThisPageIsSelected"]
                    }
                }
              </p>
            <div>
                @if ((SelectedReports.Count == PageSize || SelectedReports.Count == ReportList.Count) && TotalCount > SelectedReports.Count)
                {
                    if (!AllReportsSelected)
                    {
                        <Button Clicked="SelectAllItems" Class="mx-1 btn-outline-secondary">@L["SelectAllItems", TotalCount]</Button>
                    }
                    else
                    {
                        <Button Clicked="ClearSelection" Class="mx-1 btn-outline-secondary">@L["ClearSelection"]</Button>
                    }
                }
                <Button Color="Color.Danger" Class="mx-1" Size="Size.Medium" Clicked="DeleteSelectedReportsAsync">
                    <Icon Name="@IconName.Delete" /> @L["Delete"]
                </Button>
            </div>
        </Div>
        <hr Visibility="@(SelectedReports.Any() ? Visibility.Visible : Visibility.Invisible)"
            class="my-1 mx-0" />
        <DataGrid TItem="ReportDto"
                  @ref="DataGridRef"
                  Data="ReportList"
                  SelectionMode="DataGridSelectionMode.Multiple"
                  SelectedRows="SelectedReports"
                  RowSelectable="RowSelectableHandler"
                  SelectedRowsChanged="SelectedReportRowsChanged"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize"
                  Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                       <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>   
            <DataGridColumns>
                @if (CanDeleteReport && ReportList.Any())
                {
                    <DataGridMultiSelectColumn TItem="ReportDto" DisplayOrder="-1" Width="30px"></DataGridMultiSelectColumn>
                }
                <DataGridEntityActionsColumn TItem="ReportDto" @ref="@EntityActionsColumn">
                    <DisplayTemplate>
                        <EntityActions TItem="ReportDto" EntityActionsColumn="@EntityActionsColumn">
                            <EntityAction TItem="ReportDto"
                                          Visible="@CanEditReport"
                                          Clicked="async () => await OpenEditReportModalAsync(context)"
                                          Text="@L["Edit"]"></EntityAction>
                            <EntityAction TItem="ReportDto"
                                          Visible="@CanDeleteReport"
                                          Clicked="() => DeleteReportAsync(context)"
                                          ConfirmationMessage="@(()=> L["DeleteConfirmationMessage"])"
                                          Text="@L["Delete"]"></EntityAction>
@*//<suite-custom-code-block-4>*@
@*//</suite-custom-code-block-4>*@
                        </EntityActions>
                    </DisplayTemplate>
                </DataGridEntityActionsColumn>
              <DataGridColumn TItem="ReportDto"
                      Field="Name"
                      Caption="@L["Name"]">
              </DataGridColumn>
              <DataGridColumn TItem="ReportDto"
                      Field="Url"
                      Caption="@L["Url"]">
              </DataGridColumn>
              <DataGridColumn TItem="ReportDto"
                      Field="SortOrder"
                      Caption="@L["SortOrder"]">
              </DataGridColumn>
              <DataGridColumn TItem="ReportDto"
                      Field="Image"
                      Caption="@L["Image"]">
              </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateReportModal" Closing="@CreateReportModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
@*//<suite-custom-code-block-5>*@
@*//</suite-custom-code-block-5>*@
        <Form id="CreateReportForm">
            <ModalHeader>
                <ModalTitle>@L["NewReport"]</ModalTitle>
                <CloseButton Clicked="CloseCreateReportModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewReportValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewReport"
                            ValidateOnLoad="false">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Name"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewReport.Name" MaxLength="ReportConsts.NameMaxLength"  Autofocus="true">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Url"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewReport.Url" MaxLength="ReportConsts.UrlMaxLength"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["SortOrder"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewReport.SortOrder"  Decimals="0"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                    <Field>
                        <FieldLabel>@L["Image"]</FieldLabel>
                        <FilePicker @key="CreateImagePickerKey"
                                    @ref="CreateImageFilePicker"
                                    Multiple="false"
                                    Changed="OnCreateImageFileChanged"
                                    ShowMode="FilePickerShowMode.List"
                                    MaxFileSize="52428800"
                                    Accept="image/*"
                                    FilePickerLocalizer="FilePickerHelper.FilePickerLocalizer">
                            <ButtonsTemplate>
                                <Buttons>
                                    <Button Clicked="@context.Clear" Color="Color.Warning">
                                        <Icon Name="IconName.Clear" /> @L["Clear"]
                                    </Button>
                                </Buttons>
                            </ButtonsTemplate>
                        </FilePicker>
                        @if (!string.IsNullOrWhiteSpace(NewReport.Image))
                        {
                            <div class="mt-2">
                                <img src="@GetImageUrl(NewReport.Image)"
                                     alt="Report Image Preview"
                                     style="max-width: 300px; max-height: 140px; object-fit: contain; border: 1px solid #ddd; border-radius: 4px; padding: 4px;" />
                            </div>
                        }
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateReportModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateReportForm" Clicked="CreateReportAsync"/>
@*//<suite-custom-code-block-6>*@
@*//</suite-custom-code-block-6>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-7>*@
@*//</suite-custom-code-block-7>*@
    </ModalContent>
</Modal>
@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditReportModal" Closing="@EditReportModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
@*//<suite-custom-code-block-8>*@
@*//</suite-custom-code-block-8>*@
        <Form id="EditReportForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditReportModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingReportValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingReport"
                            ValidateOnLoad="false">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Name"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingReport.Name" MaxLength="ReportConsts.NameMaxLength"  Autofocus="true">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Url"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingReport.Url" MaxLength="ReportConsts.UrlMaxLength"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["SortOrder"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingReport.SortOrder"  Decimals="0"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                    <Field>
                        <FieldLabel>@L["Image"]</FieldLabel>
                        <FilePicker @key="EditImagePickerKey"
                                    @ref="EditImageFilePicker"
                                    Multiple="false"
                                    Changed="OnEditImageFileChanged"
                                    ShowMode="FilePickerShowMode.List"
                                    MaxFileSize="52428800"
                                    Accept="image/*"
                                    FilePickerLocalizer="FilePickerHelper.FilePickerLocalizer">
                            <ButtonsTemplate>
                                <Buttons>
                                    <Button Clicked="@context.Clear" Color="Color.Warning">
                                        <Icon Name="IconName.Clear" /> @L["Clear"]
                                    </Button>
                                </Buttons>
                            </ButtonsTemplate>
                        </FilePicker>
                        @if (!string.IsNullOrWhiteSpace(EditingReport.Image))
                        {
                            <div class="mt-2">
                                <img src="@GetImageUrl(EditingReport.Image)"
                                     alt="Report Image Preview"
                                     style="max-width: 300px; max-height: 140px; object-fit: contain; border: 1px solid #ddd; border-radius: 4px; padding: 4px;" />
                            </div>
                        }
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditReportModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditReportForm" Clicked="UpdateReportAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@
@*//</suite-custom-code-block-10>*@
    </ModalContent>
</Modal>
