@page "/survey-results"
@attribute [Authorize(HCPermissions.SurveyResults.Default)]
@using HC.SurveyResults
@using HC.SurveyLocations
@using HC.SurveyCriterias
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web
@using HC.Blazor.Components.Charts
@using Volo.Abp.Http.Client
@inherits HCComponentBase
@inject ISurveyResultsAppService SurveyResultsAppService
@inject ISurveyLocationsAppService SurveyLocationsAppService
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH



@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["SurveyResults"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>

<style>
    .stat-block {
        @* border: 1px solid #ececec; *@
        border-radius: 4px;
        background: #fafbfc;
        padding: 24px 20px 14px 20px;
        min-width: 230px;
    }
    .stat-title {
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 18px;
        color: #182c4c;
    }
    .stat-list {
        list-style: none;
        padding-left: 0;
        margin-bottom: 0;
    }
    .stat-list-item {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
        font-size: 15px;
    }
    .stat-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 12px;
    }
    .dot-primary {
        background: #f72585;
        border: 1.5px solid #f72585;
    }
    .dot-secondary {
        background: #007bff;
        border: 1.5px solid #007bff;
    }
    .stat-value {
        font-weight: 700;
        margin-left: auto;
        font-size: 15px;
    }

    /* Rating distribution: mobile = chart row + details row; md+ = side by side */
    .rating-distribution-layout {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 1rem;
        width: 100%;
    }

    .rating-distribution-layout .rating-dist-chart {
        display: flex;
        justify-content: center;
        width: 100%;
        max-width: 100%;
    }

    .rating-distribution-layout .rating-dist-chart > div {
        max-width: min(100%, 400px);
        margin-left: auto;
        margin-right: auto;
    }

    @@media (min-width: 768px) {
        .rating-distribution-layout {
            flex-direction: row;
            justify-content: center;
            align-items: flex-start;
        }
    }

    /* Mobile: legend rows flow horizontally instead of one long vertical list */
    @@media (max-width: 767.98px) {
        .rating-distribution-layout .stat-block {
            min-width: 0;
            width: 100%;
        }

        .rating-distribution-layout .stat-list.stat-list-mobile-flow {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            justify-content: center;
            gap: 6px 14px;
        }

        .rating-distribution-layout .stat-list.stat-list-mobile-flow .stat-list-item {
            flex: 1 1 calc(50% - 8px);
            max-width: calc(50% - 8px);
            margin-bottom: 4px;
            box-sizing: border-box;
        }

        .rating-distribution-layout .stat-list.stat-list-mobile-flow .stat-value {
            margin-left: 8px;
        }
    }
</style>
@* ************************* FILTER (same pattern as Projects.razor) ************************* *@
<Card>
    <CardBody>
        <Row>
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                <Field>
                    <FieldLabel>@L["SurveyLocation"]</FieldLabel>
                    <Select TValue="Guid?"
                            SelectedValue="@SelectedSurveyLocationId"
                            SelectedValueChanged="@OnSurveyLocationChanged">
                        <SelectItem TValue="Guid?" Value="@((Guid?)null)">@L["All"]</SelectItem>
                        @foreach (var location in SurveyLocations)
                        {
                            <SelectItem TValue="Guid" Value="@location.Id">@location.Name</SelectItem>
                        }
                    </Select>
                </Field>
            </Column>
        </Row>
    </CardBody>
</Card>

@if (IsLoading)
{
    <Row Class="justify-content-center mt-4">
        <Column>
            <RadarSpinner />
        </Column>
    </Row>
}
else
{
    <Card Class="mt-3">
        <CardHeader Class="pb-0">
            <Tabs SelectedTab="@SelectedTab" SelectedTabChanged="@OnSelectedTabChanged">
                <Items>
                    <Tab Name="chart-statistics">
                        <Icon Name="IconName.ChartPie" Class="me-2" />
                        Biểu đồ thống kê
                    </Tab>
                    <Tab Name="detail-data">
                        <Icon Name="IconName.List" Class="me-2" />
                        Chi tiết
                    </Tab>
                </Items>
            </Tabs>
        </CardHeader>
        <CardBody>
            @if (SelectedTab == "chart-statistics")
            {
                @* ************************* CHARTS ************************* *@
                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Card>
                            <CardHeader>
                                <CardTitle>
                                    <Icon Name="IconName.ChartPie" Class="me-2" />
                                    @L["RatingDistribution"]
                                </CardTitle>
                            </CardHeader>
                            <CardBody>
                                <div class="rating-distribution-layout">
                                    <div class="rating-dist-chart flex-shrink-0">
                                        <PieChart ChartId="@pieChartId"
                                                  Labels="@RatingDistributionLabels"
                                                  Data="@RatingDistributionData"
                                                  BackgroundColors="@RatingDistributionColors"
                                                  IsDoughnut="true" />
                                    </div>
                                    <div class="stat-block flex-shrink-0">
                                        <div class="stat-title">@L["RatingDistributionTotal"]</div>
                                        <ul class="stat-list stat-list-mobile-flow">
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-primary text-brand"></span>
                                                @L["RatingDistributionTotal"]
                                                <span class="stat-value text-brand">@RatingDistributionData.Sum()</span>
                                            </li>
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-secondary"></span>
                                                @L["0StarRating"]
                                                <span class="stat-value">@(RatingDistributionData != null  && RatingDistributionData.Count > 0 ? RatingDistributionData[0] : 0)</span>
                                            </li>
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-secondary"></span>
                                                @L["1StarRating"]
                                                <span class="stat-value">@(RatingDistributionData != null  && RatingDistributionData.Count > 1 ? RatingDistributionData[1] : 0)</span>
                                            </li>
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-secondary"></span>
                                                @L["2StarRating"]
                                                <span class="stat-value">@(RatingDistributionData != null  && RatingDistributionData.Count > 2 ? RatingDistributionData[2] : 0)</span>
                                            </li>
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-secondary"></span>
                                                @L["3StarRating"]
                                                <span class="stat-value">@(RatingDistributionData != null  && RatingDistributionData.Count > 3 ? RatingDistributionData[3] : 0)</span>
                                            </li>
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-secondary"></span>
                                                @L["4StarRating"]
                                                <span class="stat-value">@(RatingDistributionData != null  && RatingDistributionData.Count > 4 ? RatingDistributionData[4] : 0)</span>
                                            </li>
                                            <li class="stat-list-item">
                                                <span class="stat-dot dot-secondary"></span>
                                                @L["5StarRating"]
                                                <span class="stat-value">@(RatingDistributionData != null  && RatingDistributionData.Count > 5 ? RatingDistributionData[5] : 0)</span>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </CardBody>
                        </Card>
                    </Column>
                </Row>

                <Row>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Card>
                            <CardHeader>
                                <CardTitle>
                                    <Icon Name="IconName.ChartBar" Class="me-2" />
                                    @L["CriteriaAverageRating"]
                                </CardTitle>
                            </CardHeader>
                            <CardBody>
                                <BarChart ChartId="@barChartId"
                                          Labels="@CriteriaAverageRatingsLabels"
                                          Data="@CriteriaAverageRatingsData"
                                          BackgroundColors="@CriteriaAverageRatingsColors"
                                          XAxisLabel="@L["Criteria"]"
                                          YAxisLabel="@L["AverageRating"]" />
                            </CardBody>
                        </Card>
                    </Column>
                </Row>
            }
            else if (SelectedTab == "detail-data")
            {
                <DataGrid TItem="SurveyResultSessionSummaryDto"
                          @ref="SurveySessionSummaryGridRef"
                          Data="SurveySessionSummaries"
                          ReadData="OnSurveyResultGridReadAsync"
                          TotalItems="DetailTotalCount"
                          ShowPager="true"
                          Responsive="true"
                          PageSize="DetailPageSize">
                            <LoadingTemplate>
                                <Row Class="w-100 align-items-center" Style="height: 120px;">
                                    <Column>
                                        <RadarSpinner />
                                    </Column>
                                </Row>
                            </LoadingTemplate>
                            <EmptyTemplate>
                                <Row Class="w-100 align-items-center" Style="height: 120px;">
                                    <Column>
                                        <Heading Size="HeadingSize.Is5" TextAlignment="TextAlignment.Center">Không có dữ liệu khảo sát.</Heading>
                                    </Column>
                                </Row>
                            </EmptyTemplate>
                            <DataGridColumns>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Trung bình điểm đánh giá" Sortable="false">
                                    <DisplayTemplate>
                                        @context.AverageRating.ToString("0.##")
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Khách hàng" Sortable="false">
                                    <DisplayTemplate>
                                        @context.FullName
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Số điện thoại" Sortable="false">
                                    <DisplayTemplate>
                                        @context.PhoneNumber
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Mã bệnh nhân" Sortable="false">
                                    <DisplayTemplate>
                                        @context.PatientCode
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Ghi chú" Sortable="false">
                                    <DisplayTemplate>
                                        @context.Note
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Thời gian khảo sát" Sortable="false">
                                    <DisplayTemplate>
                                        @context.SurveyTime.ToString("dd/MM/yyyy HH:mm")
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="SurveyResultSessionSummaryDto" Caption="Thao tác" Sortable="false">
                                    <DisplayTemplate>
                                        <Button Color="Color.Primary"
                                                Outline
                                                Size="Size.Small"
                                                Clicked="@(() => OpenDetailModalAsync(context))">
                                            <Icon Name="IconName.Eye"  />
                                        </Button>
                                    </DisplayTemplate>
                                </DataGridColumn>
                            </DataGridColumns>
                </DataGrid>
            }
        </CardBody>
    </Card>
}

<Modal @ref="SurveyResultDetailModal" Closing="@SurveyResultDetailModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.ExtraLarge">
        <ModalHeader>
            <ModalTitle>
                <Icon Name="IconName.Info" Color="Color.Primary" Class="me-1" />
                @L["ViewDetail"]: @(!string.IsNullOrWhiteSpace(SelectedSurveySessionSummary?.FullName) ? $"{SelectedSurveySessionSummary.FullName}" : string.Empty)
                @(!string.IsNullOrWhiteSpace(SelectedSurveySessionSummary?.PhoneNumber) ? $" - {SelectedSurveySessionSummary.PhoneNumber}" : string.Empty)
                @(!string.IsNullOrWhiteSpace(SelectedSurveySessionSummary?.Note) ? $" - {SelectedSurveySessionSummary.Note}" : string.Empty)
                @(SelectedSurveySessionSummary?.SurveyTime != null ? $" - {SelectedSurveySessionSummary.SurveyTime.ToString("dd/MM/yyyy HH:mm")}" : string.Empty)
            </ModalTitle>
            <CloseButton Clicked="CloseDetailModalAsync" />
        </ModalHeader>
        <ModalBody>
            @if (IsDetailModalLoading)
            {
                <Row Class="w-100 align-items-center" Style="height: 120px;">
                    <Column>
                        <RadarSpinner />
                    </Column>
                </Row>
            }
            else
            {
                <DataGrid TItem="SurveyResultSessionDetailDto"
                          Data="SelectedSurveySessionDetails"
                          ShowPager="false"
                          Responsive="true">
                    <EmptyTemplate>
                        <Row Class="w-100 align-items-center" Style="height: 120px;">
                            <Column>
                                <Heading Size="HeadingSize.Is5" TextAlignment="TextAlignment.Center">Không có dữ liệu khảo sát.</Heading>
                            </Column>
                        </Row>
                    </EmptyTemplate>
                    <DataGridColumns>
                        <DataGridColumn TItem="SurveyResultSessionDetailDto" Caption="Tiêu chí" Sortable="false">
                            <DisplayTemplate>
                                @context.SurveyCriteriaName
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="SurveyResultSessionDetailDto" Caption="Điểm" Sortable="false">
                            <DisplayTemplate>
                                @context.Rating
                            </DisplayTemplate>
                        </DataGridColumn>
                    </DataGridColumns>
                </DataGrid>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Size="Size.Small" Clicked="CloseDetailModalAsync">
                <Icon Name="IconName.Times" Class="me-1" />
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>
