@page "/view-document-detail"
@page "/view-document-detail/{DocumentId:guid}"
@attribute [Authorize(HCPermissions.Documents.Default)]
@attribute [Authorize(HCPermissions.Documents.MyDocuments)]
@attribute [Authorize(HCPermissions.DocumentAssignments.Default)]

@using HC.DocumentAssignments
@using HC.Documents
@using HC.DocumentFiles
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Caching.Memory
@using Volo.Abp.AspNetCore.Components.Messages
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Volo.Abp.AspNetCore.Components.BlockUi
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Blazor.Services
@using HC.Permissions
@using HC.MasterDatas
@using HC.Units
@using Microsoft.AspNetCore.Components
@using System.IO
@using System.Security.Cryptography
@using System.Text
@using Blazorise.PdfViewer
@using Volo.Abp.AspNetCore.Components.Web.Theming.PageToolbars
@using Volo.Abp.Http.Client
@using Volo.Abp.Users

@inherits HCComponentBase
@inject IDocumentsAppService DocumentsAppService
@inject IDocumentFilesAppService DocumentFilesAppService
@inject IMasterDatasAppService MasterDatasAppService
@inject IDocumentsPageLookupCache DocumentsPageLookupCache
@inject IDocumentAssignmentsAppService DocumentAssignmentsAppService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject NavigationManager NavigationManager
@inject IMemoryCache __MemoryCache
@inject Volo.Abp.BlobStoring.IBlobContainer BlobContainer
@inject HC.DocumentPdfViewer.IDocumentPdfViewerAppService DocumentPdfViewerAppService
@inject IJSRuntime JSRuntime
@inject IUiMessageService UiMessageService
@inject ICurrentUser CurrentUser

<PageHeader Title="@PageTitle" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>

@* Check if document is revoked and show warning *@


<style>
    .hc-field-label {
        font-weight: 600;
        color: #495057;
    }
    .hc-field-value {
        color: #212529;
        padding: 0.375rem 0.5rem;
        background-color: #f8f9fa;
        border-radius: 0.25rem;
        min-height: 38px;
        display: flex;
        align-items: center;
    }
</style>
@if (IsDocumentRevoked)
{
    <Alert Color="Color.Danger" Visible="true" Class="mb-3">
        <AlertMessage>
            <i class="bi bi-exclamation-triangle me-1"></i>@L["DocumentRevoked"]:
        </AlertMessage>
        <AlertDescription>
            @L["DocumentHasBeenRevokedMessage"]
        </AlertDescription>
    </Alert>
} else if (DocumentData != null)
{
    <Card>
        <CardBody>
            <Row>
                <!-- Left Column: Document Information (6 columns) -->
                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <h5 class="mb-3">@L["DocumentInformation"]</h5>
                    
                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["DocumentNumber"]</FieldLabel>
                                <div class="hc-field-value">@DocumentData.No</div>
                            </Field>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["StorageNumber"]</FieldLabel>
                                <div class="hc-field-value">@DocumentData.StorageNumber</div>
                            </Field>
                        </Column>
                    </Row>

                    <Row>
                        <Column ColumnSize="ColumnSize.Is12">
                            <Field>
                                <FieldLabel>@L["Title"]</FieldLabel>
                                <div class="hc-field-value">@DocumentData.Title</div>
                            </Field>
                        </Column>
                    </Row>

                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["ImcommingDate"]</FieldLabel>
                                <div class="hc-field-value">@DocumentData.IncommingDate.ToString("dd/MM/yyyy HH:mm")</div>
                            </Field>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["Type"]</FieldLabel>
                                <div class="hc-field-value">@TypeName</div>
                            </Field>
                        </Column>
                    </Row>

                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["Field"]</FieldLabel>
                                <div class="hc-field-value">@FieldName</div>
                            </Field>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["UrgencyLevel"]</FieldLabel>
                                <div class="hc-field-value">@UrgencyLevelName</div>
                            </Field>
                        </Column>
                    </Row>

                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["SecrecyLevel"]</FieldLabel>
                                <div class="hc-field-value">@SecrecyLevelName</div>
                            </Field>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["CurrentStatus"]</FieldLabel>
                                <div class="hc-field-value">@StatusName</div>
                            </Field>
                        </Column>
                    </Row>

                    <Row>
                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                            <Field>
                                <FieldLabel>@L["Unit"]</FieldLabel>
                                <div class="hc-field-value">@UnitName</div>
                            </Field>
                        </Column>
                      
                    </Row>

                    @* @if (!string.IsNullOrWhiteSpace(DocumentData.Signer))
                    {
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["Signer"]</FieldLabel>
                                    <div class="hc-field-value">@DocumentData.Signer</div>
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["SignPosition"]</FieldLabel>
                                    <div class="hc-field-value">@DocumentData.SignPosition</div>
                                </Field>
                            </Column>
                        </Row>
                    } *@

                    <!-- Document Files Section -->
                    <h5 class="mb-3 mt-3">@L["DocumentFiles"]</h5>
                    @if (DocumentFilesList.Any())
                    {
                        <DataGrid TItem="DocumentFileWithNavigationPropertiesDto"
                                  Data="DocumentFilesList"
                                  ShowPager="false"
                                  Responsive="true"
                                  Class="mb-3">
                            <DataGridColumns>
                                <DataGridColumn TItem="DocumentFileWithNavigationPropertiesDto"
                                                Field="DocumentFile.Name"
                                                Caption="@L["FileName"]">
                                </DataGridColumn>
                                <DataGridColumn TItem="DocumentFileWithNavigationPropertiesDto"
                                                Field="DocumentFile.CreationTime"
                                                Caption="@L["CreationTime"]">
                                    <DisplayTemplate>
                                        @context.DocumentFile.CreationTime.ToString("dd/MM/yyyy HH:mm")
                                    </DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="DocumentFileWithNavigationPropertiesDto" Caption="@L["Actions"]">
                                    <DisplayTemplate>
                                        <div class="hc-action-icons">
                                            <i class="bi bi-eye-fill hc-action-icon hc-action-view"
                                               title="@L["View"]"
                                               @onclick="@(() => ViewFileAsync(context.DocumentFile))"
                                               style="cursor: pointer;"></i>
                                            <i class="bi bi-download-fill hc-action-icon hc-action-download"
                                               title="@L["Download"]"
                                               @onclick="@(() => DownloadFileAsync(context.DocumentFile))"
                                               style="cursor: pointer;"></i>
                                        </div>
                                    </DisplayTemplate>
                                </DataGridColumn>
                            </DataGridColumns>
                        </DataGrid>
                    }
                    else
                    {
                        <Alert Color="Color.Info">
                            <AlertMessage>@L["NoFilesAvailable"]</AlertMessage>
                        </Alert>
                    }
                </Column>
                
                <!-- Right Column: PDF Viewer (6 columns) -->
                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    @if (IsPdfAvailable && !string.IsNullOrEmpty(PdfFileUrl))
                    {
                        <PdfViewerContainer Height="Height.Rem(65)">
                            <PdfViewerToolbar ShowDownloading="false" />
                            <PdfViewer Source="@PdfFileUrl" />
                        </PdfViewerContainer>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center" style="height: 65rem; background-color: #f8f9fa; border-radius: 0.25rem;">
                            <div class="text-center">
                                <Heading Size="HeadingSize.Is5" TextAlignment="TextAlignment.Center" Class="mb-3">@L["NoPdfAvailable"]</Heading>
                                <Text TextAlignment="TextAlignment.Center" Class="text-muted">
                                    @if (DocumentFilesList.Any())
                                    {
                                        @L["NoPdfFileInDocument"]
                                    }
                                    else
                                    {
                                        @L["NoFilesAvailable"]
                                    }
                                </Text>
                            </div>
                        </div>
                    }
                </Column>
            </Row>
        </CardBody>
    </Card>
}
else
{
    <Card>
        <CardBody>
            <div class="text-center py-5">
                <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
            </div>
        </CardBody>
    </Card>
}
