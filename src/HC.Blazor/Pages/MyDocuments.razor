@page "/my-documents"
@attribute [Authorize(HCPermissions.DocumentHistories.Default)]
@using HC.DocumentHistories
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.AspNetCore.Components.BlockUi
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions

@inherits HCComponentBase
@inject IDocumentHistoriesAppService DocumentHistoriesAppService
@inject IUiMessageService UiMessageService
@inject IBlockUiService BlockUiService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject NavigationManager NavigationManager

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["Menu:MyDocuments"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>

@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
        <Row>
            <div class="col col-md-8 col-lg-10">
                <div class="mb-0">
                    <Form id="DocumentHistorySearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="DocumentHistorySearchForm" Clicked="GetDocumentHistoriesAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
            <div class="col-md-4 col-lg-2">
                <div class="mb-0">
                    <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                         Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                         <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
                    </Button>
                </div>
           </div>
        <div style="display: @(!ShowAdvancedFilters ? "none" : "block")"  class="mt-3">
            <Row>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Title"]</FieldLabel>
                        <TextEdit Text="@Filter.FilterText" TextChanged="@OnFilterTextChangedAsync" />                      
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Action"]</FieldLabel>
                        <TextEdit Text="@Filter.Action" TextChanged="@OnActionChangedAsync" />                      
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Comment"]</FieldLabel>
                        <TextEdit Text="@Filter.Comment" TextChanged="@OnCommentChangedAsync" />                      
                    </Field>
                </Column>
            </Row>
        </div>
        </Row>
    </CardBody>
</Card>

@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>        
        <DataGrid TItem="DocumentHistoryWithNavigationPropertiesDto"
                    @ref="DataGridRef"
                    Data="DocumentHistoryList"
                    ReadData="OnDataGridReadAsync"
                    TotalItems="TotalCount"
                    ShowPager="true"
                    Responsive="true"
                    PageSize="PageSize"
                    Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>  
            <DataGridColumns>
                <DataGridColumn TItem="DocumentHistoryWithNavigationPropertiesDto" Caption="@L["Actions"]" Width="100px">
                    <DisplayTemplate>
                        @if (context.Document != null)
                        {
                            <Button
                                @onclick="@(() => ViewDocumentAsync(context))"
                                Color="Color.Primary"
                                Outline
                                Size="Size.Small"
                                Class="mb-1">
                                <Icon Name="IconName.Eye" />
                            </Button>
                        }
                    </DisplayTemplate>
                </DataGridColumn>

                <DataGridColumn TItem="DocumentHistoryWithNavigationPropertiesDto"
                        Field="Document.Title"
                        Caption="@L["Title"]"
                        CellStyle="@((item) => "min-width: 300px; max-width: 350px")"
                        Width="300px">
                    <DisplayTemplate>
                        @if (context.Document != null)
                        {
                            <div class="row">
                                <div class="col">
                                  <h5 class="card-title question-title pb-2">
                                    @context.Document.Title
                                  </h5>
                                  <div class="d-flex pb-2 mb-2">
                                    <p class="mb-0">
                                        <small class="text-muted">
                                            <span>#@context.Document.No</span> | @context.Document.StorageNumber
                                        </small>
                                    </p>
                                  </div>
                                </div>
                            </div>
                        }
                    </DisplayTemplate>
                </DataGridColumn>

                <DataGridColumn TItem="DocumentHistoryWithNavigationPropertiesDto"
                        Field="Action"
                        Caption="@L["Action"]"
                        CellStyle="@((item) => "min-width: 120px")"
                        Width="120px">
                </DataGridColumn>

                <DataGridColumn TItem="DocumentHistoryWithNavigationPropertiesDto"
                        Field="Comment"
                        Caption="@L["Comment"]"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px">
                </DataGridColumn>

                <DataGridColumn TItem="DocumentHistoryWithNavigationPropertiesDto"
                        Field="FromUser.Name"
                        Caption="@L["FromUser"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                </DataGridColumn>

                <DataGridColumn TItem="DocumentHistoryWithNavigationPropertiesDto"
                        Field="Document.IncommingDate"
                        Caption="@L["IncommingDate"]"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px">
                    <DisplayTemplate>
                        @if (context.Document != null)
                        {
                            @(context.Document.IncommingDate.ToShortDateString() + " " + context.Document.IncommingDate.ToShortTimeString())
                        }
                    </DisplayTemplate> 
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
