@page "/departments"
@attribute [Authorize(HCPermissions.MasterDatas.DepartmentDefault)]
@using HC.Departments
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.AspNetCore.Components.BlockUi
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Caching.Memory
@using Volo.Abp.Http.Client
@using Excubo.Blazor.TreeViews
@inherits HCComponentBase
@inject IDepartmentsAppService DepartmentsAppService
@inject IUiMessageService UiMessageService
@inject IBlockUiService BlockUiService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager
@inject IMemoryCache __MemoryCache

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["Departments"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>

<Row>
    <Column ColumnSize="ColumnSize.Is4">
        <Card>
            <CardHeader>
                <Row Class="justify-content-between">
                    <Column ColumnSize="ColumnSize.IsAuto">
                        <Heading Size="HeadingSize.Is4">
                            @L["DepartmentTree"]
                        </Heading>
                    </Column>

                    @* @if (CanCreateDepartment)
                    {
                        <Column ColumnSize="ColumnSize.IsAuto">
                            <Button Clicked="() => OpenCreateDepartmentModal()" Color="Color.Primary">
                                <Icon Name="IconName.Add" Margin="Margin.Is1.FromEnd"></Icon>@L["AddRootDepartment"]
                            </Button>
                        </Column>
                    } *@
                </Row>
            </CardHeader>
            <CardBody>
                @if (DepartmentTreeViews == null || !DepartmentTreeViews.Any())
                {
                    @L["NoDepartmentDefinedYet"]
                }
                else
                {
                    <TreeView Items="DepartmentTreeViews"
                              GetChildren="@(item => item.Children)"
                              HasChildren="@(item => item.HasChildren)">
                        <ItemTemplate>
                            <Excubo.Blazor.TreeViews.Collapse @bind-Value="@context.Item.Collapsed"/>
                            <span class="ml-1 mr-1 @(SelectedDepartment?.Id == context.Item.Id ? "text-primary" : "")" style="cursor: pointer" @onclick="() => OnSelectedDepartmentNodeChangedAsync(context.Item)" @onclick:stopPropagation="true">
                                &nbsp;<i class="fas fa-person-shelter"></i>&nbsp;
                                @context.Item.Name
                            </span>
                        </ItemTemplate>
                    </TreeView>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is8">
        <Card>
            <CardHeader>
                @if (string.IsNullOrWhiteSpace(SelectedDepartment?.Name))
                {
                    <span>@L["AllDepartments"]</span>
                }
                else
                {
                    <span>@SelectedDepartment.Name @L["Details"].Value.ToLower()</span>
                }
            </CardHeader>
            <CardBody>
                @if (SelectedDepartment == null || SelectedDepartment.Id == Guid.Empty)
                {
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-hand-pointer fa-3x mb-3"></i>
                        <p>@L["SelectDepartmentToViewDetails"]</p>
                    </div>
                }
                else
                {
                        <Row>
                            @* <Column ColumnSize="ColumnSize.Is12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="mb-0">@SelectedDepartment.Name @L["Details"].Value.ToLower()</h5>
                                    <div class="d-flex gap-2">
                                        @if (CanCreateDepartment)
                                        {
                                            <Button Color="Color.Success" Size="Size.Small" Clicked="() => OpenCreateDepartmentModal(SelectedDepartment)">
                                                <Icon Name="IconName.Add" Margin="Margin.Is1.FromEnd"></Icon>@L["AddSubDepartment"]
                                            </Button>
                                        }
                                        @if (CanEditDepartment)
                                        {
                                            <Button Color="Color.Primary" Size="Size.Small" Clicked="() => OpenEditDepartmentModal(SelectedDepartment)">
                                                <Icon Name="IconName.Edit" Margin="Margin.Is1.FromEnd"></Icon>@L["Edit"]
                                            </Button>
                                        }
                                        @if (CanEditDepartment)
                                        {
                                            <Button Color="Color.Info" Size="Size.Small" Clicked="() => OpenMoveDepartmentModal(SelectedDepartment)">
                                                <Icon Name="IconName.ArrowRight" Margin="Margin.Is1.FromEnd"></Icon>@L["Move"]
                                            </Button>
                                        }
                                        @if (CanDeleteDepartment)
                                        {
                                            <Button Color="Color.Danger" Size="Size.Small" Clicked="() => OpenDeleteDepartmentModalAsync(SelectedDepartment)">
                                                <Icon Name="IconName.Delete" Margin="Margin.Is1.FromEnd"></Icon>@L["Delete"]
                                            </Button>
                                        }
                                    </div>
                                </div>
                            </Column> *@
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["ParentDepartment"]</FieldLabel>
                                    <TextEdit @bind-Text="@ParentDepartmentName" Disabled="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["HeadOfDepartment"]</FieldLabel>
                                    <TextEdit @bind-Text="@SelectedDepartmentLeaderUser" Disabled="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["Code"]</FieldLabel>
                                    <TextEdit @bind-Text="@SelectedDepartmentCode" Disabled="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["Name"]</FieldLabel>
                                    <TextEdit @bind-Text="@SelectedDepartmentName" Disabled="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["Level"]</FieldLabel>
                                    <NumericEdit TValue="int" @bind-Value="@SelectedDepartmentLevel" Disabled="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["SortOrder"]</FieldLabel>
                                    <NumericEdit TValue="int" @bind-Value="@SelectedDepartmentSortOrder" Disabled="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["IsActive"]</FieldLabel>
                                    <Check TValue="bool" Checked="@(SelectedDepartment?.IsActive ?? false)" Disabled="true" />
                                </Field>
                            </Column>
                        </Row>
                }
            </CardBody>
        </Card>
    </Column>
</Row>

@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateDepartmentModal" Closing="@CreateDepartmentModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <Form id="CreateDepartmentForm">
            <ModalHeader>
                <ModalTitle>@L["NewDepartment"]</ModalTitle>
                <CloseButton Clicked="CloseCreateDepartmentModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewDepartmentValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewDepartment"
                            ValidateOnLoad="false">
                
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ParentDepartment"]</FieldLabel>
                            <Select2 IdSelector="c => c.Id.ToString()"
                                        TextSelector="c => c.DisplayName"
                                        FilterFunction="GetDepartmentCollectionLookupAsync"
                                        GetElementById="async (items, id, token) => await GetDepartmentByIdAsync(items, id, token)"
                                        Datasource="DepartmentLookupDtos"
                                        Value="@NewDepartmentParentUser"
                                        OnValueChanged="OnNewDepartmentParentChanged"                
                                        Cache="__MemoryCache"
                                        Multiselect="false" />
                        </Field>
                    </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Field>
                        <FieldLabel>@L["HeadOfDepartment"]</FieldLabel>
                        <Select2 IdSelector="c => c.Id.ToString()"
                                    TextSelector="c => c.DisplayName"
                                    FilterFunction="GetIdentityUserCollectionLookupAsync"
                                    GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()"
                                    Datasource="IdentityUsersCollection"
                                    Value="@SelectedLeaderUser"
                                    OnValueChanged="OnLeaderUserIdChanged"                
                                    Cache="__MemoryCache"
                                    Multiselect="false" />
                    </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Code"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewDepartment.Code" MaxLength="DepartmentConsts.CodeMaxLength" Autofocus="true">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Name"] *</FieldLabel>
                            <TextEdit @bind-Text="@NewDepartment.Name">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Level"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewDepartment.Level" Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["SortOrder"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewDepartment.SortOrder" Decimals="0">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewDepartment.IsActive">@L["IsActive"]</Check>
                    </Field>
                    </Column>
                </Row>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateDepartmentModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateDepartmentForm" Clicked="CreateDepartmentAsync"/>
            </ModalFooter>
        </Form>
    </ModalContent>
</Modal>

