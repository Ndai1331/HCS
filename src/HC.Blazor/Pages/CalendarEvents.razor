<!-- Day Events Modal with 3 Tabs (Events, Projects, Tasks) -->
<Modal @ref="DayEventsModal" Closing="@(async (args) => await CloseDayEventsModalAsync())">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@SelectedDayDate.ToString("dd/MM/yyyy") - @L["CalendarEvents"]</ModalTitle>
            <CloseButton Clicked="CloseDayEventsModalAsync" />
        </ModalHeader>
        <ModalBody>
            <Tabs SelectedTab="@SelectedDayTab" TabPosition="TabPosition.Top" Clicked="@OnSelectedDayTabChanged">
                <Items>
                    <Tab Name="events">
                        <TabHeader>@L["Events"] (@SelectedDayEvents.Count(e => e.RelatedType == RelatedType.NONE.ToString() || !Enum.TryParse<RelatedType>(e.RelatedType, out var rt) || rt == RelatedType.NONE))</TabHeader>
                    </Tab>
                    <Tab Name="projects">
                        <TabHeader>@L["Projects"] (@SelectedDayProjectEvents.Count)</TabHeader>
                    </Tab>
                    <Tab Name="tasks">
                        <TabHeader>@L["Tasks"] (@SelectedDayTaskEvents.Count)</TabHeader>
                    </Tab>
                </Items>
                <Content>
                    <!-- Events Tab -->
                    <TabPanel Name="events">
                        @if (SelectedDayEvents.Where(e => e.RelatedType == RelatedType.NONE.ToString() || !Enum.TryParse<RelatedType>(e.RelatedType, out var rt) || rt == RelatedType.NONE).Any())
                        {
                            <div style="max-height: 400px; overflow-y: auto;">
                                @foreach (var evt in SelectedDayEvents.Where(e => e.RelatedType == RelatedType.NONE.ToString() || !Enum.TryParse<RelatedType>(e.RelatedType, out var rt) || rt == RelatedType.NONE))
                                {
                                    <Card Class="mb-3" style="cursor: pointer;" @onclick="@(() => NavigateToRelatedEntity(evt))">
                                        <CardHeader>
                                            <Heading Size="HeadingSize.Is6">@GetEventCardTitle(evt)</Heading>
                                        </CardHeader>
                                        <CardBody>
                                            @if (!string.IsNullOrWhiteSpace(evt.Description))
                                            {
                                                <Text>@evt.Description</Text>
                                            }
                                            else
                                            {
                                                <Text>@L["NoDescription"]</Text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                                            {
                                                <div class="mt-2">
                                                    <Icon Name="IconName.MapMarker" Class="me-1"></Icon>
                                                    <Text>@evt.Location</Text>
                                                </div>
                                            }
                                            <div class="mt-2">
                                                <Icon Name="IconName.Clock" Class="me-1"></Icon>
                                                <Text>@evt.StartTime.ToString("HH:mm") - @evt.EndTime.ToString("HH:mm")</Text>
                                            </div>
                                        </CardBody>
                                    </Card>
                                }
                            </div>
                        }
                        else
                        {
                            <Row Class="w-100 align-items-center" Style="height: 120px;">
                                <Column>
                                    <Heading Size="HeadingSize.Is6" TextAlignment="TextAlignment.Center">@L["NoEventsFound"]</Heading>
                                </Column>
                            </Row>
                        }
                    </TabPanel>

                    <!-- Projects Tab -->
                    <TabPanel Name="projects">
                        @if (SelectedDayProjectEvents.Any())
                        {
                            <div style="max-height: 400px; overflow-y: auto;">
                                @foreach (var evt in SelectedDayProjectEvents)
                                {
                                    <Card Class="mb-3" style="cursor: pointer;" @onclick="@(() => NavigateToRelatedEntity(evt))">
                                        <CardHeader>
                                            <Heading Size="HeadingSize.Is6">@GetEventCardTitle(evt)</Heading>
                                        </CardHeader>
                                        <CardBody>
                                            @if (!string.IsNullOrWhiteSpace(evt.Description))
                                            {
                                                <Text>@evt.Description</Text>
                                            }
                                            else
                                            {
                                                <Text>@L["NoDescription"]</Text>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                                            {
                                                <div class="mt-2">
                                                    <Icon Name="IconName.MapMarker" Class="me-1"></Icon>
                                                    <Text>@evt.Location</Text>
                                                </div>
                                            }
                                            <div class="mt-2">
                                                <Icon Name="IconName.Clock" Class="me-1"></Icon>
                                                <Text>@evt.StartTime.ToString("HH:mm") - @evt.EndTime.ToString("HH:mm")</Text>
                                            </div>
                                        </CardBody>
                                    </Card>
                                }
                            </div>
                        }
                        else
                        {
                            <Row Class="w-100 align-items-center" Style="height: 120px;">
                                <Column>
                                    <Heading Size="HeadingSize.Is6" TextAlignment="TextAlignment.Center">@L["NoProjectsFound"]</Heading>
                                </Column>
                            </Row>
                        }
                    </TabPanel>

                    <!-- Tasks Tab -->
                    <TabPanel Name="tasks">
