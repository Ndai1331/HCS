@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditCalendarEventModal" Closing="@EditCalendarEventModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
@*//<suite-custom-code-block-8>*@
@*//</suite-custom-code-block-8>*@
        <Form id="EditCalendarEventForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditCalendarEventModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Tabs SelectedTab="@SelectedEditTab" SelectedTabChanged="@OnSelectedEditTabChanged">
                    <Items>
                        <Tab Name="general">
                            <Icon Name="IconName.Info" Class="me-1" />
                            @L["Tab:GeneralInformation"]
                        </Tab>
                        <Tab Name="participants">
                            <Icon Name="IconName.Users" Class="me-1" />
                            @L["Tab:Participants"]
                        </Tab>
                    </Items>
                    <Content>
                        <TabPanel Name="general">
                            @* Manual validation is used (see ValidateEditCalendarEvent). *@
                            @if (!string.IsNullOrWhiteSpace(EditCalendarEventValidationErrorKey))
                            {
                                <Alert Color="Color.Danger">
                                    <AlertMessage>@L["NotificationError"]!</AlertMessage>
                                    <AlertDescription>@L[EditCalendarEventValidationErrorKey]</AlertDescription>
                                </Alert>
                            }

                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Title"] *</FieldLabel>
                            <TextEdit Text="@EditingCalendarEvent.Title" 
                                    TextChanged="@((string value) => { EditingCalendarEvent.Title = value; EditFieldErrors.Remove("Title"); })"
                                    Autofocus="true"
                                    Style="@(HasEditFieldError("Title") ? "border-color: #dc3545;" : "")">
                            </TextEdit>
                            @if (HasEditFieldError("Title"))
                            {
                                <div class="invalid-feedback d-block">@GetEditFieldError("Title")</div>
                            }
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Description"]</FieldLabel>
                            <MemoEdit @bind-Text="@EditingCalendarEvent.Description">
                            </MemoEdit>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                        <Field>
                            <FieldLabel>@L["StartTime"]</FieldLabel>
                            <Addons>
                                <Addon AddonType="AddonType.Body">
                                    <DatePicker TValue="DateTime"
                                                InputMode="DateInputMode.DateTime"
                                                Date="@EditingCalendarEvent.StartTime"
                                                DateChanged="@(v => EditingCalendarEvent.StartTime = v)"
                                                Placeholder="@string.Empty"
                                                DisplayFormat="dd/MM/yyyy HH:mm"
                                                InputFormat="dd/MM/yyyy HH:mm"
                                                @ref="@EditingCalendarEventStartTimeDatePicker" />
                                </Addon>
                                <Addon AddonType="AddonType.End">
                                    <Button Color="Color.Light" Clicked="@(() => EditingCalendarEventStartTimeDatePicker?.ToggleAsync())">
                                        <Icon Name="IconName.CalendarDay" />
                                    </Button>
                                </Addon>
                            </Addons>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                        <Field>
                            <FieldLabel>@L["EndTime"]</FieldLabel>
                            <Addons>
                                <Addon AddonType="AddonType.Body">
                                    <DatePicker TValue="DateTime"
                                                InputMode="DateInputMode.DateTime"
                                                Date="@EditingCalendarEvent.EndTime"
                                                DateChanged="@(v => EditingCalendarEvent.EndTime = v)"
                                                Placeholder="@string.Empty"
                                                DisplayFormat="dd/MM/yyyy HH:mm"
                                                InputFormat="dd/MM/yyyy HH:mm"
                                                @ref="@EditingCalendarEventEndTimeDatePicker" />
                                </Addon>
                                <Addon AddonType="AddonType.End">
                                    <Button Color="Color.Light" Clicked="@(() => EditingCalendarEventEndTimeDatePicker?.ToggleAsync())">
                                        <Icon Name="IconName.CalendarDay" />
                                    </Button>
                                </Addon>
                            </Addons>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is2.OnDesktop" Style="padding-top: 32px;">
                        <Field>
                            <Check TValue="bool"
                                Checked="@EditingCalendarEvent.AllDay"
                                CheckedChanged="@((bool value) => { EditingCalendarEvent.AllDay = value; OnEditAllDayChanged(value); })">@L["AllDay"]</Check>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["EventType"] *</FieldLabel>
                            <Select TValue="EventType" 
                                    SelectedValue="@EditingCalendarEventEventType"
                                    SelectedValueChanged="@((EventType value) => { EditingCalendarEventEventType = value; })">
                                <ChildContent>
                                    @foreach (var eventType in Enum.GetValues<EventType>())
                                    {
                                        <SelectItem TValue="EventType" Value="@eventType">
                                            @L[$"Enum:EventType.{eventType}"]
                                        </SelectItem>
                                    }
                                </ChildContent>
                            </Select>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Location"]</FieldLabel>
                            <TextEdit @bind-Text="@EditingCalendarEvent.Location">
                            </TextEdit>
                        </Field>
                    </Column>
                </Row>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["RelatedType"] *</FieldLabel>
                            <Select TValue="RelatedType" 
                                    SelectedValue="@EditingCalendarEventRelatedType"
                                    SelectedValueChanged="@((RelatedType value) => { EditingCalendarEventRelatedType = value; SelectedEditProject.Clear(); SelectedEditProjectTask.Clear(); EditFieldErrors.Remove("RelatedId"); InvokeAsync(StateHasChanged); })">
                                <ChildContent>
                                    @foreach (var relatedType in Enum.GetValues<RelatedType>())
                                    {
                                        <SelectItem TValue="RelatedType" Value="@relatedType">
                                            @L[$"Enum:RelatedType.{relatedType}"]
                                        </SelectItem>
                                    }
                                </ChildContent>
                            </Select>
                        </Field>
                    </Column>
                    @if (EditingCalendarEventRelatedType == RelatedType.PROJECT)
                    {
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Project"] *</FieldLabel>
                            <div class="hc-select2-full" style="@(HasEditFieldError("RelatedId") ? "border: 1px solid #dc3545; border-radius: 0.25rem; padding: 2px;" : "")">
                                <Select2 IdSelector="c => c.Id.ToString()"
                                         TextSelector="c => c.DisplayName"
                                         FilterFunction="GetProjectCollectionLookupAsync"
                                         GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                         Datasource="ProjectsCollection"
                                         Value="@SelectedEditProject"
                                         OnValueChanged="@(() => { OnEditProjectChanged(); })"
                                         Cache="__MemoryCache"
                                         Multiselect="false" />
                            </div>
                            @if (HasEditFieldError("RelatedId"))
                            {
                                <div class="invalid-feedback d-block">@GetEditFieldError("RelatedId")</div>
                            }
                        </Field>
                    </Column>
                    }
                    else if (EditingCalendarEventRelatedType == RelatedType.TASK)
                    {
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">                        
                        <Field>
                            <FieldLabel>@L["ProjectTask"] *</FieldLabel>
                            <div class="hc-select2-full" style="@(HasEditFieldError("RelatedId") ? "border: 1px solid #dc3545; border-radius: 0.25rem; padding: 2px;" : "")">
                                <Select2 IdSelector="c => c.Id"
                                         TextSelector="c => c.DisplayName"
                                         FilterFunction="GetProjectTaskCollectionLookupAsync"
                                         GetElementById="async (items, id, token) => items.Where(x => x.Id == id).FirstOrDefault()!"
                                         Datasource="ProjectTasksCollection"
                                         Value="@SelectedEditProjectTask"
                                         OnValueChanged="@(() => { OnEditProjectTaskChanged(); })"
                                         Cache="__MemoryCache"
                                         Multiselect="false" />
                            </div>
                            @if (HasEditFieldError("RelatedId"))
                            {
                                <div class="invalid-feedback d-block">@GetEditFieldError("RelatedId")</div>
                            }
                        </Field>
                    </Column>
                    }
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Visibility"] *</FieldLabel>
                            <Select TValue="EventVisibility" 
                                    SelectedValue="@EditingCalendarEventVisibility"
                                    SelectedValueChanged="@((EventVisibility value) => { EditingCalendarEventVisibility = value; })">
                                <ChildContent>
                                    @foreach (var visibility in Enum.GetValues<EventVisibility>())
                                    {
                                        <SelectItem TValue="EventVisibility" Value="@visibility">
                                            @L[$"Enum:EventVisibility.{visibility}"]
                                        </SelectItem>
                                    }
                                </ChildContent>
                            </Select>
                        </Field>
                    </Column>
                </Row>
                        </TabPanel>

                        <TabPanel Name="participants">
                            <Row Class="g-3 align-items-center">
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Participant"] *</FieldLabel>
                                        <div class="hc-select2-full">
                                            <Select2 IdSelector="c => c.Id.ToString()"
                                                    TextSelector="c => c.DisplayName"
                                                    FilterFunction="GetParticipantIdentityUserLookupAsync"
                                                    GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                                    Datasource="ParticipantIdentityUsersCollection"
                                                    Value="@EditParticipantsUserToAdd"
                                                    OnValueChanged="OnEditParticipantUserChanged"
                                                    Cache="__MemoryCache"
                                                    Multiselect="false" />
                                        </div>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is3.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["ResponseStatus"] *</FieldLabel>
                                        <Select TValue="ParticipantResponse" @bind-SelectedValue="EditParticipantResponseStatus" Class="w-100">
                                            @foreach (var status in Enum.GetValues<ParticipantResponse>())
                                            {
                                                <SelectItem TValue="ParticipantResponse" Value="@status">
                                                    @L[$"Enum:ParticipantResponse.{status}"]
                                                </SelectItem>
                                            }
                                        </Select>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is3.OnDesktop">
                                    <Button Color="Color.Primary" Class="w-100" Clicked="AddEditParticipantAsync">
                                        <Icon Name="IconName.Add" Class="me-1" /> @L["Add"]
                                    </Button>
                                </Column>
                            </Row>

                            <DataGrid TItem="CalendarEventParticipantWithNavigationPropertiesDto"
                                      Data="EditParticipantsList"
                                      Responsive="true"
                                      ShowPager="false">
                                <EmptyTemplate>
                                    <Row Class="w-100 align-items-center" Style="height: 120px;">
                                        <Column>
                                            <Heading Size="HeadingSize.Is6" TextAlignment="TextAlignment.Center">@L["CreateWizard:NoParticipants"]</Heading>
                                        </Column>
                                    </Row>
                                </EmptyTemplate>
                                <DataGridColumns>
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Field="IdentityUser.UserName" Caption="@L["UserName"]" />
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Field="CalendarEventParticipant.ResponseStatus" Caption="@L["ResponseStatus"]">
                                        <DisplayTemplate>
                                            @if (Enum.TryParse<ParticipantResponse>(context.CalendarEventParticipant.ResponseStatus, ignoreCase: true, out var status))
                                            {
                                                @L[$"Enum:ParticipantResponse.{status}"]
                                            }
                                            else
                                            {
                                                @context.CalendarEventParticipant.ResponseStatus
                                            }
                                        </DisplayTemplate>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Field="CalendarEventParticipant.Notified" Caption="@L["Notified"]">
                                        <DisplayTemplate>
                                            @if (context.CalendarEventParticipant.Notified)
                                            {
                                                <Icon Name="IconName.Check" Color="Color.Success" />
                                            }
                                            else
                                            {
                                                <Icon Name="IconName.Times" Color="Color.Danger" />
                                            }
                                        </DisplayTemplate>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Caption="@L["Actions"]">
                                        <DisplayTemplate>
                                            <Button Color="Color.Danger" Outline Size="Size.Small" Clicked="@(() => DeleteEditParticipantAsync(context))">
                                                <Icon Name="IconName.Delete" Class="me-1" /> @L["Delete"]
                                            </Button>
                                        </DisplayTemplate>
                                    </DataGridColumn>
                                </DataGridColumns>
                            </DataGrid>
                        </TabPanel>
                    </Content>
                </Tabs>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditCalendarEventModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditCalendarEventForm" Clicked="UpdateCalendarEventAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@
@*//</suite-custom-code-block-10>*@
