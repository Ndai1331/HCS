                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>@L["Visibility"] *</FieldLabel>
                            <Select TValue="EventVisibility" 
                                    SelectedValue="@EditingCalendarEventVisibility"
                                    SelectedValueChanged="@((EventVisibility value) => { EditingCalendarEventVisibility = value; })">
                                <ChildContent>
                                    @foreach (var visibility in Enum.GetValues<EventVisibility>())
                                    {
                                        <SelectItem TValue="EventVisibility" Value="@visibility">
                                            @L[$"Enum:EventVisibility.{visibility}"]
                                        </SelectItem>
                                    }
                                </ChildContent>
                            </Select>
                        </Field>
                    </Column>
                </Row>
                        </TabPanel>

                        <TabPanel Name="participants">
                            <Row Class="g-3 align-items-center">
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Participant"] *</FieldLabel>
                                        <div class="hc-select2-full">
                                            <Select2 IdSelector="c => c.Id.ToString()"
                                                    TextSelector="c => c.DisplayName"
                                                    FilterFunction="GetParticipantIdentityUserLookupAsync"
                                                    GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                                    Datasource="ParticipantIdentityUsersCollection"
                                                    Value="@EditParticipantsUserToAdd"
                                                    OnValueChanged="OnEditParticipantUserChanged"
                                                    Cache="__MemoryCache"
                                                    Multiselect="false" />
                                        </div>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is3.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["ResponseStatus"] *</FieldLabel>
                                        <Select TValue="ParticipantResponse" @bind-SelectedValue="EditParticipantResponseStatus" Class="w-100">
                                            @foreach (var status in Enum.GetValues<ParticipantResponse>())
                                            {
                                                <SelectItem TValue="ParticipantResponse" Value="@status">
                                                    @L[$"Enum:ParticipantResponse.{status}"]
                                                </SelectItem>
                                            }
                                        </Select>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is3.OnDesktop">
                                    <Button Color="Color.Primary" Class="w-100" Clicked="AddEditParticipantAsync">
                                        <Icon Name="IconName.Add" Class="me-1" /> @L["Add"]
                                    </Button>
                                </Column>
                            </Row>

                            <DataGrid TItem="CalendarEventParticipantWithNavigationPropertiesDto"
                                      Data="EditParticipantsList"
                                      Responsive="true"
                                      ShowPager="false">
                                <EmptyTemplate>
                                    <Row Class="w-100 align-items-center" Style="height: 120px;">
                                        <Column>
                                            <Heading Size="HeadingSize.Is6" TextAlignment="TextAlignment.Center">@L["CreateWizard:NoParticipants"]</Heading>
                                        </Column>
                                    </Row>
                                </EmptyTemplate>
                                <DataGridColumns>
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Field="IdentityUser.UserName" Caption="@L["UserName"]" />
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Field="CalendarEventParticipant.ResponseStatus" Caption="@L["ResponseStatus"]">
                                        <DisplayTemplate>
                                            @if (Enum.TryParse<ParticipantResponse>(context.CalendarEventParticipant.ResponseStatus, ignoreCase: true, out var status))
                                            {
                                                @L[$"Enum:ParticipantResponse.{status}"]
                                            }
                                            else
                                            {
                                                @context.CalendarEventParticipant.ResponseStatus
                                            }
                                        </DisplayTemplate>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Field="CalendarEventParticipant.Notified" Caption="@L["Notified"]">
                                        <DisplayTemplate>
                                            @if (context.CalendarEventParticipant.Notified)
                                            {
                                                <Icon Name="IconName.Check" Color="Color.Success" />
                                            }
                                            else
                                            {
                                                <Icon Name="IconName.Times" Color="Color.Danger" />
                                            }
                                        </DisplayTemplate>
                                    </DataGridColumn>
                                    <DataGridColumn TItem="CalendarEventParticipantWithNavigationPropertiesDto" Caption="@L["Actions"]">
                                        <DisplayTemplate>
                                            <Button Color="Color.Danger" Outline Size="Size.Small" Clicked="@(() => DeleteEditParticipantAsync(context))">
                                                <Icon Name="IconName.Delete" Class="me-1" /> @L["Delete"]
                                            </Button>
                                        </DisplayTemplate>
                                    </DataGridColumn>
                                </DataGridColumns>
                            </DataGrid>
                        </TabPanel>
                    </Content>
                </Tabs>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditCalendarEventModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditCalendarEventForm" Clicked="UpdateCalendarEventAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@
@*//</suite-custom-code-block-10>*@
    </ModalContent>
</Modal>

<!-- Day Events Modal with 3 Tabs (Events, Projects, Tasks) -->
<Modal @ref="DayEventsModal" Closed="OnDayEventsModalClosed">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@SelectedDayDate.ToString("dd/MM/yyyy") - @L["CalendarEvents"]</ModalTitle>
            <CloseButton Clicked="CloseDayEventsModalAsync" />
        </ModalHeader>
        <ModalBody>
            <Tabs SelectedTab="@SelectedDayTab" SelectedTabChanged="@OnSelectedDayTabChanged" TabPosition="TabPosition.Top" Class="hc-day-events-tabs">
                <Items>
                    <Tab Name="events">
                        @L["Events"] (@GetSelectedDayStandaloneEvents().Count())
                    </Tab>
                    <Tab Name="projects">
                        @L["Projects"] (@SelectedDayProjectEvents.Count)
                    </Tab>
                    <Tab Name="tasks">
                        @L["Tasks"] (@SelectedDayTaskEvents.Count)
                    </Tab>
                </Items>
                <Content>
                    <!-- Events Tab -->
                    <TabPanel Name="events">
                        @if (GetSelectedDayStandaloneEvents().Any())
                        {
                            <div class="hc-day-events-list">
                                @foreach (var evt in GetSelectedDayStandaloneEvents())
                                {
                                    <div class="hc-day-event-item" @onclick="@(() => NavigateToRelatedEntity(evt))">
                                        <div class="hc-day-event-item-header">
                                            <h6 class="hc-day-event-title">@GetEventCardTitle(evt)</h6>
                                            <span class="@GetDayEventTypeClass(evt)">@GetDayEventTypeLabel(evt)</span>
                                        </div>
                                        <div class="hc-day-event-meta">
                                            <span class="hc-day-event-meta-item">
                                                <Icon Name="IconName.Clock" />
                                                @GetDayEventTimeDisplay(evt)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                                            {
                                                <span class="hc-day-event-meta-item">
                                                    <Icon Name="IconName.MapMarker" />
                                                    @evt.Location
                                                </span>
                                            }
                                        </div>
                                        <p class="hc-day-event-desc">@(string.IsNullOrWhiteSpace(evt.Description) ? L["NoDescription"].Value : evt.Description)</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="hc-day-events-empty">@L["NoEventsFound"]</div>
                        }
                    </TabPanel>

                    <!-- Projects Tab -->
                    <TabPanel Name="projects">
                        @if (SelectedDayProjectEvents.Any())
                        {
                            <div class="hc-day-events-list">
                                @foreach (var evt in SelectedDayProjectEvents)
                                {
                                    <div class="hc-day-event-item" @onclick="@(() => NavigateToRelatedEntity(evt))">
                                        <div class="hc-day-event-item-header">
                                            <h6 class="hc-day-event-title">@GetEventCardTitle(evt)</h6>
                                            <span class="@GetDayEventTypeClass(evt)">@GetDayEventTypeLabel(evt)</span>
                                        </div>
                                        <div class="hc-day-event-ref">
                                            <span class="hc-day-event-ref-label">@GetDayEventReferenceLabel(evt)</span>
                                            <span>@GetDayEventReferenceValue(evt)</span>
                                        </div>
                                        <div class="hc-day-event-meta">
                                            <span class="hc-day-event-meta-item">
                                                <Icon Name="IconName.Clock" />
                                                @GetDayEventTimeDisplay(evt)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                                            {
                                                <span class="hc-day-event-meta-item">
                                                    <Icon Name="IconName.MapMarker" />
                                                    @evt.Location
                                                </span>
                                            }
                                        </div>
                                        <p class="hc-day-event-desc">@(string.IsNullOrWhiteSpace(evt.Description) ? L["NoDescription"].Value : evt.Description)</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="hc-day-events-empty">@L["NoProjectsFound"]</div>
                        }
                    </TabPanel>

                    <!-- Tasks Tab -->
                    <TabPanel Name="tasks">
                        @if (SelectedDayTaskEvents.Any())
                        {
                            <div class="hc-day-events-list">
                                @foreach (var evt in SelectedDayTaskEvents)
                                {
                                    <div class="hc-day-event-item" @onclick="@(() => NavigateToRelatedEntity(evt))">
                                        <div class="hc-day-event-item-header">
                                            <h6 class="hc-day-event-title">@GetEventCardTitle(evt)</h6>
                                            <span class="@GetDayEventTypeClass(evt)">@GetDayEventTypeLabel(evt)</span>
                                        </div>
                                        <div class="hc-day-event-ref">
                                            <span class="hc-day-event-ref-label">@GetDayEventReferenceLabel(evt)</span>
                                            <span>@GetDayEventReferenceValue(evt)</span>
                                        </div>
                                        <div class="hc-day-event-meta">
                                            <span class="hc-day-event-meta-item">
                                                <Icon Name="IconName.Clock" />
                                                @GetDayEventTimeDisplay(evt)
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(evt.Location))
                                            {
                                                <span class="hc-day-event-meta-item">
                                                    <Icon Name="IconName.MapMarker" />
                                                    @evt.Location
                                                </span>
                                            }
                                        </div>
                                        <p class="hc-day-event-desc">@(string.IsNullOrWhiteSpace(evt.Description) ? L["NoDescription"].Value : evt.Description)</p>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="hc-day-events-empty">@L["NoTasksFound"]</div>
                        }
                    </TabPanel>
                </Content>
            </Tabs>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="CloseDayEventsModalAsync">
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<!-- Event View Modal (Read-only) - same layout as workspace -->
<Modal @ref="EventViewModal" Class="calendar-event-detail-modal" Closed="OnEventViewModalClosed">
    <ModalContent Size="ModalSize.ExtraLarge" Centered="true">
        <ModalHeader>
            <ModalTitle>@L["CalendarEvent:Detail"]</ModalTitle>
            <CloseButton Clicked="@(async () => await EventViewModal.Hide())" />
        </ModalHeader>
        <ModalBody Style="padding: 5px !important;">
            @if (ViewingCalendarEvent != null)
            {
                <Row>
                    @* Column 8: General Information *@
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is8.OnDesktop">
                        <Card>
                            <CardBody Style="padding: 1rem !important;">
                                <Row class="g-2">
                                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                        <div>
                                            <label class="form-label fw-bold">@L["Title"]</label>
                                            <div>
                                                <i class="bi bi-calendar-event text-primary"></i> @(ViewingCalendarEvent.Title ?? "-")
                                            </div>
                                        </div>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                        <div>
                                            <label class="form-label fw-bold">@L["EventType"]</label>
                                            <div>
                                                <i class="bi bi-tag text-info"></i> @L[$"Enum:EventType.{ViewingCalendarEvent.EventType}"]
                                            </div>
                                        </div>
                                    </Column>

                                    <Column ColumnSize="ColumnSize.Is12">
                                        <label class="form-label fw-bold">@L["Description"]</label>
                                        <div>@(ViewingCalendarEvent.Description ?? "-")</div>
                                    </Column>

                                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                        <label class="form-label fw-bold">@L["StartDate"]</label>
                                        <div>
                                            <i class="bi bi-calendar text-success"></i> @ViewingCalendarEvent.StartTime.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </Column>
                                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                        <label class="form-label fw-bold">@L["DueDate"]</label>
                                        <div>
                                            <i class="bi bi-calendar-check text-brand me-1"></i>@ViewingCalendarEvent.EndTime.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </Column>

                                    @if (!string.IsNullOrEmpty(ViewingCalendarEvent.Location))
                                    {
                                        <Column ColumnSize="ColumnSize.Is12">
                                            <label class="form-label fw-bold">@L["Location"]</label>
                                            <div>
                                                <i class="bi bi-geo-alt text-danger"></i> @ViewingCalendarEvent.Location
                                            </div>
                                        </Column>
                                    }

                                    @if (!string.IsNullOrEmpty(ViewingCalendarEvent.RelatedType))
                                    {
                                        <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                            <label class="form-label fw-bold">@L["RelatedType"]</label>
                                            <div>
                                                <Badge Color="Color.Info" TextColor="TextColor.White">
                                                    @L[$"Enum:RelatedType.{ViewingCalendarEvent.RelatedType}"]
                                                </Badge>
                                            </div>
                                        </Column>
                                    }
                                </Row>
                            </CardBody>
                        </Card>
                    </Column>

                    @* Column 4: Participants *@
                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is4.OnDesktop">
                        <Card Class="h-100">
                            <CardHeader>
                                <Heading Size="HeadingSize.Is6" Class="fw-bolder">
                                    <Icon Name="IconName.Users" Class="me-1" /> @L["Member"] (@ViewingEventParticipants.Count)
                                </Heading>
                            </CardHeader>
                            <CardBody Style="padding: 1rem !important; max-height: 350px; overflow-y: auto;">
                                @if (!ViewingEventParticipants.Any())
                                {
                                    <div class="text-center text-muted py-3">
                                        <small>@L["NoMembersFound"]</small>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var participant in ViewingEventParticipants)
                                    {
                                        <div class="d-flex align-items-center gap-2 mb-2 p-2 border rounded">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                                 style="width: 32px; height: 32px; flex-shrink: 0;">
                                                <span style="font-size: 0.75rem;">@GetParticipantInitial(participant)</span>
                                            </div>
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <div class="fw-bold text-truncate d-flex align-items-center justify-content-between" style="font-size: 0.875rem;">
                                                    <span>@participant.IdentityUser?.Surname @participant.IdentityUser?.Name</span>
                                                    <Badge Color="@GetParticipantResponseColor(participant.CalendarEventParticipant.ResponseStatus)" TextColor="TextColor.White" style="font-size: 0.7rem;">
                                                        @L[$"Enum:ParticipantResponse.{participant.CalendarEventParticipant.ResponseStatus}"]
                                                    </Badge>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </CardBody>
                        </Card>
                    </Column>
                </Row>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@(async () => await EventViewModal.Hide())">
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<!-- Project Detail Modal (same layout as workspace) -->
<Modal @ref="ProjectDetailModal" Class="project-detail-modal" Closed="OnProjectDetailModalClosed">
    <ModalContent Size="ModalSize.ExtraLarge" Centered="true">
        <ModalHeader>
            <ModalTitle>@L["ProjectDetail"]</ModalTitle>
            <CloseButton Clicked="CloseProjectDetailModalAsync" />
        </ModalHeader>
        <ModalBody Style="padding: 5px !important;">
            @if (ViewingProject != null)
            {
                <Tabs SelectedTab="@SelectedProjectDetailTab" SelectedTabChanged="OnSelectedProjectDetailTabChanged">
                    <Items>
                        <Tab Name="general">
                            <Icon Name="IconName.Info" Class="me-1" />
                            @L["Tab:GeneralInformation"]
                        </Tab>
                        <Tab Name="members">
                            <Icon Name="IconName.Users" Class="me-1" />
                            @L["Members"] (@ProjectMembersList.Count)
                        </Tab>
                        <Tab Name="tasks">
                            <Icon Name="IconName.List" Class="me-1" />
                            @L["Tasks"] (@ProjectTasksList.Count)
                        </Tab>
                    </Items>
                    <Content>
                        <TabPanel Name="general">
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Code"]</FieldLabel>
                                        <Text>@ViewingProject.Code</Text>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Name"]</FieldLabel>
                                        <Text>@ViewingProject.Name</Text>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Department"]</FieldLabel>
                                        <Text>@(ViewingProjectDepartmentName ?? "-")</Text>
                                    </Field>
                                </Column>
                            </Row>
                            @if (!string.IsNullOrWhiteSpace(ViewingProject.Description))
                            {
                                <Row>
                                    <Column ColumnSize="ColumnSize.Is12">
                                        <Field>
                                            <FieldLabel>@L["Description"]</FieldLabel>
                                            <Text>@ViewingProject.Description</Text>
                                        </Field>
                                    </Column>
                                </Row>
                            }
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["StartDate"]</FieldLabel>
                                        <Text>@(ViewingProject.StartDate.ToString("dd/MM/yyyy HH:mm") ?? "-")</Text>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["EndDate"]</FieldLabel>
                                        <Text>@(ViewingProject.EndDate.ToString("dd/MM/yyyy HH:mm") ?? "-")</Text>
                                    </Field>
                                </Column>
                            </Row>
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Status"]</FieldLabel>
                                        <Text> @L[$"Enum:ProjectStatus.{ViewingProject.Status}"]</Text>
                                    </Field>
                                </Column>
                            </Row>
                        </TabPanel>
                        <TabPanel Name="members">
                            @if (ProjectMembersList.Any())
                            {
                                <DataGrid TItem="ProjectMemberWithNavigationPropertiesDto"
                                          Data="ProjectMembersList"
                                          Responsive="true"
                                          ShowPager="false">
                                    <DataGridColumns>
                                        <DataGridColumn TItem="ProjectMemberWithNavigationPropertiesDto" Field="User.UserName" Caption="@L["UserName"]" />
                                        <DataGridColumn TItem="ProjectMemberWithNavigationPropertiesDto" Field="User.Email" Caption="@L["Email"]" />
                                        <DataGridColumn TItem="ProjectMemberWithNavigationPropertiesDto" Field="ProjectMember.MemberRole" Caption="@L["Role"]">
                                            <DisplayTemplate>
                                                 <span class="@($"badge bg-{EnumStatusColorHelper.GetProjectAssignmentRoleBackgroundColor(context.ProjectMember.MemberRole)}")">
                                                    @L[$"Enum:ProjectMemberRole.{context.ProjectMember.MemberRole}"]
                                                </span>
                                            </DisplayTemplate>
                                        </DataGridColumn>
                                    </DataGridColumns>
                                </DataGrid>
                            }
                            else
                            {
                                <Row Class="w-100 align-items-center" Style="height: 120px;">
                                    <Column>
                                        <Heading Size="HeadingSize.Is6" TextAlignment="TextAlignment.Center">@L["NoMembersFound"]</Heading>
                                    </Column>
                                </Row>
                            }
                        </TabPanel>
                        <TabPanel Name="tasks">
                            @if (ProjectTasksList.Any())
                            {
                                <DataGrid TItem="ProjectTaskWithNavigationPropertiesDto"
                                          Data="ProjectTasksList"
                                          Responsive="true"
                                          ShowPager="false">
                                    <DataGridColumns>
                                        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Code" Caption="@L["Code"]" />
                                        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Title" Caption="@L["Title"]" />
                                        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Status" Caption="@L["Status"]">
                                            <DisplayTemplate>
                                                @L[$"Enum:ProjectTaskStatus.{context.ProjectTask.Status}"]
                                            </DisplayTemplate>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.Priority" Caption="@L["Priority"]">
                                            <DisplayTemplate>
                                                @L[$"Enum:ProjectTaskPriority.{context.ProjectTask.Priority}"]
                                            </DisplayTemplate>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Field="ProjectTask.DueDate" Caption="@L["DueDate"]">
                                            <DisplayTemplate>
                                                @(context.ProjectTask.DueDate.ToString("dd/MM/yyyy") ?? "-")
                                            </DisplayTemplate>
                                        </DataGridColumn>
                                        <DataGridColumn TItem="ProjectTaskWithNavigationPropertiesDto" Caption="@L["Actions"]">
                                            <DisplayTemplate>
                                                <Button Color="Color.Primary" Size="Size.Small"
                                                    Clicked="@(() => OpenTaskDetailFromProjectModalAsync(context))">
                                                    <Icon Name="IconName.Eye" />
                                                </Button>
                                            </DisplayTemplate>
                                        </DataGridColumn>
                                    </DataGridColumns>
                                </DataGrid>
                            }
                            else
                            {
                                <Row Class="w-100 align-items-center" Style="height: 120px;">
                                    <Column>
                                        <Heading Size="HeadingSize.Is6" TextAlignment="TextAlignment.Center">@L["NoTasksFound"]</Heading>
                                    </Column>
                                </Row>
                            }
                        </TabPanel>
                    </Content>
                </Tabs>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Primary" Clicked="@(() => NavigationManager.NavigateTo($"/project-detail/{ViewingProject?.Id}"))">
                <Icon Name="IconName.Eye" Class="me-1" />
                @L["ViewDetail"]
            </Button>
            <Button Color="Color.Secondary" Clicked="CloseProjectDetailModalAsync">
                @L["Close"]
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<!-- Task Detail Modal -->
<ProjectTaskViewModal @ref="TaskDetailModal" OnViewPdfDocument="OpenPdfViewerModalForDocumentAsync" />

<!-- PDF Viewer Modal -->
<Modal @ref="PdfViewerModal" Class="pdf-viewer-modal" Size="ModalSize.ExtraLarge" Centered="true" Closed="OnPdfViewerModalClosed">
    <ModalContent>
        <ModalHeader>
            <ModalTitle>@L["DocumentPreview"]</ModalTitle>
            <CloseButton Clicked="@(async () => await PdfViewerModal.Hide())" />
        </ModalHeader>
        <ModalBody Class="pdf-viewer-modal-body">
            @if (IsPdfFile && !string.IsNullOrEmpty(PdfFileUrl))
            {
                <PdfViewerContainer Height="Height.Rem(35)">
                    <PdfViewerToolbar ShowDownloading="false" />
                    <PdfViewer Source="@PdfFileUrl" />
                </PdfViewerContainer>
            }
        </ModalBody>
    </ModalContent>
</Modal>

