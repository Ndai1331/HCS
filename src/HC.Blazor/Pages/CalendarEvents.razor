              </DataGridColumn>
                <DataGridColumn TItem="CalendarEventDto" Caption="@L["Actions"]" CellStyle="@((item) => "min-width: 150px")" Width="150px">
                    <DisplayTemplate>
                        <div class="d-flex gap-1">
