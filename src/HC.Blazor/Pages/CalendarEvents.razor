                }
                else if (SelectedCreateTab == "participants")
                {
                    <Button Color="Color.Primary" Clicked="FinishCreateWizardAsync">
                        <Icon Name="IconName.Check" Class="me-1" /> @L["Finish"]
                    </Button>
                }
@*//<suite-custom-code-block-6>*@
@*//</suite-custom-code-block-6>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-7>*@
