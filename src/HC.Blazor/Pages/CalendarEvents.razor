@page "/calendar-events"
@attribute [Authorize(HCPermissions.CalendarEvents.Default)]
@using HC.CalendarEvents
@using HC.CalendarEventParticipants
@using HC.Projects
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Blazorise.Scheduler
@using Blazorise.Extensions
@using Microsoft.Extensions.Logging
@using Volo.Abp.AspNetCore.Components.BlockUi
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using HC.ProjectTasks
@using Volo.Abp.Http.Client
@using HC.ProjectTaskAssignments
@using HC.ProjectTaskDocuments
@using HC.ProjectMembers
@using HC.Blazor.Components.ProjectTaskViewModal
@inherits HCComponentBase
@inject ICalendarEventsAppService CalendarEventsAppService
@inject IUiMessageService UiMessageService
@inject IBlockUiService BlockUiService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager
@inject IProjectsAppService ProjectsAppService
@inject IProjectMembersAppService ProjectMembersAppService
@inject IProjectTaskAssignmentsAppService ProjectTaskAssignmentsAppService
@inject IProjectTasksAppService ProjectTasksAppService
@inject IProjectTaskDocumentsAppService ProjectTaskDocumentsAppService

@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["CalendarEvents"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar" @key="IsListView">
</PageHeader>
<style>
    tr.table-row-selectable:hover {
        cursor: default;
    }

    /* Make select2 always full width */
    .hc-select2-full,
    .hc-select2-full > * {
        width: 100%;
    }

    .hc-select2-full .select2-container {
        width: 100% !important;
    }
</style>
@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
        <Row>
            <div class="col col-md-8 col-lg-10">
                <div class="mb-3">
                    <Form id="CalendarEventSearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="CalendarEventSearchForm" Clicked="GetCalendarEventsAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
                   <div class="col-md-4 col-lg-2">
            <div class="mb-3">
               <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                         Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                         <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
               </Button>
            </div>
       </div>
        <div style="display: @(!ShowAdvancedFilters ? "none" : "block")"  class="mt-3">
            <Row>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Title"]</FieldLabel>
                        <TextEdit Text="@Filter.Title" TextChanged="@OnTitleChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Description"]</FieldLabel>
                        <TextEdit Text="@Filter.Description" TextChanged="@OnDescriptionChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MinStartTime"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.StartTimeMin"
            DateChanged="@OnStartTimeMinChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MaxStartTime"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.StartTimeMax"
            DateChanged="@OnStartTimeMaxChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MinEndTime"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.EndTimeMin"
            DateChanged="@OnEndTimeMinChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["MaxEndTime"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.EndTimeMax"
            DateChanged="@OnEndTimeMaxChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["AllDay"]</FieldLabel>
                        <Select TValue="bool?"
		SelectedValue="@Filter.AllDay"
		SelectedValueChanged="@OnAllDayChangedAsync">
<SelectItem>@L["All"]</SelectItem>
<SelectItem Value="true">@L["Yes"]</SelectItem>
<SelectItem Value="false">@L["No"]</SelectItem>
</Select>                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["EventType"]</FieldLabel>
                        <Select TValue="EventType?" 
                                SelectedValue="@FilterEventType"
                                SelectedValueChanged="@OnFilterEventTypeChangedAsync">
                            <SelectItem>@L["All"]</SelectItem>
                            @foreach (var eventType in Enum.GetValues<EventType>())
                            {
                                <SelectItem TValue="EventType?" Value="@eventType">
                                    @L[$"Enum:EventType.{eventType}"]
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Location"]</FieldLabel>
                        <TextEdit Text="@Filter.Location" TextChanged="@OnLocationChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["RelatedType"]</FieldLabel>
                        <Select TValue="RelatedType?" 
                                SelectedValue="@FilterRelatedType"
                                SelectedValueChanged="@OnFilterRelatedTypeChangedAsync">
                            <SelectItem>@L["All"]</SelectItem>
                            @foreach (var relatedType in Enum.GetValues<RelatedType>())
                            {
                                <SelectItem TValue="RelatedType?" Value="@relatedType">
                                    @L[$"Enum:RelatedType.{relatedType}"]
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["RelatedId"]</FieldLabel>
                       @if (FilterRelatedType == RelatedType.PROJECT)
                        {
                            <div class="hc-select2-full">
                                <Select2 IdSelector="c => c.Id.ToString()"
                                         TextSelector="c => c.DisplayName"
                                         FilterFunction="GetProjectCollectionLookupAsync"
                                         GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                         Datasource="ProjectsCollection"
                                         Value="@SelectedFilterProject"
                                         OnValueChanged="@(() => OnFilterRelatedIdChangedAsync())"
                                         Cache="__MemoryCache"
                                         Multiselect="false" />
                            </div>                     
                        }
                        else if (FilterRelatedType == RelatedType.TASK)
                        {
                            <div class="hc-select2-full">
                                <Select2 IdSelector="c => c.Id"
                                         TextSelector="c => c.DisplayName"
                                         FilterFunction="GetProjectTaskCollectionLookupAsync"
                                         GetElementById="async (items, id, token) => items.Where(x => x.Id == id).FirstOrDefault()!"
                                         Datasource="ProjectTasksCollection"
                                         Value="@SelectedFilterProjectTask"
                                         OnValueChanged="@(() => OnFilterRelatedIdChangedAsync())"
                                         Cache="__MemoryCache"
                                         Multiselect="false" />
                            </div>                     
                        }
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3">
                    <Field>
                        <FieldLabel>@L["Visibility"]</FieldLabel>
                        <Select TValue="EventVisibility?" 
                                SelectedValue="@FilterVisibility"
                                SelectedValueChanged="@OnFilterVisibilityChangedAsync">
                            <SelectItem>@L["All"]</SelectItem>
                            @foreach (var visibility in Enum.GetValues<EventVisibility>())
                            {
                                <SelectItem TValue="EventVisibility?" Value="@visibility">
                                    @L[$"Enum:EventVisibility.{visibility}"]
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                </Column>
            </Row>
@*//<suite-custom-code-block-2>*@
@*//</suite-custom-code-block-2>*@
        </div>
        </Row>
@*//<suite-custom-code-block-3>*@
@*//</suite-custom-code-block-3>*@
    </CardBody>
</Card>
@* ************************* DATA GRID ************************* *@
@if (IsListView)
{
<Card>
    <CardBody>        
        <Div  Visibility="@(SelectedCalendarEvents.Any() ? Visibility.Visible : Visibility.Invisible)"
              class="d-flex justify-content-between align-items-center mb-2">
              <p class="lead mb-0">
                @if (AllCalendarEventsSelected)
                {
                    @L["AllItemsAreSelected", TotalCount]
                }
                else
                {
                    @if (SelectedCalendarEvents.Count > 1)
                    {
                        @L["NumberOfItemsOnThisPageAreSelected", SelectedCalendarEvents.Count]
                    }
                    else
                    {
                        @L["OneItemOnThisPageIsSelected"]
                    }
                }
              </p>
            <div>
                @if ((SelectedCalendarEvents.Count == PageSize || SelectedCalendarEvents.Count == CalendarEventList.Count) && TotalCount > SelectedCalendarEvents.Count)
                {
                    if (!AllCalendarEventsSelected)
                    {
                        <Button Clicked="SelectAllItems" Class="mx-1 btn-outline-secondary">@L["SelectAllItems", TotalCount]</Button>
                    }
                    else
                    {
                        <Button Clicked="ClearSelection" Class="mx-1 btn-outline-secondary">@L["ClearSelection"]</Button>
                    }
                }
                <Button Color="Color.Danger" Class="mx-1" Size="Size.Medium" Clicked="DeleteSelectedCalendarEventsAsync">
                    <Icon Name="@IconName.Delete" /> @L["Delete"]
                </Button>
            </div>
        </Div>
        <hr Visibility="@(SelectedCalendarEvents.Any() ? Visibility.Visible : Visibility.Invisible)"
            class="my-1 mx-0" />
        <DataGrid TItem="CalendarEventDto"
                  @ref="DataGridRef"
                  Data="CalendarEventList"
                  SelectionMode="DataGridSelectionMode.Multiple"
                  SelectedRows="SelectedCalendarEvents"
                  RowSelectable="RowSelectableHandler"
                  SelectedRowsChanged="SelectedCalendarEventRowsChanged"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize"
                  Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                       <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>   
            <DataGridColumns>
                @if (CanDeleteCalendarEvent && CalendarEventList.Any())
                {
                    <DataGridMultiSelectColumn TItem="CalendarEventDto" DisplayOrder="-1" Width="30px"></DataGridMultiSelectColumn>
                }
              <DataGridColumn TItem="CalendarEventDto"
                      Field="Title"
                      Caption="@L["Title"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="Description"
                      Caption="@L["Description"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="StartTime"
                      Caption="@L["StartTime"]"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px">
                  <DisplayTemplate>
                        @context.StartTime.ToString("dd/MM/yyyy HH:mm")
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="EndTime"
                      Caption="@L["EndTime"]"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px">
                  <DisplayTemplate>
                        @context.EndTime.ToString("dd/MM/yyyy HH:mm")
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="AllDay"
                      Caption="@L["AllDay"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                    <DisplayTemplate>
                        @if (context.AllDay)
                        {
                            <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                        }
                        else
                        {
                            <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                        }
                    </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="EventType"
                      Caption="@L["EventType"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                  <DisplayTemplate>
                      @if (Enum.TryParse<EventType>(context.EventType, out var eventType))
                      {
                          @L[$"Enum:EventType.{eventType}"]
                      }
                      else
                      {
                          @context.EventType
                      }
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="Location"
                      Caption="@L["Location"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="RelatedType"
                      Caption="@L["RelatedType"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                  <DisplayTemplate>
                      @if (Enum.TryParse<RelatedType>(context.RelatedType, out var relatedType))
                      {
                          @L[$"Enum:RelatedType.{relatedType}"]
                      }
                      else
                      {
                          @context.RelatedType
                      }
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="RelatedId"
                      Caption="@L["RelatedId"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                  <DisplayTemplate>
                      @GetRelatedIdDisplayCode(context)
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Field="Visibility"
                      Caption="@L["Visibility"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                  <DisplayTemplate>
                      @if (Enum.TryParse<EventVisibility>(context.Visibility, out var visibility))
                      {
                          @L[$"Enum:EventVisibility.{visibility}"]
                      }
                      else
                      {
                          @context.Visibility
                      }
                  </DisplayTemplate>
              </DataGridColumn>
              <DataGridColumn TItem="CalendarEventDto"
                      Caption="@L["NumberOfParticipants"]"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px">
                  <DisplayTemplate>
                      @(_participantCountCache.TryGetValue(context.Id, out var count) ? count : 0)
                  </DisplayTemplate>
              </DataGridColumn>
                <DataGridColumn TItem="CalendarEventDto" Caption="@L["Actions"]" CellStyle="@((item) => "min-width: 150px")" Width="150px">
                    <DisplayTemplate>
                        <div class="d-flex gap-1">
                            @if (CanEditCalendarEvent)
                            {
                                <Button Color="Color.Primary" 
                                    Outline Size="Size.Small" 
                                    Clicked="@(() => NavigateToCalendarEventDetail(context))">
                                    <Icon Name="IconName.Edit" />
                                </Button>   
                            }
                            @if (CanDeleteCalendarEvent)
                            {
                                <Button Color="Color.Danger" 
                                    Outline Size="Size.Small" 
                                    Clicked="@(() => DeleteCalendarEventWithConfirmationAsync(context))">
                                    <Icon Name="IconName.Delete" />
                                </Button>
                            }
                        </div>
@*//<suite-custom-code-block-4>*@
@*//</suite-custom-code-block-4>*@
                    </DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>
}
@* ************************* SCHEDULER ************************* *@
@if (!IsListView)
{
<Card>
    <CardBody>
     <Scheduler TItem="Appointment"
                   Date="@SelectedSchedulerDate"
                   DateChanged="@(async (DateOnly value) => {
                        SelectedSchedulerDate = value;
                        RebuildToolbar();
                        await GetCalendarEventsAsync();
                     })"
                   Data="@Appointments"
                   SelectedView="@SelectedSchedulerView"
                   ShowToolbar="false"
                   Localizers="@SchedulerLocalizers"
                   EditItemClicked="@(async (SchedulerItemClickedEventArgs<Appointment> args) => await OnSchedulerItemClicked(args))"
                   DayClicked="@(async (DateTime clickedDate) => await OnSchedulerDayClicked(clickedDate))"
                   IdField="Id"
                   StartField="Start"
                   EndField="End"
                   TitleField="Title"
                   DescriptionField="Description"
                   AllDayField="AllDay">
            <SchedulerToolbar />
            <SchedulerViews>
                <SchedulerMonthView StartTime="@SchedulerStartTime" 
                                    EndTime="@SchedulerEndTime" 
                                    WorkDayStart="@SchedulerWorkDayStart" 
                                    WorkDayEnd="@SchedulerWorkDayEnd" />
            </SchedulerViews>
        </Scheduler> 

    </CardBody>
</Card>
}
@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateCalendarEventModal" Closing="@CreateCalendarEventModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
@*//<suite-custom-code-block-5>*@
@*//</suite-custom-code-block-5>*@
        <Form id="CreateCalendarEventForm">
            <ModalHeader>
                <ModalTitle>@L["NewCalendarEvent"]</ModalTitle>
                <CloseButton Clicked="CloseCreateCalendarEventModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Tabs SelectedTab="@SelectedCreateTab" SelectedTabChanged="@OnSelectedCreateTabChanged">
                    <Items>
                        <Tab Name="general">
                            <Icon Name="IconName.Info" Class="me-1" />
                            @L["Tab:GeneralInformation"]
                        </Tab>
                        <Tab Name="participants" Disabled="@(!IsCreateWizardGeneralSaved)">
                            <Icon Name="IconName.Users" Class="me-1" />
                            @L["Tab:Participants"]
                        </Tab>
                    </Items>
                    <Content>
                        <TabPanel Name="general">
                            @* Manual validation is used (see ValidateCreateGeneralInformation). *@
                            @if (!string.IsNullOrWhiteSpace(CreateGeneralValidationErrorKey))
                            {
                                <Alert Color="Color.Danger">
                                    <AlertMessage>@L["NotificationError"]!</AlertMessage>
                                    <AlertDescription>@L[CreateGeneralValidationErrorKey]</AlertDescription>
                                </Alert>
                            }
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Title"] *</FieldLabel>
                                        <TextEdit Text="@NewCalendarEvent.Title" 
                                                TextChanged="@((string value) => { NewCalendarEvent.Title = value; CreateFieldErrors.Remove("Title"); })"
                                                Autofocus="true"
                                                Disabled="@IsCreateWizardGeneralSaved"
                                                Style="@(HasCreateFieldError("Title") ? "border-color: #dc3545;" : "")">
                                        </TextEdit>
                                        @if (HasCreateFieldError("Title"))
                                        {
                                            <div class="invalid-feedback d-block">@GetCreateFieldError("Title")</div>
                                        }
                                    </Field>
                                </Column>
                            </Row>
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is12.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Description"]</FieldLabel>
                                        <MemoEdit @bind-Text="@NewCalendarEvent.Description" Disabled="@IsCreateWizardGeneralSaved">
                                        </MemoEdit>
                                    </Field>
                                </Column>
                            </Row>
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["StartTime"]</FieldLabel>
                                        <Addons>
                                            <Addon AddonType="AddonType.Body">
                                                <DatePicker TValue="DateTime"
                                                            InputMode="DateInputMode.DateTime"
                                                            Date="@NewCalendarEvent.StartTime"
                                                            DateChanged="@(v => NewCalendarEvent.StartTime = v)"
                                                    Placeholder="@string.Empty"
                                                    DisplayFormat="dd/MM/yyyy HH:mm"
                                                    InputFormat="dd/MM/yyyy HH:mm"
                                                    Disabled="@IsCreateWizardGeneralSaved"
                                                    @ref="@NewCalendarEventStartTimeDatePicker" />
                                            </Addon>
                                            <Addon AddonType="AddonType.End">
                                                <Button Color="Color.Light" Disabled="@IsCreateWizardGeneralSaved" Clicked="@(() => NewCalendarEventStartTimeDatePicker?.ToggleAsync())">
                                                    <Icon Name="IconName.CalendarDay" />
                                                </Button>
                                            </Addon>
                                        </Addons>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is5.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["EndTime"]</FieldLabel>
                                        <Addons>
                                            <Addon AddonType="AddonType.Body">
                                                <DatePicker TValue="DateTime"
                                                            InputMode="DateInputMode.DateTime"
                                                            Date="@NewCalendarEvent.EndTime"
                                                            DateChanged="@(v => NewCalendarEvent.EndTime = v)"
                                                            Placeholder="@string.Empty"
                                                            DisplayFormat="dd/MM/yyyy HH:mm"
                                                            InputFormat="dd/MM/yyyy HH:mm"
                                                            Disabled="@IsCreateWizardGeneralSaved"
                                                            @ref="@NewCalendarEventEndTimeDatePicker" />
                                            </Addon>
                                            <Addon AddonType="AddonType.End">
                                                <Button Color="Color.Light" Disabled="@IsCreateWizardGeneralSaved" Clicked="@(() => NewCalendarEventEndTimeDatePicker?.ToggleAsync())">
                                                    <Icon Name="IconName.CalendarDay" />
                                                </Button>
                                            </Addon>
                                        </Addons>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is2.OnDesktop" Style="padding-top: 32px;">
                                    <Field>
                                        <Check TValue="bool" 
                                            Checked="@NewCalendarEvent.AllDay"
                                            CheckedChanged="@((bool value) => { NewCalendarEvent.AllDay = value; OnAllDayChanged(value); })"
                                            Disabled="@IsCreateWizardGeneralSaved">@L["AllDay"]</Check>
                                    </Field>
                                </Column>
                            </Row>
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["EventType"] *</FieldLabel>
                                        <Select TValue="EventType" 
                                                SelectedValue="@NewCalendarEventEventType"
                                                SelectedValueChanged="@((EventType value) => { NewCalendarEventEventType = value; })"
                                                Disabled="@IsCreateWizardGeneralSaved">
                                            <ChildContent>
                                                @foreach (var eventType in Enum.GetValues<EventType>())
                                                {
                                                    <SelectItem TValue="EventType" Value="@eventType">
                                                        @L[$"Enum:EventType.{eventType}"]
                                                    </SelectItem>
                                                }
                                            </ChildContent>
                                        </Select>
                                    </Field>
                                </Column>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["Location"]</FieldLabel>
                                        <TextEdit @bind-Text="@NewCalendarEvent.Location" Disabled="@IsCreateWizardGeneralSaved">
                                        </TextEdit>
                                    </Field>
                                </Column>
                            </Row>
                            <Row>
                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                    <Field>
                                        <FieldLabel>@L["RelatedType"] *</FieldLabel>
                                        <Select TValue="RelatedType" 
                                                SelectedValue="@NewCalendarEventRelatedType"
                                                SelectedValueChanged="@((RelatedType value) => { NewCalendarEventRelatedType = value; SelectedNewProject.Clear(); SelectedNewProjectTask.Clear(); CreateFieldErrors.Remove("RelatedId"); InvokeAsync(StateHasChanged); })"
                                                Disabled="@IsCreateWizardGeneralSaved">
                                            <ChildContent>
                                                @foreach (var relatedType in Enum.GetValues<RelatedType>())
                                                {
                                                    <SelectItem TValue="RelatedType" Value="@relatedType">
                                                        @L[$"Enum:RelatedType.{relatedType}"]
                                                    </SelectItem>
                                                }
                                            </ChildContent>
                                        </Select>
                                    </Field>
                                </Column>
                                @if (NewCalendarEventRelatedType == RelatedType.PROJECT)
                                {
                                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                        <Field>
                                            <FieldLabel>@L["Project"] *</FieldLabel>
                                            <div class="hc-select2-full" style="@(HasCreateFieldError("RelatedId") ? "border: 1px solid #dc3545; border-radius: 0.25rem; padding: 2px;" : "")">
                                                <Select2 IdSelector="c => c.Id.ToString()"
                                                        TextSelector="c => c.DisplayName"
                                                        FilterFunction="GetProjectCollectionLookupAsync"
                                                        GetElementById="async (items, id, token) => items.Where(x => x.Id.ToString() == id).FirstOrDefault()!"
                                                        Datasource="ProjectsCollection"
                                                        Value="@SelectedNewProject"
                                                        OnValueChanged="@(() => { OnNewProjectChanged(); })"
