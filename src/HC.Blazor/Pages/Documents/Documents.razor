@* ************************* DATA GRID ************************* *@
<Card>
    <CardBody>        
        <Div  Visibility="@(SelectedDocuments.Any() ? Visibility.Visible : Visibility.Invisible)"
              class="d-flex justify-content-between align-items-center mb-2">
              <p class="lead mb-0">
                @if (AllDocumentsSelected)
                {
                    @L["AllItemsAreSelected", TotalCount]
                }
                else
                {
                    @if (SelectedDocuments.Count > 1)
                    {
                        @L["NumberOfItemsOnThisPageAreSelected", SelectedDocuments.Count]
                    }
                    else
                    {
                        @L["OneItemOnThisPageIsSelected"]
                    }
                }
              </p>
            <div>
                @if ((SelectedDocuments.Count == PageSize || SelectedDocuments.Count == DocumentList.Count) && TotalCount > SelectedDocuments.Count)
                {
                    if (!AllDocumentsSelected)
                    {
                        <Button Clicked="SelectAllItems" Class="mx-1 btn-outline-secondary">@L["SelectAllItems", TotalCount]</Button>
                    }
                    else
                    {
                        <Button Clicked="ClearSelection" Class="mx-1 btn-outline-secondary">@L["ClearSelection"]</Button>
                    }
                }
                <Button Color="Color.Danger" Class="mx-1" Size="Size.Medium" Clicked="DeleteSelectedDocumentsAsync">
                    <Icon Name="@IconName.Delete" /> @L["Delete"]
                </Button>
            </div>
        </Div>
        <hr Visibility="@(SelectedDocuments.Any() ? Visibility.Visible : Visibility.Invisible)"
            class="my-1 mx-0" />
        <DataGrid TItem="DocumentWithNavigationPropertiesDto"
                    @ref="DataGridRef"
                    Data="DocumentList"
                    Loading="@IsLoading"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    SelectedRows="SelectedDocuments"
                    RowSelectable="RowSelectableHandler"
                    SelectedRowsChanged="SelectedDocumentRowsChanged"
                    ReadData="OnDataGridReadAsync"
                    TotalItems="TotalCount"
                    ShowPager="true"
                    Responsive="true"
                    PageSize="PageSize"
                    Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>   
            <DataGridColumns>
                @if (CanDeleteDocument && DocumentList.Any())
                {
                    <DataGridMultiSelectColumn TItem="DocumentWithNavigationPropertiesDto" DisplayOrder="-1" Width="30px"></DataGridMultiSelectColumn>
                }
                
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto" Caption="@L["Actions"]" Width="120px">
                    <DisplayTemplate>
                        <Div Class="d-flex gap-1">
                            @if (CanEditDocument)
                            {

                                <Button
                                    @onclick="@(() => OpenDocumentDetailAsync(context.Document.Id))"
                                    Color="Color.Secondary"
                                    Outline
                                    Size="Size.Small"
                                    Class="mb-1">
                                    <Icon Name="IconName.Edit" />
                                   </Button>
                            }
                            @if (CanDeleteDocument)
                            {
                                <Button
                                    @onclick="@(async () => await ShowDeleteOrRevokeModalAsync(context))"
                                    Color="Color.Danger"
                                    Outline
                                    Size="Size.Small"
                                    Class="mb-1">
                                    <Icon Name="IconName.Delete" />
                                   </Button>
                            }
                        </Div>
                         
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto" 
                Caption="@L["SendAndSign"]" 
                CellStyle="@((item) => "min-width: 150px")"
                Width="150px">
                    <DisplayTemplate>
                        <Div Class="d-flex gap-1">
                            @if (CanSendDocument)
                            {
                                <Button
                                    @onclick="@(async () => await ShowSendDocumentModalAsync(context))"
                                    Color="Color.Success"
                                    Outline
                                    Size="Size.Small"
                                    Class="mb-1">
                                    <Icon Name="IconName.Send" />
                                </Button>
                            }
                            @if (CanSubmitForSigning)
                            {
                                <Button
                                    @onclick="@(() => OpenDocumentDetailAsync(context.Document.Id))"
                                    Color="Color.Warning"
                                    Outline
                                    Size="Size.Small"
                                    Class="mb-1">
                                    <Icon Name="IconName.CheckSquare" />
                                </Button>
                            }
                        </Div>
                    </DisplayTemplate>
                </DataGridColumn>

                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Document.No"
                        Caption="@L["Title"]"
                        CellStyle="@((item) => "min-width: 300px; max-width: 350px")"
                        Width="300px">
                    <DisplayTemplate>
                        <div class="row">
                            <div class="col">
                              <h5 class="card-title question-title pb-2">
                                @context.Document.Title
                              </h5>
                              <div class="d-flex pb-2 mb-2">
                                <p class="mb-0">
                                    <small class="text-muted">
                                        <span>#@context.Document.No</span> | @context.Document.StorageNumber
                                    </small>
                                </p>
                              </div>
                            </div>
                        </div>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Status.Name"
                        Caption="@L["Status"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                    <DisplayTemplate>
                        <small class="badge bg-primary me-1"> @context.Status?.Name</small>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Document.IncommingDate"
                        Caption="@L["IncommingDate"]"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px">
                    <DisplayTemplate>
                            @(context.Document.IncommingDate.ToShortDateString()  + " " + context.Document.IncommingDate.ToShortTimeString())
                    </DisplayTemplate> 
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Type.Name"
                        Caption="@L["Type"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                    <DisplayTemplate>
                        <small class="badge bg-secondary me-1"> @context.Type?.Name</small>
                    </DisplayTemplate>
                </DataGridColumn>

                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Field.Name"
                        Caption="@L["Field"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Unit.Name"
                        Caption="@L["Unit"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="UrgencyLevel.Name"
                        Caption="@L["UrgencyLevel"]"
                        CellStyle="@((item) => "min-width: 180px")"
                        Width="180px">
                    <DisplayTemplate>
                        <small class="badge bg-warning me-1"> @context.UrgencyLevel?.Name</small>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="SecrecyLevel.Name"
                        Caption="@L["SecrecyLevel"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                    <DisplayTemplate>
                        <small class="badge bg-danger me-1"> @context.SecrecyLevel?.Name</small>
                    </DisplayTemplate>
                </DataGridColumn>
                @* <DataGridColumn TItem="DocumentWithNavigationPropertiesDto"
                        Field="Workflow.Name"
                        Caption="@L["Workflow"]"
                        CellStyle="@((item) => "min-width: 150px")"
                        Width="150px">
                </DataGridColumn> *@
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>





<Modal @ref="SendDocumentModal" Closing="@SendDocumentModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>@L["SendDocument"]</ModalTitle>
            <CloseButton Clicked="CloseSendDocumentModalAsync" />
        </ModalHeader>
    <ModalBody>
        <Form>
            @* Thông tin cơ bản của file được gửi *@
            @if (DocumentToSend != null && DocumentToSend.Document != null)
            {
                <Alert Color="Color.Info" Visible="true" Class="mb-3">
                    <AlertMessage>
                        <i class="bi bi-file-earmark-text me-1"></i>@L["Title"]:
                    </AlertMessage>
                    <AlertDescription>
                        @DocumentToSend.Document.Title - #@DocumentToSend.Document.No
                    </AlertDescription>
                </Alert>
            }
            @* cá nhân hoặc phòng ban  *@
            <Field>
                <FieldLabel>@L["SendTo"] </FieldLabel>
                <Select TValue="bool" @bind-SelectedValue="@IsPersonal">
                    <SelectItem Value="true">@L["Personal"]</SelectItem>
                    <SelectItem Value="false">@L["Department"]</SelectItem>
                </Select>
            </Field>

            @* người nhận *@
            @if (IsPersonal)
            {
                <Field>
                    <FieldLabel>@L["Recipients"] </FieldLabel>
                    @if (RecipientsCollection != null)
                    {
                        <Select2 TItem="LookupDto<Guid>"
                                TSource="IReadOnlyList<LookupDto<Guid>>"
                                Datasource="RecipientsCollection"
                                IdSelector="c => c.Id.ToString()"
                                TextSelector="c => c.DisplayName"
                                FilterFunction="GetRecipientsLookupAsync"
                                GetElementById="async (items, id, token) =>
                                    items?.FirstOrDefault(x => x.Id.ToString() == id)"
                                Value="SelectedRecipients"
                                ValueChanged="@((List<LookupDto<Guid>> v) => SelectedRecipients = v ?? new List<LookupDto<Guid>>())"
                                Cache="__MemoryCache"
                                Multiselect="true" />
                    }
                </Field>
            }
            else
            {
                @if (DepartmentTreeViews == null || !DepartmentTreeViews.Any())
                {
                    @L["NoDepartmentDefinedYet"]
                }
                else
                {
                    <TreeView 
                            Items="DepartmentTreeViews"
                            GetChildren="@(item => item.Children)"
                            HasChildren="@(item => item.HasChildren)"
                            AllowSelection="true"
                            @bind-SelectedItems="SelectedDepartments">
                        <ItemTemplate>
                            <div @onclick="() => { SelectedItem = (SelectedItem != context.Item) ? context.Item : new DepartmentTreeView(); }" 
                                style="background-color: @(SelectedItem?.Id == context.Item.Id ? "Highlight" : "inherit")">
                                &nbsp;<i class="fas fa-person-shelter"></i>&nbsp;
                                @context.Item.Name
                            </div>
                        </ItemTemplate>
                    </TreeView>
                }
            }
        </Form>
    </ModalBody>
    <ModalFooter>
        <Button Color="Color.Secondary" Clicked="CloseSendDocumentModalAsync">@L["Cancel"]</Button>
        <Button Color="Color.Primary" Clicked="SendDocumentAsync">@L["Send"]</Button>
    </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="DeleteOrRevokeModal" Closing="@DeleteOrRevokeModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Default">
        <ModalHeader>
            <ModalTitle>@L["DeleteOrRevokeDocument"]</ModalTitle>
            <CloseButton Clicked="CloseDeleteOrRevokeModalAsync" />
        </ModalHeader>
    <ModalBody>
        <Form>
            @* Thông tin văn bản *@
            @if (DocumentToDeleteOrRevoke != null && DocumentToDeleteOrRevoke.Document != null)
            {
                <Alert Color="Color.Warning" Visible="true" Class="mb-3">
                    <AlertMessage>
                        <i class="bi bi-exclamation-triangle me-1"></i>@L["Warning"]:
                    </AlertMessage>
                    <AlertDescription>
                        @L["DeleteOrRevokeDocumentWarning"]
                    </AlertDescription>
                </Alert>
                <div class="mb-3">
                    <strong>@L["Title"]:</strong> @DocumentToDeleteOrRevoke.Document.Title - #@DocumentToDeleteOrRevoke.Document.No
                </div>
            }
            
            @* Lựa chọn hành động *@
            <Field>
                <FieldLabel>@L["SelectAction"]</FieldLabel>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="deleteOrRevoke" id="deleteOption" @onchange="@(() => DeleteOrRevokeOption = "delete")" checked="@(DeleteOrRevokeOption == "delete")">
                    <label class="form-check-label" for="deleteOption">
                        <strong>@L["DeleteDocument"]</strong>
                        <small class="d-block text-muted">@L["DeleteDocumentDescription"]</small>
                    </label>
                </div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="radio" name="deleteOrRevoke" id="revokeOption" @onchange="@(() => DeleteOrRevokeOption = "revoke")" checked="@(DeleteOrRevokeOption == "revoke")">
                    <label class="form-check-label" for="revokeOption">
                        <strong>@L["RevokeDocument"]</strong>
                        <small class="d-block text-muted">@L["RevokeDocumentDescription"]</small>
                    </label>
                </div>
            </Field>
        </Form>
    </ModalBody>
    <ModalFooter>
        <Button Color="Color.Secondary" Clicked="CloseDeleteOrRevokeModalAsync">@L["Cancel"]</Button>
        <Button Color="Color.Danger" Clicked="ConfirmDeleteOrRevokeAsync">@L["Confirm"]</Button>
    </ModalFooter>
    </ModalContent>
</Modal>



<style>
    input[type="checkbox"] {
        border-radius: 0.25rem;
        border-width: 1px;
        border-color: #e8eef3 !important;
        --bs-form-check-bg: #f0f4f7;
        flex-shrink: 0;
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.125em;
        vertical-align: top;
        appearance: none;
        background-color: var(--bs-form-check-bg);
        background-image: var(--bs-form-check-bg-image);
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        border: 1px solid #f0f4f7;
        print-color-adjust: exact;
    }
    input[type="checkbox"]:checked 
    {
        --bs-form-check-bg-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='none' stroke='%23fff' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/%3e%3c/svg%3e");
        border-color: #f72585 !important;
        background-color: #f72585 !important;
    }
</style>
