@page "/document-assignments"
@attribute [Authorize(HCPermissions.DocumentAssignments.Default)]
@using HC.DocumentAssignments
@using HC.Localization
@using HC.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using HC.Permissions
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@inherits HCComponentBase
@inject IDocumentAssignmentsAppService DocumentAssignmentsAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject IRemoteServiceConfigurationProvider RemoteServiceConfigurationProvider
@inject NavigationManager NavigationManager
@* ************************* PAGE HEADER ************************* *@
<PageHeader Title="@L["DocumentAssignments"]" BreadcrumbItems="BreadcrumbItems" Toolbar="Toolbar">
</PageHeader>
<style>
    tr.table-row-selectable:hover {
        cursor: default;
    }
</style>
@* ************************* SEARCH ************************* *@
<Card>
    <CardBody>
@*//<suite-custom-code-block-1>*@
@*//</suite-custom-code-block-1>*@
        <Row>
            <div class="col col-md-8 col-lg-10">
                <div class="mb-0">
                    <Form id="DocumentAssignmentSearchForm">
                        <Addons>
                            <Addon AddonType="AddonType.Body">
                                <TextEdit @bind-Text="@Filter.FilterText"
                                        Autofocus="true"
                                        Placeholder="@L["Search"]">
                                </TextEdit>
                            </Addon>
                            <Addon AddonType="AddonType.End">
                                <SubmitButton Form="DocumentAssignmentSearchForm" Clicked="GetDocumentAssignmentsAsync">
                                    <Icon Name="IconName.Search" Class="me-1"></Icon>@L["Search"]
                                </SubmitButton>
                            </Addon>
                        </Addons>
                    </Form>
                </div>
            </div>
                   <div class="col-md-4 col-lg-2">
            <div class="mb-0">
               <Button Color="Color.Primary" Outline Style="width:100%" id="AdvancedFilterSectionToggler"
                         Clicked="@(() => ShowAdvancedFilters = !ShowAdvancedFilters)">@L["Filters"]
                         <i aria-hidden="true" class="fa ms-1 @(!ShowAdvancedFilters ? "fa-angle-down" : "fa-angle-up")"></i>
               </Button>
            </div>
       </div>
        <div style="display: @(!ShowAdvancedFilters ? "none" : "block")"  class="mt-3">
            <Row>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MinStepOrder"]</FieldLabel>
                        <NumericEdit TValue="int?" 
             Value="@Filter.StepOrderMin"
             ValueChanged="@OnStepOrderMinChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MaxStepOrder"]</FieldLabel>
                        <NumericEdit TValue="int?" 
             Value="@Filter.StepOrderMax"
             ValueChanged="@OnStepOrderMaxChangedAsync" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["ActionType"]</FieldLabel>
                        <Select 
                        TValue="string"
		SelectedValue="@(string.IsNullOrEmpty(Filter.ActionType) ? string.Empty : Filter.ActionType)"
		SelectedValueChanged="@OnActionTypeChangedAsync" >
                            <SelectItem Value="@string.Empty">@L["All"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentActionType.PROCESS">@L["Process"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentActionType.SIGN">@L["Sign"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentActionType.VIEW">@L["View"]</SelectItem>
                        </Select>                  
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["Status"]</FieldLabel>
                        <Select TValue="string"
		SelectedValue="@(string.IsNullOrEmpty(Filter.Status) ? string.Empty : Filter.Status)"
		SelectedValueChanged="@OnStatusChangedAsync">
                            <SelectItem Value="@string.Empty">@L["All"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentStatus.PENDING">@L["Pending"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentStatus.DONE">@L["Done"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentStatus.REJECTED">@L["Rejected"]</SelectItem>
                            <SelectItem Value="DocumentAssignmentStatus.REVOKE">@L["Revoked"]</SelectItem>
                        </Select>                  
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MinAssignedAt"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.AssignedAtMin"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnAssignedAtMinChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MaxAssignedAt"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.AssignedAtMax"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnAssignedAtMaxChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MinProcessedAt"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.ProcessedAtMin"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnProcessedAtMinChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["MaxProcessedAt"]</FieldLabel>
                        <DatePicker TValue="DateTime?"
            InputMode="DateInputMode.Date"
            Date="@Filter.ProcessedAtMax"
            DisplayFormat="dd/MM/yyyy"
            InputFormat="dd/MM/yyyy"
            DateChanged="@OnProcessedAtMaxChangedAsync"
            Placeholder="@string.Empty" />                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["IsCurrent"]</FieldLabel>
                        <Select TValue="string"
		SelectedValue="@IsCurrentFilterValue"
		SelectedValueChanged="@OnIsCurrentChangedAsync">
<SelectItem Value="@string.Empty">@L["All"]</SelectItem>
<SelectItem Value="true">@L["Yes"]</SelectItem>
<SelectItem Value="false">@L["No"]</SelectItem>
</Select>                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["Document"]</FieldLabel>
                        <Select TValue="Guid?"
		SelectedValue="@Filter.DocumentId"
		SelectedValueChanged="@OnDocumentIdChangedAsync">
<SelectItem TValue="Guid?" Value="@((Guid?)null)">@L["All"]</SelectItem>
@foreach(var item in DocumentsCollection)
{
	<SelectItem TValue="Guid" Value="@item.Id">
		@item.DisplayName
	</SelectItem>
}
</Select>                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["WorkflowStepTemplate"]</FieldLabel>
                        <Select TValue="Guid?"
		SelectedValue="@Filter.WorkflowStepTemplateId"
		SelectedValueChanged="@OnWorkflowStepTemplateIdChangedAsync">
<SelectItem TValue="Guid?" Value="@((Guid?)null)">@L["All"]</SelectItem>
@foreach(var item in WorkflowStepTemplatesCollection)
{
	<SelectItem TValue="Guid?" Value="@item.Id">
		@item.DisplayName
	</SelectItem>
}
</Select>                       
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is3.OnDesktop.Is6.OnMobile">
                    <Field>
                        <FieldLabel>@L["IdentityUser"]</FieldLabel>
                        <Select TValue="Guid?"
		SelectedValue="@Filter.ReceiverUserId"
		SelectedValueChanged="@OnReceiverUserIdChangedAsync">
<SelectItem TValue="Guid?" Value="@((Guid?)null)">@L["All"]</SelectItem>
@foreach(var item in IdentityUsersCollection)
{
	<SelectItem TValue="Guid" Value="@item.Id">
		@item.DisplayName
	</SelectItem>
}
</Select>                       
                    </Field>
                </Column>
            </Row>
        </div>
        </Row>
    </CardBody>
</Card>
<Card>
    <CardBody>        
        <Div  Visibility="@(SelectedDocumentAssignments.Any() ? Visibility.Visible : Visibility.Invisible)"
              class="d-flex justify-content-between align-items-center mb-2">
              <p class="lead mb-0">
                @if (AllDocumentAssignmentsSelected)
                {
                    @L["AllItemsAreSelected", TotalCount]
                }
                else
                {
                    @if (SelectedDocumentAssignments.Count > 1)
                    {
                        @L["NumberOfItemsOnThisPageAreSelected", SelectedDocumentAssignments.Count]
                    }
                    else
                    {
                        @L["OneItemOnThisPageIsSelected"]
                    }
                }
              </p>
            <div>
                @if ((SelectedDocumentAssignments.Count == PageSize || SelectedDocumentAssignments.Count == DocumentAssignmentList.Count) && TotalCount > SelectedDocumentAssignments.Count)
                {
                    if (!AllDocumentAssignmentsSelected)
                    {
                        <Button Clicked="SelectAllItems" Class="mx-1 btn-outline-secondary">@L["SelectAllItems", TotalCount]</Button>
                    }
                    else
                    {
                        <Button Clicked="ClearSelection" Class="mx-1 btn-outline-secondary">@L["ClearSelection"]</Button>
                    }
                }
                <Button Color="Color.Danger" Class="mx-1" Size="Size.Medium" Clicked="DeleteSelectedDocumentAssignmentsAsync">
                    <Icon Name="@IconName.Delete" /> @L["Delete"]
                </Button>
            </div>
        </Div>
        <hr Visibility="@(SelectedDocumentAssignments.Any() ? Visibility.Visible : Visibility.Invisible)"
            class="my-1 mx-0" />
        <DataGrid TItem="DocumentAssignmentWithNavigationPropertiesDto"
                  @ref="DataGridRef"
                  Data="DocumentAssignmentList"
                  SelectionMode="DataGridSelectionMode.Multiple"
                  SelectedRows="SelectedDocumentAssignments"
                  RowSelectable="RowSelectableHandler"
                  SelectedRowsChanged="SelectedDocumentAssignmentRowsChanged"
                  ReadData="OnDataGridReadAsync"
                  TotalItems="TotalCount"
                  ShowPager="true"
                  Responsive="true"
                  PageSize="PageSize"
                  Class="datagrid-detail">
            <LoadingTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                       <RadarSpinner />
                    </Column>
                </Row>
            </LoadingTemplate>
            <EmptyTemplate>
                <Row Class="w-100 align-items-center" Style="height: 150px;">
                    <Column>
                        <Heading Size="HeadingSize.Is4" TextAlignment="TextAlignment.Center">@L["NoDataAvailable"]</Heading>
                    </Column>
                </Row>
            </EmptyTemplate>   
            <DataGridColumns>
                @if (CanDeleteDocumentAssignment && DocumentAssignmentList.Any())
                {
                    <DataGridMultiSelectColumn TItem="DocumentAssignmentWithNavigationPropertiesDto" DisplayOrder="-1" Width="30px"></DataGridMultiSelectColumn>
                }
                <DataGridColumn TItem="DocumentAssignmentWithNavigationPropertiesDto"
                        Field="Document.Title"
                        Caption="@L["Document"]"
                        CellStyle="@((item) => "min-width: 300px; max-width: 350px")"
                        Width="300px">
                        <DisplayTemplate> 
                            <div class="row">
                                <div class="col">
                                <h5 class="card-title question-title pb-2">
                                    @context.Document.Title
                                </h5>
                                <div class="d-flex pb-2 mb-2">
                                    <p class="mb-0">
                                        @if(context.DocumentAssignment.StepOrder == (int)DocumentAssignmentStepOrder.ORIGINAL)
                                        {
                                            <small class="badge bg-info me-1"> @L["Original"]</small>
                                        }
                                        else if(context.DocumentAssignment.StepOrder == (int)DocumentAssignmentStepOrder.GENERATED)
                                        {
                                            <small class="badge bg-primary me-1"> @L["Generated"]</small>
                                        }
                                        else if(context.DocumentAssignment.StepOrder == (int)DocumentAssignmentStepOrder.SIGNED)
                                        {
                                            <small class="badge bg-success me-1"> @L["Signed"]</small>
                                        }
                                        |  
                                        @if(context.DocumentAssignment.ActionType == DocumentAssignmentActionType.PROCESS.ToString())
                                        {
                                        <small class="badge bg-info me-1"> @L["Process"]</small>
                                    }
                                    else if(context.DocumentAssignment.ActionType == DocumentAssignmentActionType.SIGN.ToString())
                                    {
                                        <small class="badge bg-primary me-1"> @L["Sign"]</small>
                                    }
                                    else if(context.DocumentAssignment.ActionType == DocumentAssignmentActionType.VIEW.ToString())
                                    {
                                        <small class="badge bg-success me-1"> @L["View"]</small>
                                    }
                                    </p>
                                </div>
                                </div>
                            </div>
                        </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentAssignmentWithNavigationPropertiesDto"
                        Field="DocumentAssignment.Status"
                        CellStyle="@((item) => "min-width: 200px")"
                        Width="200px"
                        Caption="@L["Status"]">
                        <DisplayTemplate>
                                @if(context.DocumentAssignment.Status == DocumentAssignmentStatus.PENDING.ToString())
                                {
                                    <small class="badge bg-warning me-1"> @L["Pending"]</small>
                                }
                                else if(context.DocumentAssignment.Status == DocumentAssignmentStatus.DONE.ToString())
                                {
                                    <small class="badge bg-success me-1"> @L["Done"]</small>
                                }
                                else if(context.DocumentAssignment.Status == DocumentAssignmentStatus.REJECTED.ToString())
                                {
                                    <small class="badge bg-danger me-1"> @L["Rejected"]</small>
                                }
                                else if(context.DocumentAssignment.Status == DocumentAssignmentStatus.REVOKE.ToString())
                                {
                                    <small class="badge bg-danger me-1"> @L["Revoked"]</small>
                                }
                        </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentAssignmentWithNavigationPropertiesDto"
                        Field="DocumentAssignment.AssignedAt"
                        CellStyle="@((item) => "min-width: 200px")"
                        Caption="@L["AssignedAt"]" Width="200px">
                    <DisplayTemplate>
                            @context.DocumentAssignment.AssignedAt.ToString("dd/MM/yyyy HH:mm")
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentAssignmentWithNavigationPropertiesDto"
                        Field="DocumentAssignment.ProcessedAt"
                        CellStyle="@((item) => "min-width: 200px")"
                        Caption="@L["ProcessedAt"]" Width="200px">
                    <DisplayTemplate>
                            @context.DocumentAssignment.ProcessedAt.ToString("dd/MM/yyyy HH:mm")
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentAssignmentWithNavigationPropertiesDto"
                        Field="DocumentAssignment.IsCurrent"
                        CellStyle="@((item) => "min-width: 200px")"
                        Caption="@L["IsCurrent"]" Width="200px">
                        <DisplayTemplate>
                            @if (context.DocumentAssignment.IsCurrent)
                            {
                                <Icon TextColor="TextColor.Success" Name="@IconName.Check" />
                            }
                            else
                            {
                                <Icon TextColor="TextColor.Danger" Name="@IconName.Times" />
                            }
                        </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="DocumentAssignmentWithNavigationPropertiesDto"
                        Field="WorkflowStepTemplate.Name"
                        CellStyle="@((item) => "min-width: 320px")"
                        Caption="@L["WorkflowStepTemplate"]" Width="320px">
                </DataGridColumn>
                <DataGridEntityActionsColumn TItem="DocumentAssignmentWithNavigationPropertiesDto" @ref="@EntityActionsColumn" CellStyle="@((item) => "min-width: 150px")" Width="150px">
                <DisplayTemplate>
                    <div class="d-flex gap-1">
                            <Button
                                Color="Color.Secondary"
                                Outline
                                Size="Size.Small"
                                Title="@L["View"]"
                                Clicked="@(() => NavigationManager.NavigateTo("/view-document-detail/" + context.DocumentAssignment.DocumentId))">
                                <Icon Name="IconName.Eye" />
                        </Button>
                    </div>
                </DisplayTemplate>
                </DataGridEntityActionsColumn>
            </DataGridColumns>
        </DataGrid>
    </CardBody>
</Card>


@* ************************* CREATE MODAL ************************* *@
<Modal @ref="CreateDocumentAssignmentModal" Closing="@CreateDocumentAssignmentModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
@*//<suite-custom-code-block-5>*@
@*//</suite-custom-code-block-5>*@
        <Form id="CreateDocumentAssignmentForm">
            <ModalHeader>
                <ModalTitle>@L["NewDocumentAssignment"]</ModalTitle>
                <CloseButton Clicked="CloseCreateDocumentAssignmentModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@NewDocumentAssignmentValidations"
                            Mode="ValidationMode.Auto"
                            Model="@NewDocumentAssignment"
                            ValidateOnLoad="false">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["StepOrder"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@NewDocumentAssignment.StepOrder"  Min="DocumentAssignmentConsts.StepOrderMinLength" Max="DocumentAssignmentConsts.StepOrderMaxLength" Decimals="0"  Autofocus="true">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ActionType"] *</FieldLabel>
                            <Select TValue="DocumentAssignmentActionType" @bind-SelectedValue="@NewDocumentAssignment.ActionType" >
                                <SelectItem Value="DocumentAssignmentActionType.PROCESS">@L["Process"]</SelectItem>
                                <SelectItem Value="DocumentAssignmentActionType.SIGN">@L["Sign"]</SelectItem>
                                <SelectItem Value="DocumentAssignmentActionType.VIEW">@L["View"]</SelectItem>
                            </Select>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Status"] *</FieldLabel>
                            <Select TValue="DocumentAssignmentStatus" SelectedValue="@NewDocumentAssignment.Status" SelectedValueChanged="@((DocumentAssignmentStatus value) => { NewDocumentAssignment.Status = value; })" >
                                <SelectItem Value="DocumentAssignmentStatus.PENDING">@L["Pending"]</SelectItem>
                                <SelectItem Value="DocumentAssignmentStatus.DONE">@L["Done"]</SelectItem>
                                <SelectItem Value="DocumentAssignmentStatus.REJECTED">@L["Rejected"]</SelectItem>
                            </Select>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["AssignedAt"]</FieldLabel>
                            <DateEdit TValue="DateTime" InputMode="DateInputMode.Date" @bind-Date="@NewDocumentAssignment.AssignedAt"  >
                               <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </DateEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ProcessedAt"]</FieldLabel>
                            <DateEdit TValue="DateTime" InputMode="DateInputMode.Date" @bind-Date="@NewDocumentAssignment.ProcessedAt"  >
                               <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </DateEdit>
                        </Field>
                    </Validation>
                    <Field>
                        <Check TValue="bool" @bind-Checked="@NewDocumentAssignment.IsCurrent"  >@L["IsCurrent"]</Check>
                    </Field>
                    <Field>
                        <FieldLabel>@L["Document"] *</FieldLabel>
                        <Autocomplete Data="@DocumentsCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetDocumentCollectionLookupAsync"
                                      @bind-SelectedValue="@NewDocumentAssignment.DocumentId"
                                      Placeholder="&#8212;" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["WorkflowStepTemplate"] </FieldLabel>
                        <Autocomplete Data="@WorkflowStepTemplatesCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid?"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id )"
                                      SearchChanged="@GetWorkflowStepTemplateCollectionLookupAsync"
                                      @bind-SelectedValue="@NewDocumentAssignment.WorkflowStepTemplateId"
                                      Placeholder="&#8212;" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["IdentityUser"] *</FieldLabel>
                        <Autocomplete Data="@IdentityUsersCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetIdentityUserCollectionLookupAsync"
                                      @bind-SelectedValue="@NewDocumentAssignment.ReceiverUserId"
                                      Placeholder="&#8212;" />
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseCreateDocumentAssignmentModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="CreateDocumentAssignmentForm" Clicked="CreateDocumentAssignmentAsync"/>
@*//<suite-custom-code-block-6>*@
@*//</suite-custom-code-block-6>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-7>*@
@*//</suite-custom-code-block-7>*@
    </ModalContent>
</Modal>
@* ************************* EDIT MODAL ************************* *@
<Modal @ref="EditDocumentAssignmentModal" Closing="@EditDocumentAssignmentModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true">
@*//<suite-custom-code-block-8>*@
@*//</suite-custom-code-block-8>*@
        <Form id="EditDocumentAssignmentForm">
            <ModalHeader>
                <ModalTitle>@L["Update"]</ModalTitle>
                <CloseButton Clicked="CloseEditDocumentAssignmentModalAsync" />
            </ModalHeader>
            <ModalBody>
                <Validations @ref="@EditingDocumentAssignmentValidations"
                            Mode="ValidationMode.Auto"
                            Model="@EditingDocumentAssignment"
                            ValidateOnLoad="false">
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["StepOrder"]</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="@EditingDocumentAssignment.StepOrder"  Min="DocumentAssignmentConsts.StepOrderMinLength" Max="DocumentAssignmentConsts.StepOrderMaxLength" Decimals="0"  Autofocus="true">
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                             </NumericPicker>
                        </Field>
                     </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ActionType"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingDocumentAssignment.ActionType" MaxLength="DocumentAssignmentConsts.ActionTypeMaxLength"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["Status"] *</FieldLabel>
                            <TextEdit @bind-Text="@EditingDocumentAssignment.Status" MaxLength="DocumentAssignmentConsts.StatusMaxLength"  >
                                <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </TextEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["AssignedAt"]</FieldLabel>
                            <DateEdit TValue="DateTime" InputMode="DateInputMode.Date" @bind-Date="@EditingDocumentAssignment.AssignedAt"  >
                               <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </DateEdit>
                        </Field>
                    </Validation>
                    <Validation MessageLocalizer="@LH.Localize">
                        <Field>
                            <FieldLabel>@L["ProcessedAt"]</FieldLabel>
                            <DateEdit TValue="DateTime" InputMode="DateInputMode.Date" @bind-Date="@EditingDocumentAssignment.ProcessedAt"  >
                               <Feedback>
                                    <ValidationError />
                                </Feedback>
                            </DateEdit>
                        </Field>
                    </Validation>
                    <Field>
                        <Check TValue="bool" @bind-Checked="@EditingDocumentAssignment.IsCurrent"  >@L["IsCurrent"]</Check>
                    </Field>
                    <Field>
                        <FieldLabel>@L["Document"] *</FieldLabel>
                        <Autocomplete Data="@DocumentsCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetDocumentCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingDocumentAssignment.DocumentId"
                                      Placeholder="&#8212;" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["WorkflowStepTemplate"] </FieldLabel>
                        <Autocomplete Data="@WorkflowStepTemplatesCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid?"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id )"
                                      SearchChanged="@GetWorkflowStepTemplateCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingDocumentAssignment.WorkflowStepTemplateId"
                                      Placeholder="&#8212;" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["IdentityUser"] *</FieldLabel>
                        <Autocomplete Data="@IdentityUsersCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetIdentityUserCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingDocumentAssignment.ReceiverUserId"
                                      Placeholder="&#8212;" />
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditDocumentAssignmentModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditDocumentAssignmentForm" Clicked="UpdateDocumentAssignmentAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
@*//<suite-custom-code-block-10>*@
@*//</suite-custom-code-block-10>*@
    </ModalContent>
</Modal>
