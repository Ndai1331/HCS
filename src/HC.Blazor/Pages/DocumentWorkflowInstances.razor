                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetDocumentCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingDocumentWorkflowInstance.DocumentId"
                                      Placeholder="&#8212;" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["Workflow"] *</FieldLabel>
                        <Autocomplete Data="@WorkflowsCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetWorkflowCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingDocumentWorkflowInstance.WorkflowId"
                                      Placeholder="&#8212;" />
                    </Field>
                    <Field>
                        <FieldLabel>@L["WorkflowTemplate"]</FieldLabel>
                        <Select TValue="Guid" @bind-SelectedValue="@EditingDocumentWorkflowInstance.WorkflowTemplateId">
                            @foreach (var workflowTemplate in WorkflowTemplatesCollection)
                            {
                                <SelectItem TValue="Guid" Value="@(workflowTemplate.Id)">
                                    @(workflowTemplate.DisplayName)
                                </SelectItem>
                            }
                        </Select>
                    </Field>
                    <Field>
                        <FieldLabel>@L["WorkflowStepTemplate"] *</FieldLabel>
                        <Autocomplete Data="@WorkflowStepTemplatesCollection"
                                      TItem="LookupDto<Guid>"
                                      TValue="Guid"
                                      TextField="@((item) => item?.DisplayName)"
                                      ValueField="@((item) => item?.Id ?? default)"
                                      SearchChanged="@GetWorkflowStepTemplateCollectionLookupAsync"
                                      @bind-SelectedValue="@EditingDocumentWorkflowInstance.CurrentStepId"
                                      Placeholder="&#8212;" />
                    </Field>
                </Validations>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary"
                        Clicked="CloseEditDocumentWorkflowInstanceModalAsync">
                    @L["Cancel"]
                </Button>
                <SubmitButton Form="EditDocumentWorkflowInstanceForm" Clicked="UpdateDocumentWorkflowInstanceAsync" />
@*//<suite-custom-code-block-9>*@
@*//</suite-custom-code-block-9>*@
            </ModalFooter>
        </Form>
