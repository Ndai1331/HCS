@page "/survey-collections/{SurveyLocationId:guid}"
@using HC.SurveySessions
@using HC.SurveyLocations
@using HC.SurveyCriterias
@using HC.SurveyResults
@using HC.SurveyFiles
@using HC.Localization
@using HC.Shared
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout HC.Blazor.Components.Layout.EmptyLayout
@inherits HCComponentBase
@inject ISurveySessionsAppService SurveySessionsAppService
@inject ISurveyLocationsAppService SurveyLocationsAppService
@inject ISurveyCriteriasAppService SurveyCriteriasAppService
@inject ISurveyResultsAppService SurveyResultsAppService
@inject ISurveyFilesAppService SurveyFilesAppService
@inject IUiMessageService UiMessageService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject NavigationManager NavigationManager


<PageHeader Title="@PageTitle" />

@if (IsLoading)
{
    <Row Class="justify-content-center">
        <Column>
            <RadarSpinner />
        </Column>
    </Row>
}
else if (SurveyLocation == null)
{
    <Alert Color="Color.Danger">
        <AlertMessage>@L["SurveyCollections:SurveyLocationNotFound"]</AlertMessage>
    </Alert>

}else if (IsShowThankYouMessage)
{
    <Row>
        <Column ColumnSize="ColumnSize.Is12" Class="d-flex">
            <Card Class="h-100 overflow-hidden">
                <CardBody>
                    <div class="abp-community abp-logo mb-2"></div>
                    <p class="lead text-muted">
                        @L["SurveyCollections:ThankYou"]
                    </p>
                    <p class="text-muted mb-2">
                        @L["SurveyCollections:ThankYouMessage"]
                    </p>
                    <br />
                    <p class="text-muted mb-2">
                        @L["SurveyCollections:YourFeedbackIsImportant"]
                    </p>
                    <a class="btn btn-brand soft mb-3" href="/">@L["BackToHome"]</a>
                </CardBody>
                <img class="mt-3" src="../../../assets/img/getting-started/img-blog.png">
            </Card>
        </Column>
    </Row>
}
else
{
    <Row>
        @foreach (var criteria in SurveyCriterias)
        {
            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                <Card>
                    <CardBody Class="d-flex flex-column justify-content-between">
                        <Div Class="d-flex flex-column flex-md-row justify-content-center align-items-md-end mt-4">
                            <Div Class="d-flex align-items-center mb-2 mb-md-0">
                                <img src="@FileHelper.GetImageUrl(ApiBaseUrl, criteria.SurveyCriteria.Image)"
                                    onerror="el.onerror = null; el.src = 'https://www.freeiconspng.com/uploads/no-image-icon-6.png';"
                                    alt="@criteria.SurveyCriteria.Name" 
                                    class="rounded-circle me-2">
                                <Div>
                                    <h4 class="mb-0 text-dark">@criteria.SurveyCriteria.Name</h4>
                                    @* <p class="text-dark mb-0">
                                    CTO, Standart Chartered Bank <span class="text-muted d-block">Singapore</span>
                                    </p> *@
                                </Div>
                            </Div>
                        </Div>
                        <Div Class="mb-1 text-center">
                            @for (int star = 1; star <= 5; star++)
                            {
                                var currentStar = star;
                                <i class="@(GetRatingForCriteria(criteria.SurveyCriteria.Id) >= currentStar ? "bi bi-star-fill text-warning fs-3" : "bi bi-star text-muted fs-3")"
                                    @onclick="@(() => SetRatingForCriteria(criteria.SurveyCriteria.Id, currentStar))"></i>

                                   //set 5 sao mặc định
                                    @if(currentStar ==5)
                                    {
                                        NewSurveyResults.Add(new SurveyResultCreateDto
                                        {
                                            Rating = currentStar,
                                            SurveyCriteriaId = criteria.SurveyCriteria.Id,
                                            SurveySessionId = Guid.Empty
                                        });
                                    }
                            }
                        </Div>
                    </CardBody>
                </Card>
            </Column>
        }
    </Row>

    <Row Class="mt-4">
        <Column ColumnSize="ColumnSize.Is12" Class="text-center">
            <Button Color="Color.Primary"
                    Size="Size.Large"
                    Clicked="@(async () => await ShowModalCreateSurveySessionAsync())">
                <Icon Name="IconName.Save" Class="me-2" />
                @L["SurveyCollections:SubmitSurvey"]
            </Button>
        </Column>
    </Row>
}



<Modal @ref="CreateSurveySessionModal"  Closing="@CreateSurveySessionModal.CancelClosingModalWhenFocusLost">
    <ModalContent Centered="true" Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>@L["SurveyCollections:SubmitSurvey"]</ModalTitle>
            <CloseButton Clicked="@CloseCreateSurveySessionModalAsync" />
        </ModalHeader>
        <ModalBody>
            <Card Class="mb-4">
                <CardBody>
                    <Form id="SurveySessionForm">
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["FullName"] *</FieldLabel>
                                    <TextEdit @bind-Text="NewSurveySession.FullName"
                                            Autofocus="true" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["PhoneNumber"] *</FieldLabel>
                                    <TextEdit @bind-Text="NewSurveySession.PhoneNumber" />
                                </Field>
                            </Column>
                        </Row>
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["PatientCode"]</FieldLabel>
                                    <TextEdit @bind-Text="NewSurveySession.PatientCode" />
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                <Field>
                                    <FieldLabel>@L["DeviceType"]</FieldLabel>
                                    <Select TValue="DeviceType?"
                                            SelectedValue="@NewSurveySession.DeviceType"
                                            SelectedValueChanged="@((DeviceType? value) => { NewSurveySession.DeviceType = value; })">
                                        <SelectItem TValue="DeviceType?"></SelectItem>
                                        @foreach (var deviceType in Enum.GetValues<DeviceType>())
                                        {
                                            <SelectItem TValue="DeviceType?" Value="@deviceType">
                                                @L[$"Enum:DeviceType.{deviceType}"]
                                            </SelectItem>
                                        }
                                    </Select>
                                </Field>
                            </Column>
                        </Row>
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12">
                                <Field>
                                    <FieldLabel>@L["Note"]</FieldLabel>
                                    <MemoEdit @bind-Text="@NewSurveySession.Note" Rows="3" />
                                </Field>
                            </Column>
                        </Row>

                        <!-- review lại khảo sát -->


                        <!-- kết thúc review lại khảo sát -->
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12" Class="text-center">
                                <Button Color="Color.Primary"
                                        Size="Size.Large"
                                        Clicked="CreateSurveySessionAsync">
                                    <Icon Name="IconName.Play" Class="me-2" />
                                    @L["SurveyCollections:StartSurvey"]
                                </Button>
                            </Column>
                        </Row>
                    </Form>
                </CardBody>
            </Card>
        </ModalBody>
    </ModalContent>
</Modal>