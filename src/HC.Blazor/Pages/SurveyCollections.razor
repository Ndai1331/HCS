@page "/survey-collections/{SurveyLocationId:guid}"
@using HC.SurveySessions
@using HC.SurveyLocations
@using HC.SurveyCriterias
@using HC.SurveyResults
@using HC.SurveyFiles
@using HC.Localization
@using HC.Shared
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Components.Web
@using Blazorise
@using Blazorise.Components
@using Blazorise.DataGrid
@using Volo.Abp.AspNetCore.Components.BlockUi
@using Volo.Abp.BlazoriseUI
@using Volo.Abp.BlazoriseUI.Components
@using Volo.Abp.ObjectMapping
@using Volo.Abp.AspNetCore.Components.Messages
@using Volo.Abp.AspNetCore.Components.Web.Theming.Layout
@using Volo.Abp.AspNetCore.Components.Web
@using Volo.Abp.AspNetCore.Components
@using Microsoft.AspNetCore.Components
@using Volo.Abp.Http.Client
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@layout HC.Blazor.Components.Layout.EmptyLayout
@inherits HCComponentBase
@inject ISurveySessionsAppService SurveySessionsAppService
@inject ISurveyLocationsAppService SurveyLocationsAppService
@inject ISurveyCriteriasAppService SurveyCriteriasAppService
@inject ISurveyResultsAppService SurveyResultsAppService
@inject ISurveyFilesAppService SurveyFilesAppService
@inject IUiMessageService UiMessageService
@inject IBlockUiService BlockUiService
@inject AbpBlazorMessageLocalizerHelper<HCResource> LH
@inject NavigationManager NavigationManager


<PageHeader Title="@PageTitle" />

<Div id="lpx-wrapper" Class="full">
    <Div Class="lpx-content-container">
        <Div Class="lpx-content-wrapper">
            <Div Class="lpx-content">
                    @if (IsLoading)
                    {
                        <Row Class="justify-content-center">
                            <Column>
                                <RadarSpinner />
                            </Column>
                        </Row>
                    }
                    else if (SurveyLocation == null)
                    {
                        <Alert Color="Color.Danger">
                            <AlertMessage>@L["SurveyCollections:SurveyLocationNotFound"]</AlertMessage>
                        </Alert>

                    }else if (IsShowThankYouMessage)
                    {
                        <Row>
                            <Column ColumnSize="ColumnSize.Is12" Class="d-flex">
                                <Card Class="h-100 overflow-hidden w-100 text-center">
                                    <CardBody>
                                        <div class="abp-community abp-logo mb-2"></div>
                                        <h1 class="d-block fw-normal text-dark">
                                            @L["SurveyCollections:ThankYou"]
                                        </h1>
                                        <p class="lead fw-normal my-3">
                                            @L["SurveyCollections:ThankYouMessage"]
                                        </p>
                                        <p class="lead fw-normal my-3">
                                            @L["SurveyCollections:YourFeedbackIsImportant"]
                                        </p>
                                        <Button class="btn-brand soft mb-3" Clicked="@OnReloadPage">@L["Back"]</Button>
                                        <br/>
                                        <img class="mt-3" src="https://x.leptontheme.com/assets/img/getting-started/img-blog.png">
                                    </CardBody>
                                </Card>
                            </Column>
                        </Row>
                    }
                    else
                    {
                        <Row>
                            <Div Class="w-100 text-center">
                                <h1 class="lpx-login-title mb-2">@SurveyLocation?.Name</h1>
                                <p>@SurveyLocation?.Description</p>
                            </Div>
                            @if (SurveyCriterias == null || !SurveyCriterias.Any())
                            {
                                <Column ColumnSize="ColumnSize.Is12" Class="text-center mt-4">
                                    <Alert Color="Color.Warning">
                                        <AlertMessage>@L["SurveyCollections:NoCriteriaPleaseComeBackLater"]</AlertMessage>
                                    </Alert>
                                </Column>
                            }
                            else
                            {
                                @foreach (var criteria in SurveyCriterias.OrderBy(x => x.SurveyCriteria.DisplayOrder))
                                {
                                    <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop" Class="d-flex">
                                        <Card Class="w-100">

                                            
                                            <CardBody Class="d-flex flex-column justify-content-between">
                                                <Div Class="d-flex flex-column flex-md-row justify-content-center align-items-md-end">
                                                    <Div Class="d-flex justify-content-center align-items-center mb-2 mb-md-0">
                                                        <img 
                                                            src="@(string.IsNullOrEmpty(criteria.SurveyCriteria.Image) ? "/images/no-image-available.jpg" : FileHelper.GetImageUrl(ApiBaseUrl, criteria.SurveyCriteria.Image))"
                                                            onerror="this.onerror = null; this.src = '/images/no-image-available.jpg';"
                                                            alt="@criteria.SurveyCriteria.Name" 
                                                            class="me-2"
                                                            style="width: 150px; height: 150px; object-fit: contain;">
                                                        
                                                    </Div>
                                                </Div>
                                                <Div>
                                                    <h4 class="mb-1 mt-1 text-dark text-center">@criteria.SurveyCriteria.Name</h4>
                                                </Div>
                                                <Div Class="mb-1 text-center">
                                                    @for (int star = 1; star <= 5; star++)
                                                    {
                                                        var currentStar = star;
                                                        <i class="hover-pointer
                                                            @(GetRatingForCriteria(criteria.SurveyCriteria.Id) >= currentStar ? "bi bi-star-fill text-brand fs-40" : "bi bi-star text-muted fs-40")"
                                                            @onclick="@(async () => await SetRatingForCriteria(criteria.SurveyCriteria.Id, currentStar))"   
                                                            ></i>
                                                    }
                                                </Div>
                                            </CardBody>
                                        </Card>
                                    </Column>
                                }
                            }
                        </Row>

                        @if (SurveyCriterias != null && SurveyCriterias.Any())
                        {
                            <Row Class="mt-4">
                                <Column ColumnSize="ColumnSize.Is12" Class="text-center">
                                    <Button Color="Color.Primary"
                                            Size="Size.Large"
                                            Clicked="@(async () => await ShowModalCreateSurveySessionAsync())">
                                        <Icon Name="IconName.Save" Class="me-2" />
                                        @L["SurveyCollections:SubmitSurvey"]
                                    </Button>
                                </Column>
                            </Row>
                        }
                    }



                    <Modal @ref="CreateSurveySessionModal"  Closing="@CreateSurveySessionModal.CancelClosingModalWhenFocusLost">
                        <ModalContent Centered="true" Size="ModalSize.Large">
                            <ModalHeader>
                                <ModalTitle>@L["SurveyCollections:SubmitSurvey"]</ModalTitle>
                                <CloseButton Clicked="@CloseCreateSurveySessionModalAsync" />
                            </ModalHeader>
                            <ModalBody>
                                <Card Class="mb-4">
                                    <CardBody>
                                        <Form id="SurveySessionForm">
                                            <Row>
                                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                                    <Field>
                                                        <FieldLabel>@L["FullName"] *</FieldLabel>
                                                        <TextEdit @bind-Text="NewSurveySession.FullName"
                                                                Autofocus="true" />
                                                    </Field>
                                                </Column>
                                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                                    <Field>
                                                        <FieldLabel>@L["PhoneNumber"] *</FieldLabel>
                                                        <TextEdit @bind-Text="NewSurveySession.PhoneNumber" />
                                                    </Field>
                                                </Column>
                                            </Row>
                                            <Row>
                                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                                    <Field>
                                                        <FieldLabel>@L["PatientCode"]</FieldLabel>
                                                        <TextEdit @bind-Text="NewSurveySession.PatientCode" />
                                                    </Field>
                                                </Column>
                                                <Column ColumnSize="ColumnSize.Is12.OnMobile.Is6.OnDesktop">
                                                    <Field>
                                                        <FieldLabel>@L["DeviceType"]</FieldLabel>
                                                        <Select TValue="DeviceType?"
                                                                Disabled="true"
                                                                SelectedValue="@NewSurveySession.DeviceType"
                                                                SelectedValueChanged="@((DeviceType? value) => { NewSurveySession.DeviceType = value; })">
                                                            <SelectItem TValue="DeviceType?"></SelectItem>
                                                            @foreach (var deviceType in Enum.GetValues<DeviceType>())
                                                            {
                                                                <SelectItem TValue="DeviceType?" Value="@deviceType">
                                                                    @L[$"Enum:DeviceType.{deviceType}"]
                                                                </SelectItem>
                                                            }
                                                        </Select>
                                                    </Field>
                                                </Column>
                                            </Row>
                                            <Row>
                                                <Column ColumnSize="ColumnSize.Is12">
                                                    <Field>
                                                        <FieldLabel>@L["Note"]</FieldLabel>
                                                        <MemoEdit @bind-Text="@NewSurveySession.Note" Rows="3" />
                                                    </Field>
                                                </Column>
                                            </Row>

                                            <Row>
                                                <Column ColumnSize="ColumnSize.Is12">
                                                    <Field>
                                                        <FieldLabel>@L["SurveyCollections:UploadPhoto"]</FieldLabel>
                                                        <FilePicker Multiple="false"
                                                                @ref="FilePicker"
                                                                Changed="@(async (files) => await OnFileChangedAsync(files))"
                                                                ShowMode="FilePickerShowMode.List"
                                                                MaxFileSize="52428800"
                                                                Accept="image/*"
                                                                FilePickerLocalizer="FilePickerHelper.FilePickerLocalizer">
                                                            <ButtonsTemplate>
                                                                <Buttons>
                                                                    <Button Clicked="@(() => ClearFiles())"
                                                                            Color="Color.Warning"
                                                                            Size="Size.Small">
                                                                        <Icon Name="IconName.Clear" /> @L["Clear"]
                                                                    </Button>
                                                                </Buttons>
                                                            </ButtonsTemplate>
                                                        </FilePicker>
                                                        @if (!string.IsNullOrEmpty(GetUploadedFileName()))
                                                        {
                                                            <Alert Color="Color.Success" Dismissible="false" Class="mt-2">
                                                                <Icon Name="IconName.CheckCircle" Class="me-2" />
                                                                @L["FileUploadedSuccessfully"]: @GetUploadedFileName()
                                                            </Alert>
                                                        }
                                                    </Field>
                                                </Column>
                                            </Row>

                                            <!-- review lại khảo sát -->


                                            <!-- kết thúc review lại khảo sát -->
                                            <Row>
                                                <Column ColumnSize="ColumnSize.Is12" Class="text-center">
                                                    <Button Color="Color.Primary"
                                                            Size="Size.Large"
                                                            Clicked="CreateSurveySessionAsync">
                                                        <Icon Name="IconName.Play" Class="me-2" />
                                                        @L["SurveyCollections:SubmitSurvey"]
                                                    </Button>
                                                </Column>
                                            </Row>
                                        </Form>
                                    </CardBody>
                                </Card>
                            </ModalBody>
                        </ModalContent>
                    </Modal>

                </Div>  
            </Div>
        </Div>
</Div>


<style>
    .fs-40 {
        font-size: 40px;
    }
</style>