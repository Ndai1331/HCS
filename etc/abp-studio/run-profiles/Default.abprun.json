{
  "applications": {
    "HC.BackgroundJobWorker": {
      "type": "dotnet-project",
      "launchUrl": "https://localhost:44303",
      "path": "../../../src/HC.BackgroundJobWorker/HC.BackgroundJobWorker.csproj",
      "execution": {
        "order": 1
      },
      "debug": {
        "enabled": true,
        "launchBrowser": false,
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    },
    "HC.PushNotificationWorker": {
      "type": "dotnet-project",
      "launchUrl": "",
      "path": "../../../src/HC.PushNotificationWorker/HC.PushNotificationWorker.csproj",
      "execution": {
        "order": 2
      },
      "debug": {
        "enabled": true,
        "launchBrowser": false,
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    },
    "HC.AuthServer": {
      "type": "dotnet-project",
      "launchUrl": "https://localhost:44301",
      "path": "../../../src/HC.AuthServer/HC.AuthServer.csproj",
      "kubernetesService": ".*-authserver$",
      "healthCheckEndpoint": "/health-status",
      "healthUiEndpoint": "/health-ui",
      "execution": {
        "order": 3
      }
    },
    "HC.HttpApi.Host": {
      "type": "dotnet-project",
      "launchUrl": "https://localhost:44379",
      "path": "../../../src/HC.HttpApi.Host/HC.HttpApi.Host.csproj",
      "kubernetesService": ".*-httpapihost$",
      "healthCheckEndpoint": "/health-status",
      "healthUiEndpoint": "/health-ui",
      "execution": {
        "order": 4
      }
    },
    "HC.Blazor": {
      "type": "dotnet-project",
      "launchUrl": "https://localhost:44302",
      "path": "../../../src/HC.Blazor/HC.Blazor.csproj",
      "kubernetesService": ".*-blazorserver$",
      "healthCheckEndpoint": "/health-status",
      "healthUiEndpoint": "/health-ui",
      "execution": {
        "order": 5
      }
    }
  },
  "containers": {
    "serviceName": "HC-Containers",
    "files": {
      "../../docker/containers/redis.yml": {},
      "../../docker/containers/rabbitmq.yml": {},
      "../../docker/containers/minio.yml": {}
    }
  },
  "tasks": {
    "Initialize Solution": {
      "behaviour": 2,
      "startCommand": "./initialize-solution.ps1",
      "workingDirectory": "../../scripts",
      "shortDescription": "Installs required UI libraries, creates required certificates and seeds the database."
    },
    "Migrate Database": {
      "behaviour": 0,
      "startCommand": "./migrate-database.ps1",
      "workingDirectory": "../../scripts",
      "shortDescription": "Migrates the database to the latest version."
    }
  },
  "tools": {
    "RabbitUI": {
      "url": "localhost:15672",
      "relatedContainer": "rabbitmq"
    }
  }
}